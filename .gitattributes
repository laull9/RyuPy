tests/perf/results/m3_10/union-prototype/jit-arithmetic.txt -whitespace
tests/perf/results/m3_10/union-prototype/jit-calls.txt -whitespace

# AOT跨平台比较使用同一源码字节；不让Windows checkout自动改写fixture换行。
tests/aot/fixtures/*.py text eol=lf
# 显式资源验收的源码/数据/清单也固定LF；hash不随Windows checkout转换。
tests/aot/resource_fixtures/**/*.py text eol=lf
tests/aot/resource_fixtures/**/*.txt text eol=lf
tests/aot/resource_fixtures/**/*.json text eol=lf
# 自有C ABI样例在三平台构建使用同一UTF-8源码字节。
tests/aot/cabi_probe/*.c text eol=lf
tests/aot/cabi_probe/*.py text eol=lf
crates/ryupy-codegen-cil/examples/cabi_emit_probe.rs text eol=lf

# 固定绑定源跨平台保持同一字节，输出换行由真实标准流决定。
tests/aot/binding_fixtures/*.py text eol=lf
