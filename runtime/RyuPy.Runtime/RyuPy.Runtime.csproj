<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 与 crates/ryupy-codegen-cil/src/runtimeconfig.rs 的 TARGET_FRAMEWORK_MAJOR 保持一致 -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- 与 codegen-cil/assembly_refs.rs 的运行时引用身份同步；独立于 SDK/TFM 版本 -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 运行时必须始终兼容 Native AOT：开启裁剪 / AOT 分析器，禁止反射发射等 -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>RyuPy.Runtime</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 专用测试构建必须显式开启；生产没有此类型、字段和调用。 -->
    <DefineConstants Condition="'$(TraceAdapterTest)' == 'true'">$(DefineConstants);TRACE_ADAPTER_TEST</DefineConstants>
  </PropertyGroup>

  <Import Project="RuntimeDependencies.props" />
  <ItemGroup>
    <None Update="RuntimeDependencies.props" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
