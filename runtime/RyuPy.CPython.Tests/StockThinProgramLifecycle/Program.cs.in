// 真实产品Bootstrap/Runtime/Host/native生命周期门；业务体固定为public中性ABI静态C#。
// 业务F留在原__main__，控制胶水只注册退出协议和做身份断言；没有源码del或产品代码注入。
using RyuPy.CPython;
using RyuPy.Runtime;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
namespace RyuPy.CPython.Tests;
internal static class ProgramLifecycle
{
    private static int exits, dels, errors, unraisables;
    private static CPythonHost host = null!;
    private static PyModule module = null!;
    private static PythonObject d = null!;
    private static object entryContext = null!;
    private static string mode = "";
    private static readonly object constantString = "恒定CIL字符串:重复导出:0123456789";
    private static readonly object constantInteger = 123456789012345L;
    private static readonly ExternalCapture capture = new();
    private static WeakReference? releasedDuringPause;
    private static WeakReference? borrowedReceiver;
    private static Exception? receiverError;

    [UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
    private static int ReenterBorrowedReceiver()
    {
        try
        {
            GC.Collect(); GC.WaitForPendingFinalizers(); host.DrainReferences();
            Require(borrowedReceiver is { IsAlive: true }, "活动borrowed receiver保活到同步清理结束");
            return 0;
        }
        catch (Exception error) { receiverError = error; return -1; }
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    private static unsafe object? TouchTemporaryReceiver()
    {
        using var lease = host.Enter();
        var receiver = new PythonObject(host, host.Check(ProgramObserver.program_receiver_create(&ReenterBorrowedReceiver)));
        borrowedReceiver = new(receiver);
        return receiver.GetAttr("touch");
    }
    private sealed class ExternalCapture : PyNativeObject
    {
        internal PythonObject? Saved;
        public override string TypeName => "external_capture";
        public override object? GetAttr(string name)
        {
            // 登记权暂停时，旧内部token的finalizer仍必须精确退账，不能依赖临时authority指针。
            GC.Collect(); GC.WaitForPendingFinalizers();
            Require(releasedDuringPause is { IsAlive: false }, "Pause期间旧内部owner自然回收");
            Saved = (PythonObject)host.SystemAttribute("version")!;
            return PyNone.Instance;
        }
    }
    private static void Require(bool ok, string text) { if (!ok) throw new InvalidOperationException(text); }
    private static void Run(string text)
    {
        using var lease = host.Enter();
        if (Native.rp_run_entry("<0228-protocol-control>", text) < 0) host.ThrowError();
    }
    private static void Refused(Action action)
    {
        try { action(); } catch (InvalidOperationException e)
        { Require(host.Statistics.State == "running", "拒绝后仍running"); Console.WriteLine("REFUSED " + e.Message); return; }
        throw new InvalidOperationException("关闭本应拒绝");
    }
    private static object? Echo(IPyStockThinEnvironment env, object? value) => value;
    private static object? Self(IPyStockThinEnvironment env, object? value) => env.LoadGlobal("f");
    private static object? Global(IPyStockThinEnvironment env, object? value) => env.LoadGlobal("marker");
    private static object? ConstantString(IPyStockThinEnvironment env, object? value) => constantString;
    private static object? ConstantInteger(IPyStockThinEnvironment env, object? value) => constantInteger;
    private static object? AtExit(IPyStockThinEnvironment env, object? value)
    {
        exits++; Console.WriteLine("EVENT atexit-cil");
        bool rejected = Task.Run(() => {
            try { using var lease = host.Enter(callback: true); return false; }
            catch (ObjectDisposedException) { return true; }
        }).GetAwaiter().GetResult();
        Require(rejected, "终态拒绝外线程新callback租约");
        Require(ReferenceEquals(env.LoadGlobal("marker"), value), "atexit原D身份");
        Require(env.LoadGlobal("len") is not null, "atexit原builtins");
        var f = (StockThinFunctionHandle)env.LoadGlobal("f")!;
        Require(ReferenceEquals(f.Invoke(value), value), "atexit临时H身份");
        try { host.FinishStockProgram(() => 0); throw new Exception("活动关闭未拒绝"); }
        catch (InvalidOperationException) { }
        return value;
    }
    private static object? Del(IPyStockThinEnvironment env, object? value)
    { dels++; Console.WriteLine("EVENT del-cil"); Require(ReferenceEquals(value, env.LoadGlobal("marker")), "析构原D"); return value; }
    private static object? Fail(IPyStockThinEnvironment env, object? value)
    { errors++; throw (PyBaseException)value!; }
    private static object? Unraisable(IPyStockThinEnvironment env, object? value)
    {
        unraisables++; Console.WriteLine("EVENT unraisable-cil");
        Require(ReferenceEquals(value, env.LoadGlobal("del_error")), "unraisable原异常"); return value;
    }
    private static void Define(string name, PyStockThinBody body)
    {
        // 故意不手工Dispose临时H：真实入口owned作用域必须在RunStockThinMain的finally交还。
        object f = PyModuleInstances.CreateStockThinFunction(entryContext,
            new("0228:"+name, "__main__", name, "fixed-cil-body.cs", 1), body);
        module.SetAttr(name, f);
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    private static WeakReference CreateTransientInternalOwner() =>
        new(host.SystemAttribute("implementation")!);
    private static void Entry(object context)
    {
        entryContext = context;
        Require(PyModules.TryCached("__main__", out var current), "执行前RuntimeCache已发布");
        module = current!; d = (PythonObject)module.GetAttr("__dict__")!;
        using (host.Enter())
            if (ProgramObserver.program_check_missing_builtins() < 0) host.ThrowError();
        if (mode == "zero") return;
        if (mode == "entry-fail") throw new PyValueError("entry-before-F");
        if (mode == "borrowed-receiver")
        {
            Require((long)((PythonObject)TouchTemporaryReceiver()!).ReadScalar("exact_int") == 4123, "原生receiver回调后读取原payload");
            Require(receiverError is null && ProgramObserver.program_receiver_destroyed() == 0,
                "活动协议结束前receiver没有提前析构");
        }
        Run("import gc, atexit, sys\ngc.disable()\nmarker=object()\n");
        Define("f", Echo); Define("global_f", Global); Define("global_self", Self);
        Define("onexit", AtExit); Define("ondel", Del); Define("fail", Fail); Define("onunraisable", Unraisable);
        Define("constant_str", ConstantString); Define("constant_int", ConstantInteger);
        Run("assert f(marker) is marker\nassert global_f(None) is marker\nassert global_self(None) is f\n");
        // 活全局缺失经CP→CIL→CP返回，保留真实NameError的name/args/str；恢复后继续用同一F。
        Run("saved_marker=marker\ndel marker\ntry:\n global_f(None)\nexcept NameError as error:\n assert type(error) is NameError and not isinstance(error, UnboundLocalError)\n assert error.name=='marker'\n assert error.args==(\"name 'marker' is not defined\",)\n assert str(error)==error.args[0]\nelse:\n raise AssertionError('缺失全局必须抛错')\nmarker=saved_marker\ndel saved_marker\nassert global_f(None) is marker\n");
        // 同一CLR常量反复导出；每次丢弃CP结果后再次调用，覆盖retired reverse旧地址复用。
        Run("for _ in range(1000):\n assert constant_str(None)=='恒定CIL字符串:重复导出:0123456789'\n assert constant_int(None)==123456789012345\n");
        if (mode == "external-callback")
        {
            releasedDuringPause = CreateTransientInternalOwner();
            module.SetAttr("external_probe", capture);
            Run("external_probe.capture\nexternal_probe=None\n");
            Require(capture.Saved is { IsDisposed: false }, "第三方回调保存新opaque");
        }
    }
    public static int Main(string[] args)
    {
        Require(RuntimeFeature.IsDynamicCodeSupported == (args[2] == "jit"), "实际JIT/NativeAOT模式与命令一致");
        mode = args[1];
        if (mode == "no-host")
        {
            Require(Bootstrap.FinishStockThin(17) == 17, "未启动/回滚后finish保留错误码");
            Console.WriteLine("PASS no-host finish=17"); return 0;
        }
        Bootstrap.StartStockThin(args[0], ["0228-product-program"]); host = Bootstrap.Host;
        using (host.Enter()) Require(ProgramObserver.program_install_observer() == 0, "低层观察安装");
        if (mode == "pre-entry-fail")
        {
            Require(Bootstrap.FinishStockThin(17) == 17 && host.Statistics.State == "closed",
                "入口前无授权/零候选按普通Finish保留错误码");
            Require(!host.HasStockProgramPermission && host.ProgramResult is null, "没有伪造程序权限");
            Console.WriteLine("PASS pre-entry-fail finish=17"); return 0;
        }
        PyModules.RegisterStockEntrySourceLocated("__main__", "", "fixed-cil-body.cs", 1,
            Path.GetFullPath("fixed-cil-body.cs"), false, Entry);
        try { Bootstrap.RunStockThinMain(); Require(mode != "entry-fail", "入口应抛错"); }
        catch (PyValueError) when (mode == "entry-fail") { Console.WriteLine("EXPECTED entry-before-F"); }
        bool empty = mode is "zero" or "entry-fail";
        Require(CPythonHost.StockThinOwnedHandles == 0, "内部H已由入口作用域确定交还");
        if (mode == "borrowed-receiver")
            Require(ProgramObserver.program_receiver_destroyed() == 1, "入口收敛后receiver真实析构一次");
        Refused(host.Dispose); // 零F也有module/D owned，不能绕回普通Dispose清账。
        if (!empty)
        {
            Require(ReferenceEquals(module, host.Import("__main__")), "Host与Runtime同一module");
        }
        if (mode == "external-callback")
        {
            Require(host.Statistics.ManagedRoots == 0, "第三方CP代理已真实析构，余下仅外逃owned");
            Refused(() => host.FinishStockProgram(() => 0));
            Require(((string)capture.Saved!.ReadScalar("exact_str")).Length > 0, "拒绝后opaque仍可用");
            capture.Saved.Dispose(); host.DrainReferences();
        }
        if (mode == "external")
        {
            var h = (StockThinFunctionHandle)module.GetAttr("f")!;
            Refused(() => host.FinishStockProgram(() => 0));
            object input = 42L;
            Require(ReferenceEquals(h.Invoke(input), input), "拒绝后H仍可调用");
            host.ReleaseObject(input); h.Dispose(); host.DrainReferences();
        }
        if (mode == "external-d")
        {
            PythonObject extra;
            using (host.Enter()) extra = new PythonObject(host, Native.rp_incref(d.Pointer));
            Refused(() => host.FinishStockProgram(() => 0)); extra.Dispose(); host.DrainReferences();
        }
        if (mode is "external-p" or "external-self" or "external-cell")
        {
            string expr = mode switch { "external-p" => "f.__closure__[0].cell_contents",
                "external-self" => "f.__closure__[0].cell_contents.__self__", _ => "f.__closure__[0]" };
            Run("escaped=" + expr);
            var opaque = (PythonObject)module.GetAttr("escaped")!; host.ReleaseObject("escaped");
            Refused(() => host.FinishStockProgram(() => 0)); Require(!opaque.IsDisposed, "外逃opaque仍有效");
            opaque.Dispose(); host.DrainReferences();
        }
        if (mode == "external-container")
        {
            var h = (StockThinFunctionHandle)module.GetAttr("f")!;
            var container = new PyList([h]);
            using (host.Enter()) Native.rp_decref(host.TransferContainer(container));
            h.Dispose(); host.DrainReferences();
            Require(CPythonHost.StockThinOwnedHandles == 0, "H为零但CP容器仍ownedF");
            Refused(() => host.FinishStockProgram(() => 0));
            host.Unregister(container); host.DrainReferences(); GC.KeepAlive(container);
        }
        using (host.Enter())
        {
            try { host.FinishStockProgram(() => 0); throw new Exception("租约内应拒绝"); }
            catch (InvalidOperationException) { Console.WriteLine("REFUSED active-lease"); }
        }
        using (var entered = new ManualResetEventSlim()) using (var leave = new ManualResetEventSlim())
        {
            var worker = new Thread(() => { using var lease = host.Enter(); entered.Set(); leave.Wait(); });
            worker.Start(); entered.Wait(); Refused(() => host.FinishStockProgram(() => 0)); leave.Set(); worker.Join();
        }
        if (!empty) Run("""
del_error=ValueError('unraisable-original')
def unraisable_hook(info, cb=onunraisable, err=del_error):
 assert info.exc_value is err and cb(info.exc_value) is err
sys.unraisablehook=unraisable_hook
class Finalizer:
 def __init__(self, cb=ondel, bad=fail, m=marker, err=del_error): self.cb,self.bad,self.m,self.err=cb,bad,m,err
 def __del__(self):
  assert self.cb(self.m) is self.m
  e=ValueError('del-original')
  try: self.bad(e)
  except ValueError as got: assert got is e
  else: raise AssertionError('原异常丢失')
  self.bad(self.err)
victim=Finalizer()
victim.cycle=victim
victim=None
def check_exit(cb=onexit, bad=fail, m=marker):
 assert sys.modules['__main__'].__dict__ is globals()
 assert f(m) is m and global_f(None) is m and global_self(None) is f
 for _ in range(1000):
  assert constant_str(None)=='恒定CIL字符串:重复导出:0123456789'
  assert constant_int(None)==123456789012345
 assert cb(m) is m
 e=ValueError('exit-original')
 try: bad(e)
 except ValueError as got: assert got is e
 else: raise AssertionError('原异常丢失')
atexit.register(check_exit)
""");
        int requested = mode == "entry-fail" ? 7 : 0;
        int exit = Bootstrap.FinishStockThin(requested);
        GC.Collect(); GC.WaitForPendingFinalizers();
        var result = host.ProgramResult!; var stats = host.Statistics;
        Native.rp_reference_stats(out long post);
        Console.WriteLine($"AFTER mode={mode} exit={exit} finalize={result.FinalizeResult} native={result.NativeLive} destroyed={result.Destroyed} roots={result.CoreRoots} H={result.OwnedHandles} ledger={stats.Handles} queue={stats.PendingReleases} late={stats.LateReleases} postFinalizeDecref={post} lowlevelNative={ProgramObserver.program_lowlevel_live()} atexit={exits} del={dels} errors={errors} unraisable={unraisables}");
        bool ok = exit == requested && result.FinalizeResult == 0 && result.NativeLive == 0 && result.CoreRoots == 0
            && result.OwnedHandles == 0 && stats.Handles == 0 && stats.PendingReleases == 0 && stats.LateReleases == 0
            && post == 0 && ProgramObserver.program_lowlevel_live() == 0
            && (empty ? exits+dels+errors+unraisables == 0 : exits == 1 && dels == 1 && errors == 3 && unraisables == 1);
        GC.KeepAlive(module); GC.KeepAlive(d); GC.KeepAlive(entryContext);
        return ok ? 0 : 2;
    }
}
