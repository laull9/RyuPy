// 真实产品Bootstrap/Runtime/Host/native生命周期门；业务体固定为public中性ABI静态C#。
// 业务F留在原__main__，控制胶水只注册退出协议和做身份断言；没有源码del或产品代码注入。
using RyuPy.CPython;
using RyuPy.Runtime;
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
namespace RyuPy.CPython.Tests;
internal static class ProgramLifecycle
{
    private static int exits, dels, errors, unraisables;
    private static CPythonHost host = null!;
    private static PyModule module = null!;
    private static PythonObject d = null!;
    private static object entryContext = null!;
    private static string mode = "";
    private static readonly object constantString = "恒定CIL字符串:重复导出:0123456789";
    private static readonly object constantInteger = 123456789012345L;
    private static readonly ExternalCapture capture = new();
    private static WeakReference? releasedDuringPause;
    private static WeakReference? borrowedReceiver;
    private static Exception? receiverError;
    private static PyList? escapedValues;
    private sealed class TerminalProxyStorage
    {
        internal PythonObject? Saved;
        internal int Calls;
        internal object? Call(object?[] args)
        {
            Calls++;
            var value = (PythonObject)args[0]!;
            if (Saved is null) Saved = value;
            else Require(ReferenceEquals(Saved, value) && !Saved.IsDisposed, "终态proxy重复回调保留同一opaque别名");
            NewTerminalTemporary();
            GC.Collect(); GC.WaitForPendingFinalizers(); host.DrainReferences();
            if (Calls == 2) throw new PyValueError("terminal-proxy-original");
            return mode == "terminal-cycle" ? PyNone.Instance : value;
        }
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    private static void NewTerminalTemporary()
    {
        using var lease = host.Enter();
        nint constructor = host.Check(Native.rp_builtin("object")), arguments = host.MakeTuple([]);
        try { GC.KeepAlive(host.FromOwned(Native.rp_op(5, constructor, arguments))); }
        finally { Native.rp_decref(constructor); Native.rp_decref(arguments); }
    }
    private sealed class SharedProxyStorage
    {
        internal PythonObject? Saved;
        internal object? Save(object?[] args) { Saved = (PythonObject)args[0]!; return Saved; }
        internal object? Read(object?[] args)
        {
            Require(host.Statistics.ManagedRoots == 1, "A原生proxy已真实dealloc且B仍活");
            Require(Saved is { IsDisposed: false }, "B经共享CLR字段读出A保存的opaque仍有owned");
            return Saved;
        }
    }
    private static readonly SharedProxyStorage sharedStorage = new();
    private static readonly TerminalProxyStorage terminalStorage = new();

    [UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
    private static int ReenterBorrowedReceiver()
    {
        try
        {
            GC.Collect(); GC.WaitForPendingFinalizers(); host.DrainReferences();
            Require(borrowedReceiver is { IsAlive: true }, "活动borrowed receiver保活到同步清理结束");
            return 0;
        }
        catch (Exception error) { receiverError = error; return -1; }
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    private static unsafe object? TouchTemporaryReceiver()
    {
        using var lease = host.Enter();
        var receiver = new PythonObject(host, host.Check(ProgramObserver.program_receiver_create(&ReenterBorrowedReceiver)));
        borrowedReceiver = new(receiver);
        return receiver.GetAttr("touch");
    }
    private sealed class ExternalCapture : PyNativeObject
    {
        internal PythonObject? Saved;
        public override string TypeName => "external_capture";
        public override object? GetAttr(string name)
        {
            // 登记权暂停时，旧内部token的finalizer仍必须精确退账，不能依赖临时authority指针。
            GC.Collect(); GC.WaitForPendingFinalizers();
            Require(releasedDuringPause is { IsAlive: false }, "Pause期间旧内部owner自然回收");
            Saved = (PythonObject)host.SystemAttribute("version")!;
            return PyNone.Instance;
        }
    }
    private static void Require(bool ok, string text) { if (!ok) throw new InvalidOperationException(text); }
    private static void Run(string text)
    {
        using var lease = host.Enter();
        if (Native.rp_run_entry("<0228-protocol-control>", text) < 0) host.ThrowError();
    }
    private static void Refused(Action action)
    {
        try { action(); } catch (InvalidOperationException e)
        { Require(host.Statistics.State == "running", "拒绝后仍running"); Console.WriteLine("REFUSED " + e.Message); return; }
        throw new InvalidOperationException("关闭本应拒绝");
    }
    private static object? Echo(IPyStockThinEnvironment env, object? value) => value;
    private static object? Self(IPyStockThinEnvironment env, object? value) => env.LoadGlobal("f");
    private static object? Global(IPyStockThinEnvironment env, object? value) => env.LoadGlobal("marker");
    private static object? Repeat(IPyStockThinEnvironment env, object? value) => PyOps.Binary(PyOps.Mul, value!, 2L);
    private static object? Chain(IPyStockThinEnvironment env, object? value)
    {
        var inner = (StockThinFunctionHandle)env.LoadGlobal("repeat")!;
        object? result = inner.Invoke(value);
        GC.Collect(); GC.WaitForPendingFinalizers(); host.DrainReferences();
        return PyOps.Binary(PyOps.Add, result!, env.LoadGlobal("offset")!);
    }
    private static object? RaiseAfterAppend(IPyStockThinEnvironment env, object? value)
    {
        object? opaque = PyOps.CallValue(env.LoadGlobal("object")!, [], [], []);
        ((PyList)env.LoadGlobal("events")!).Items.Add(opaque);
        throw new PyValueError("callback-after-append");
    }
    private static object? FrameInvoke(IPyStockThinEnvironment env, object? value) => PyOps.CallValue(value!, [], [], []);
    private static object? FrameManagedBuffers(IPyStockThinEnvironment env, object? target)
    {
        var bytes = new PyByteArray(System.Text.Encoding.ASCII.GetBytes("value+1"));
        object view = PyMemoryView.Create([bytes], [], []);
        foreach (object source in new object[] { bytes, view })
        {
            Require(PyOps.CallValue(target!, [source, env.LoadGlobal("scope")], [], []) is 42L,
                "CLR buffer显式环境保留");
            try { PyOps.CallValue(target!, [source], [], []); throw new Exception("CLR buffer缺frame未诊断"); }
            catch (PyNotImplementedError) { }
        }
        return PyNone.Instance;
    }
    private static object? FrameManagedCompile(IPyStockThinEnvironment env, object? target) =>
        PyOps.CallValue(target!, [], ["source", "filename", "mode", "dont_inherit"],
            [new PyByteArray(System.Text.Encoding.ASCII.GetBytes("1+2")), "<keyword-buffer>", "eval", true]);
    private static object? FrameImplicitEval(IPyStockThinEnvironment env, object? value) => PyOps.CallValue(value!, ["1+2"], [], []);
    private static object? FrameExplicitEval(IPyStockThinEnvironment env, object? value) => PyOps.CallValue(value!, ["value+1", env.LoadGlobal("scope")], [], []);
    private static object? FrameExplicitExec(IPyStockThinEnvironment env, object? value) => PyOps.CallValue(value!, ["result=value+2", env.LoadGlobal("scope")], [], []);
    private static object? FrameImplicitCompile(IPyStockThinEnvironment env, object? value) => PyOps.CallValue(value!, ["1+2", "<frame-probe>", "eval"], [], []);
    private static object? FrameExplicitCompile(IPyStockThinEnvironment env, object? value) => PyOps.CallValue(value!, ["1+2", "<frame-probe>", "eval", 0L, true], [], []);
    private static object? ConstantString(IPyStockThinEnvironment env, object? value) => constantString;
    private static object? ConstantInteger(IPyStockThinEnvironment env, object? value) => constantInteger;
    private static object? AtExit(IPyStockThinEnvironment env, object? value)
    {
        exits++; Console.WriteLine("EVENT atexit-cil");
        bool rejected = Task.Run(() => {
            try { using var lease = host.Enter(callback: true); return false; }
            catch (ObjectDisposedException) { return true; }
        }).GetAwaiter().GetResult();
        Require(rejected, "终态拒绝外线程新callback租约");
        Require(ReferenceEquals(env.LoadGlobal("marker"), value), "atexit原D身份");
        Require(env.LoadGlobal("len") is not null, "atexit原builtins");
        var f = (StockThinFunctionHandle)env.LoadGlobal("f")!;
        Require(ReferenceEquals(f.Invoke(value), value), "atexit临时H身份");
        try { host.FinishStockProgram(() => 0); throw new Exception("活动关闭未拒绝"); }
        catch (InvalidOperationException) { }
        return value;
    }
    private static object? Del(IPyStockThinEnvironment env, object? value)
    { dels++; Console.WriteLine("EVENT del-cil"); Require(ReferenceEquals(value, env.LoadGlobal("marker")), "析构原D"); return value; }
    private static object? Fail(IPyStockThinEnvironment env, object? value)
    { errors++; throw (PyBaseException)value!; }
    private static object? Unraisable(IPyStockThinEnvironment env, object? value)
    {
        unraisables++; Console.WriteLine("EVENT unraisable-cil");
        Require(ReferenceEquals(value, env.LoadGlobal("del_error")), "unraisable原异常"); return value;
    }
    private static void Define(string name, PyStockThinBody body)
    {
        // 故意不手工Dispose临时H：真实入口owned作用域必须在RunStockThinMain的finally交还。
        object f = PyModuleInstances.CreateStockThinFunction(entryContext,
            new("0228:"+name, "__main__", name, "fixed-cil-body.cs", 1), body);
        module.SetAttr(name, f);
    }
    [MethodImpl(MethodImplOptions.NoInlining)]
    private static WeakReference CreateTransientInternalOwner() =>
        new(host.SystemAttribute("implementation")!);
    private static void Entry(object context)
    {
        entryContext = context;
        Require(PyModules.TryCached("__main__", out var current), "执行前RuntimeCache已发布");
        module = current!; d = (PythonObject)module.GetAttr("__dict__")!;
        using (host.Enter())
            if (ProgramObserver.program_check_missing_builtins() < 0) host.ThrowError();
        if (mode == "zero") return;
        if (mode == "entry-fail") throw new PyValueError("entry-before-F");
        if (mode == "borrowed-receiver")
        {
            Require((long)((PythonObject)TouchTemporaryReceiver()!).ReadScalar("exact_int") == 4123, "原生receiver回调后读取原payload");
            Require(receiverError is null && ProgramObserver.program_receiver_destroyed() == 0,
                "活动协议结束前receiver没有提前析构");
        }
        Run("import gc, atexit, sys\ngc.disable()\nmarker=object()\n");
        Define("f", Echo); Define("global_f", Global); Define("global_self", Self);
        Define("onexit", AtExit); Define("ondel", Del); Define("fail", Fail); Define("onunraisable", Unraisable);
        Define("constant_str", ConstantString); Define("constant_int", ConstantInteger);
        Run("assert f(marker) is marker\nassert global_f(None) is marker\nassert global_self(None) is f\n");
        // 活全局缺失经CP→CIL→CP返回，保留真实NameError的name/args/str；恢复后继续用同一F。
        Run("saved_marker=marker\ndel marker\ntry:\n global_f(None)\nexcept NameError as error:\n assert type(error) is NameError and not isinstance(error, UnboundLocalError)\n assert error.name=='marker'\n assert error.args==(\"name 'marker' is not defined\",)\n assert str(error)==error.args[0]\nelse:\n raise AssertionError('缺失全局必须抛错')\nmarker=saved_marker\ndel saved_marker\nassert global_f(None) is marker\n");
        if (mode == "frame-builtins")
        {
            Define("frame_invoke", FrameInvoke); Define("frame_managed_buffers", FrameManagedBuffers); Define("frame_managed_compile", FrameManagedCompile); Define("frame_implicit_eval", FrameImplicitEval);
            Define("frame_explicit_eval", FrameExplicitEval); Define("frame_explicit_exec", FrameExplicitExec);
            Define("frame_implicit_compile", FrameImplicitCompile); Define("frame_explicit_compile", FrameExplicitCompile);
            Run("""
import builtins
from functools import partial
scope={'value':41}
def check_frames(m=marker, d=globals(), canonical=tuple(getattr(builtins,n) for n in ('globals','locals','vars','eval','exec','compile'))):
 g,l,v,e,x,c=canonical
 assert frame_invoke(g) is d
 for target in (l,v,partial(l),partial(v),partial(partial(l))):
  try: frame_invoke(target)
  except NotImplementedError as error: assert 'business frame' in str(error)
  else: raise AssertionError('缺frame形状未诊断')
 for target in (e,x):
  try: frame_implicit_eval(target)
  except NotImplementedError as error: assert 'explicit globals' in str(error)
  else: raise AssertionError('隐式环境未诊断')
 try: frame_implicit_compile(c)
 except NotImplementedError as error: assert 'dont_inherit=True' in str(error)
 else: raise AssertionError('缺caller flags来源未诊断')
 assert frame_explicit_eval(e)==42
 assert frame_managed_buffers(e) is None
 assert type(frame_managed_compile(c)).__name__=='code'
 import ast
 parsed=ast.parse('1+2',mode='eval')
 assert type(frame_invoke(partial(c,parsed,'<ast>','eval',dont_inherit=True))).__name__=='code'
 try: frame_invoke(partial(c,parsed,'<ast>','eval'))
 except NotImplementedError as error: assert 'caller flags' in str(error)
 else: raise AssertionError('AST缺caller flags来源未诊断')
 events=[]
 class Indexed:
  def __index__(self): events.append('index'); return 0
 class BrokenIndex:
  def __index__(self): events.append('broken'); raise LookupError('index-probe')
 assert type(frame_invoke(partial(c,'1+2','<index>','eval',Indexed(),True))).__name__=='code'
 assert events==['index']; events.clear()
 try: frame_invoke(partial(c,'1+2','<index>','eval',BrokenIndex(),True))
 except LookupError as error: assert str(error)=='index-probe'
 else: raise AssertionError('flags异常丢失')
 assert events==['broken']; events.clear()
 class Inherit:
  def __bool__(self): events.append('bool'); return False
 for target in (partial(c,'1','<implicit>','eval',Indexed()),partial(c,'1','<implicit>','eval',0,Inherit())):
  try: frame_invoke(target)
  except NotImplementedError as error: assert 'parameter protocols' in str(error)
  else: raise AssertionError('参数协议缺caller frame未诊断')
 assert events==[]
 for flags in (-1,1,1<<30):
  def observe(call):
   try: call()
   except Exception as error: return type(error),error.args
   raise AssertionError('非法flags应失败')
  assert observe(partial(frame_invoke,partial(c,'1','<invalid>','eval',flags)))==observe(partial(c,'1','<invalid>','eval',flags))
 original=partial(c,'1','<defaults>','eval',dont_inherit=False)
 assert type(frame_invoke(partial(original,dont_inherit=True))).__name__=='code'
 assert original.keywords=={'dont_inherit':False}
 class Buffer:
  def __buffer__(self, flags): events.append('buffer'); return memoryview(b'40+2')
  def __release_buffer__(self, view): events.append('release')
 assert frame_invoke(partial(e,Buffer(),scope))==42
 assert events==['buffer','release']; events.clear()
 try: frame_invoke(partial(e,Buffer()))
 except NotImplementedError: pass
 else: raise AssertionError('自定义buffer缺frame未诊断')
 assert events==[]
 released=memoryview(b'42'); released.release()
 for target in (partial(e,released),partial(e,released,scope)):
  try: frame_invoke(target)
  except TypeError as error: assert str(error)=='eval() arg 1 must be a string, bytes or code object'
  else: raise AssertionError('已释放buffer错误丢失')
 class BrokenBuffer:
  def __buffer__(self,flags): events.append('broken-buffer'); raise LookupError('buffer-probe')
 try: frame_invoke(partial(e,BrokenBuffer(),scope))
 except TypeError as error: assert str(error)=='eval() arg 1 must be a string, bytes or code object'
 else: raise AssertionError('buffer异常丢失')
 assert events==['broken-buffer']
 assert frame_invoke(partial(e,'value+1',scope))==42
 class Example: pass
 sample=Example()
 assert frame_invoke(partial(v,sample)) is sample.__dict__
 assert frame_invoke(partial(c,'1+2','<partial>','eval',dont_inherit=True)).__class__.__name__=='code'
 for target in (partial(e,'1+2'),partial(x,'a=1'),partial(c,'1+2','<partial>','eval')):
  try: frame_invoke(target)
  except NotImplementedError: pass
  else: raise AssertionError('partial缺frame形状未诊断')
 for source in (bytearray(b'value+1'),memoryview(b'value+1')):
  assert frame_invoke(partial(e,source,scope))==42
  try: frame_invoke(partial(e,source))
  except NotImplementedError: pass
  else: raise AssertionError('buffer隐式环境未诊断')
 assert frame_explicit_exec(x) is None and scope['result']==43
 assert type(frame_explicit_compile(c)).__name__=='code'
 def locals(): return 123
 assert frame_invoke(locals)==123
check_frames()
atexit.register(check_frames)
""");
        }
        if (mode == "terminal-alias")
        {
            module.SetAttr("proxy_a", PyNativeFunctions.CreateVariadic("proxy_a", sharedStorage.Save));
            module.SetAttr("proxy_b", PyNativeFunctions.CreateVariadic("proxy_b", sharedStorage.Read));
            Run("def terminal_alias(m=marker):\n a=globals().pop('proxy_a')\n b=proxy_b\n assert a(m) is m\n a=None\n gc.collect()\n assert b(None) is m\natexit.register(terminal_alias)\n");
        }
        if (mode is "terminal-proxy" or "terminal-cycle")
        {
            module.SetAttr("internal_proxy", PyNativeFunctions.CreateVariadic("internal_proxy", terminalStorage.Call));
            if (mode == "terminal-cycle")
                Run("def terminal_cycle(cb=internal_proxy):\n value=[cb]\n assert cb(value) is None\natexit.register(terminal_cycle)\n");
            else
                Run("def terminal_proxy(cb=internal_proxy, m=marker):\n assert cb(m) is m\n try:\n  cb(m)\n except ValueError as error:\n  assert error.args==('terminal-proxy-original',)\n else:\n  raise AssertionError('终态原异常未保留')\n for _ in range(1000):\n  assert cb(m) is m\natexit.register(terminal_proxy)\n");
        }
        if (mode == "callback-result")
        {
            var unsupported = new PyClass("UnsupportedDescriptor");
            unsupported.SetAttr("__set_name__", PyNone.Instance); unsupported.SetAttr("__get__", PyNone.Instance);
            int rootsBefore = host.Statistics.ManagedRoots;
            try { using var lease = host.Enter(); Native.rp_decref(host.ToPython(new PyInstance(unsupported))); throw new Exception("构造应拒绝未桥接descriptor"); }
            catch (PyNotImplementedError) { }
            Require(host.Statistics.ManagedRoots == rootsBefore, "代理创建失败真实回滚root和内部登记");
            module.SetAttr("offset", new PyList([3L]));
            escapedValues = new PyList(); module.SetAttr("events", escapedValues);
            Define("repeat", Repeat); Define("chain", Chain); Define("raise_after_append", RaiseAfterAppend);
            var chain = (StockThinFunctionHandle)module.GetAttr("chain")!;
            var source = new PyList([1L, 2L]);
            Require(PyRepr.Repr(chain.Invoke(source)) == "[1, 2, 1, 2, 3]", "嵌套callback结果在GC和外层同步后仍可组合");
            Require(PyRepr.Repr(source) == "[1, 2]", "原列表别名不变");
            var raise = (StockThinFunctionHandle)module.GetAttr("raise_after_append")!;
            try { raise.Invoke(PyNone.Instance); throw new Exception("应抛原ValueError"); }
            catch (PyValueError) { }
            GC.Collect(); GC.WaitForPendingFinalizers(); host.DrainReferences();
            Require(escapedValues.Items[0] is PythonObject { IsDisposed: false } saved && saved.TypeName == "object",
                "异常前保存到同步容器的opaque保持owned且可用");
        }
        // 同一CLR常量反复导出；每次丢弃CP结果后再次调用，覆盖retired reverse旧地址复用。
        Run("for _ in range(1000):\n assert constant_str(None)=='恒定CIL字符串:重复导出:0123456789'\n assert constant_int(None)==123456789012345\n");
        if (mode == "external-callback")
        {
            releasedDuringPause = CreateTransientInternalOwner();
            module.SetAttr("external_probe", capture);
            Run("external_probe.capture\nexternal_probe=None\n");
            Require(capture.Saved is { IsDisposed: false }, "第三方回调保存新opaque");
        }
    }
    public static int Main(string[] args)
    {
        Require(RuntimeFeature.IsDynamicCodeSupported == (args[2] == "jit"), "实际JIT/NativeAOT模式与命令一致");
        mode = args[1];
        if (mode == "no-host")
        {
            Require(Bootstrap.FinishStockThin(17) == 17, "未启动/回滚后finish保留错误码");
            Console.WriteLine("PASS no-host finish=17"); return 0;
        }
        Bootstrap.StartStockThin(args[0], ["0228-product-program"]); host = Bootstrap.Host;
        using (host.Enter()) Require(ProgramObserver.program_install_observer() == 0, "低层观察安装");
        if (mode == "pre-entry-fail")
        {
            Require(Bootstrap.FinishStockThin(17) == 17 && host.Statistics.State == "closed",
                "入口前无授权/零候选按普通Finish保留错误码");
            Require(!host.HasStockProgramPermission && host.ProgramResult is null, "没有伪造程序权限");
            Console.WriteLine("PASS pre-entry-fail finish=17"); return 0;
        }
        PyModules.RegisterStockEntrySourceLocated("__main__", "", "fixed-cil-body.cs", 1,
            Path.GetFullPath("fixed-cil-body.cs"), false, Entry);
        try { Bootstrap.RunStockThinMain(); Require(mode != "entry-fail", "入口应抛错"); }
        catch (PyValueError) when (mode == "entry-fail") { Console.WriteLine("EXPECTED entry-before-F"); }
        if (mode == "entry-fail")
        {
            Require(host.EnterDiagnosticScope(null!) is null, "空诊断请求不能授予内部scope");
            PyTraceback.Report(new PyValueError("expected-diagnostic-report"));
            Require(PyTraceback.SystemExitCode(new PySystemExit("expected-diagnostic-system-exit")) == 1,
                "SystemExit诊断保留原exitcode");
        }
        bool empty = mode is "zero" or "entry-fail";
        Require(CPythonHost.StockThinOwnedHandles == 0, "内部H已由入口作用域确定交还");
        if (mode == "borrowed-receiver")
            Require(ProgramObserver.program_receiver_destroyed() == 1, "入口收敛后receiver真实析构一次");
        Refused(host.Dispose); // 零F也有module/D owned，不能绕回普通Dispose清账。
        if (!empty)
        {
            Require(ReferenceEquals(module, host.Import("__main__")), "Host与Runtime同一module");
        }
        if (mode == "external-callback")
        {
            Require(host.Statistics.ManagedRoots == 0, "第三方CP代理已真实析构，余下仅外逃owned");
            Refused(() => host.FinishStockProgram(() => 0));
            Require(((string)capture.Saved!.ReadScalar("exact_str")).Length > 0, "拒绝后opaque仍可用");
            capture.Saved.Dispose(); host.DrainReferences();
        }
        if (mode == "external-proxy")
        {
            nint external;
            using (host.Enter()) external = host.ToPython(PyNativeFunctions.CreateVariadic("external_proxy", static args => PyNone.Instance));
            Refused(() => host.FinishStockProgram(() => 0));
            using (host.Enter()) Native.rp_decref(external);
            Require(host.Statistics.ManagedRoots == 0, "外部proxy由真实dealloc交还后可重试");
        }
        if (mode == "external")
        {
            var h = (StockThinFunctionHandle)module.GetAttr("f")!;
            Refused(() => host.FinishStockProgram(() => 0));
            object input = 42L;
            Require(ReferenceEquals(h.Invoke(input), input), "拒绝后H仍可调用");
            host.ReleaseObject(input); h.Dispose(); host.DrainReferences();
        }
        if (mode == "external-d")
        {
            PythonObject extra;
            using (host.Enter()) extra = new PythonObject(host, Native.rp_incref(d.Pointer));
            Refused(() => host.FinishStockProgram(() => 0)); extra.Dispose(); host.DrainReferences();
        }
        if (mode is "external-p" or "external-self" or "external-cell")
        {
            string expr = mode switch { "external-p" => "f.__closure__[0].cell_contents",
                "external-self" => "f.__closure__[0].cell_contents.__self__", _ => "f.__closure__[0]" };
            Run("escaped=" + expr);
            var opaque = (PythonObject)module.GetAttr("escaped")!; host.ReleaseObject("escaped");
            Refused(() => host.FinishStockProgram(() => 0)); Require(!opaque.IsDisposed, "外逃opaque仍有效");
            opaque.Dispose(); host.DrainReferences();
        }
        if (mode == "external-container")
        {
            var h = (StockThinFunctionHandle)module.GetAttr("f")!;
            var container = new PyList([h]);
            using (host.Enter()) Native.rp_decref(host.TransferContainer(container));
            h.Dispose(); host.DrainReferences();
            Require(CPythonHost.StockThinOwnedHandles == 0, "H为零但CP容器仍ownedF");
            Refused(() => host.FinishStockProgram(() => 0));
            host.Unregister(container); host.DrainReferences(); GC.KeepAlive(container);
        }
        using (host.Enter())
        {
            try { host.FinishStockProgram(() => 0); throw new Exception("租约内应拒绝"); }
            catch (InvalidOperationException) { Console.WriteLine("REFUSED active-lease"); }
        }
        using (var entered = new ManualResetEventSlim()) using (var leave = new ManualResetEventSlim())
        {
            var worker = new Thread(() => { using var lease = host.Enter(); entered.Set(); leave.Wait(); });
            worker.Start(); entered.Wait(); Refused(() => host.FinishStockProgram(() => 0)); leave.Set(); worker.Join();
        }
        if (!empty) Run("""
del_error=ValueError('unraisable-original')
def unraisable_hook(info, cb=onunraisable, err=del_error):
 assert info.exc_value is err and cb(info.exc_value) is err
sys.unraisablehook=unraisable_hook
class Finalizer:
 def __init__(self, cb=ondel, bad=fail, m=marker, err=del_error): self.cb,self.bad,self.m,self.err=cb,bad,m,err
 def __del__(self):
  assert self.cb(self.m) is self.m
  e=ValueError('del-original')
  try: self.bad(e)
  except ValueError as got: assert got is e
  else: raise AssertionError('原异常丢失')
  self.bad(self.err)
victim=Finalizer()
victim.cycle=victim
victim=None
def check_exit(cb=onexit, bad=fail, m=marker):
 assert sys.modules['__main__'].__dict__ is globals()
 assert f(m) is m and global_f(None) is m and global_self(None) is f
 for _ in range(1000):
  assert constant_str(None)=='恒定CIL字符串:重复导出:0123456789'
  assert constant_int(None)==123456789012345
 assert cb(m) is m
 e=ValueError('exit-original')
 try: bad(e)
 except ValueError as got: assert got is e
 else: raise AssertionError('原异常丢失')
atexit.register(check_exit)
""");
        int requested = mode == "entry-fail" ? 7 : 0;
        int exit = Bootstrap.FinishStockThin(requested);
        if (mode == "terminal-cycle")
        {
            var rejected = host.ProgramResult!;
            Require(exit != 0 && rejected.Ledger > 0 && host.Statistics.ManagedRoots > 0 && rejected.PostFinalizeDecrefs == 0 && rejected.Late == 0,
                "不可见跨堆回指环保留真实失败账本");
            Console.WriteLine("EXPECTED_INVISIBLE_CYCLE ledger=" + rejected.Ledger + " roots=" + host.Statistics.ManagedRoots);
            GC.KeepAlive(terminalStorage); GC.KeepAlive(sharedStorage); return 0;
        }

        GC.Collect(); GC.WaitForPendingFinalizers();
        var result = host.ProgramResult!; var stats = host.Statistics;
        Native.rp_reference_stats(out long post);
        Console.WriteLine($"AFTER mode={mode} exit={exit} finalize={result.FinalizeResult} native={result.NativeLive} destroyed={result.Destroyed} roots={result.CoreRoots} H={result.OwnedHandles} ledger={stats.Handles} queue={stats.PendingReleases} late={stats.LateReleases} postFinalizeDecref={post} lowlevelNative={ProgramObserver.program_lowlevel_live()} atexit={exits} del={dels} errors={errors} unraisable={unraisables}");
        bool ok = exit == requested && result.FinalizeResult == 0 && result.NativeLive == 0 && result.CoreRoots == 0
            && result.OwnedHandles == 0 && stats.Handles == 0 && stats.PendingReleases == 0 && stats.LateReleases == 0
            && post == 0 && ProgramObserver.program_lowlevel_live() == 0
            && (empty ? exits+dels+errors+unraisables == 0 : exits == 1 && dels == 1 && errors == 3 && unraisables == 1);
        GC.KeepAlive(module); GC.KeepAlive(d); GC.KeepAlive(entryContext); GC.KeepAlive(escapedValues); GC.KeepAlive(terminalStorage); GC.KeepAlive(sharedStorage);
        return ok ? 0 : 2;
    }
}
