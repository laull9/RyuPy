// 仅加入仓外 provider 程序集的 partial Host 实验：登记 module/D 的独占终态所有权。
// 与普通 Dispose 分离；预检失败不改根，提交后只准 owner 线程同步回调，最终释放走真实队列。
using System.Runtime.CompilerServices;
using System.Runtime.InteropServices;
using RyuPy.Runtime;
namespace RyuPy.CPython;

public sealed partial class CPythonHost
{
    private PythonObject[] programOwners = [];
    private bool programTerminal;
    private List<PythonObject>? programRegistrationOwners;
    internal void BeginProgramEntry() => programRegistrationOwners = [];
    internal void RegisterProgramOwners(PyModule module)
    {
        if (programRegistrationOwners is not { } created || programOwners.Length != 0)
            throw new InvalidOperationException("缺失或重复发布事务");
        // 所有权按创建事务登记，绝不从 weak cache 或 pointer 类型推断。
        programOwners = created.Where(x => !x.IsDisposed).ToArray();
        programRegistrationOwners = null;
        if (!programOwners.Contains((PythonObject)module.ForeignObject!))
            throw new InvalidOperationException("module 未在事务内创建");
        Console.WriteLine($"REGISTER owned={programOwners.Length} ledger={handles.Count}");
    }
    internal unsafe void EnableProgramProbe(bool scoped)
    {
        using var lease = Enter();
        if (Native.rp_thin_enable(scoped ? &ProgramInvoke : &InvokeStockThin, &ReleaseStockThin) < 0) ThrowError();
        stockThinEnabled = true;
    }
    internal int FinishProgramForProbe(bool releaseOwners)
    {
        if (leaseDepth != 0 || Environment.CurrentManagedThreadId != ownerThread)
            throw new InvalidOperationException("调用中或错误线程禁止结束程序");
        lock (gate)
        {
            if (state != 1 || active != 0) throw new InvalidOperationException("活动调用禁止结束程序");
            state = 2;
        }
        try
        {
            using var lease = Enter();
            var allowed = programOwners.Select(x => x.Pointer).ToHashSet();
            if (StockThinOwnedHandles != 0 || handles.Count != programOwners.Length
                || handles.Values.Any(p => !allowed.Contains(p)) || Roots.Count != 0)
                throw new InvalidOperationException("外部 owned 引用禁止结束程序");
        }
        catch { lock (gate) state = 1; throw; }
        // 提交点：从此独占程序终态；所有外部使用权已经由前置门拒绝。
        programTerminal = true;
        using (var lease = Enter())
        {
            if (releaseOwners) foreach (var owner in programOwners) owner.Dispose();
            Drain();
            if (ProgramNative.program_prepare() < 0) throw new InvalidOperationException("模板移交失败");
        }
        // 2 允许 owner 同步重入并真实 Drain；4 会丢弃 Release，因此本实验不能使用4。
        int result = ProgramNative.program_stop();
        lock (gate) state = 3;
        Instance = null;
        // ledger 保持原样作为证据，没有 Clear 或终止后 DECREF。
        imported.Clear(); objects.Clear(); tclTkEnvironment?.TryRestore();
        return result;
    }
    internal void ReadProgramCounts(out long live, out long destroyed, out long calls, out long dec, out long post)
        => ProgramNative.program_counts(out live, out destroyed, out calls, out dec, out post);
    internal static long ProgramLowlevelLive => ProgramNative.program_lowlevel_live();
    internal static int ProgramCoreRoots => Volatile.Read(ref stockThinRoots);

    private List<IDisposable>? programCallbackOwners;
    internal void ObserveProgramOwner(PythonObject owner)
    { programRegistrationOwners?.Add(owner); programCallbackOwners?.Add(owner); }
    internal void ObserveProgramThinOwner(StockThinFunctionOwner owner) => programCallbackOwners?.Add(owner);

    [UnmanagedCallersOnly(CallConvs = [typeof(CallConvCdecl)])]
    private static unsafe nint ProgramInvoke(nint token, nint function, nint argument)
    {
        try { return ProgramInvokeCore(token, function, argument); }
        catch (Exception error) { Native.rp_error_text("RuntimeError", error.Message); return 0; }
    }
    private static unsafe nint ProgramInvokeCore(nint token, nint function, nint argument)
    {
        var invoke = (delegate* unmanaged[Cdecl]<nint,nint,nint,nint>)&InvokeStockThin;
        var host = Instance!;
        if (!host.programTerminal) return invoke(token, function, argument);
        Lease? lease = null;
        var previous = host.programCallbackOwners;
        var owners = new List<IDisposable>();
        host.programCallbackOwners = owners;
        nint result = 0, raised = 0;
        try
        {
            // 外层租约覆盖产品 callback 的参数导入、异常恢复、结果导出及全部清理。
            lease = host.Enter(callback: true);
            result = invoke(token, function, argument);
            raised = Native.rp_take_error();
            // 先导出 result / 恢复 raised，再交还本次作用域创建的包装；返回值已独立 owned。
            // 用倒序释放 holder，确保 H 计数与其 PythonObject 一起幂等归零。
            for (int i = owners.Count - 1; i >= 0; i--) owners[i].Dispose();
            host.Drain();
        }
        catch (Exception error)
        {
            Native.rp_decref(result); result = 0;
            if (raised == 0) Native.rp_error_text("RuntimeError", error.Message);
        }
        finally
        {
            // Dispose/Drain 中可能有 __del__ 重入：恢复嵌套作用域必须在最后。
            host.programCallbackOwners = previous;
            if (raised != 0) { Native.rp_restore_error(raised); Native.rp_decref(raised); }
            lease?.Dispose();
        }
        return result;
    }
}
internal static class ProgramNative
{
    [DllImport(Native.Library)] internal static extern int program_canonical_builtins(nint module);
    [DllImport(Native.Library)] internal static extern long program_lowlevel_live();
    [DllImport(Native.Library)] internal static extern int program_prepare();
    [DllImport(Native.Library)] internal static extern int program_stop();
    [DllImport(Native.Library)] internal static extern void program_counts(out long live, out long destroyed,
        out long calls, out long decrefs, out long post);
}
