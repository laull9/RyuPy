def mandel(cr: float, ci: float, max_iter: int) -> int:
    zr = 0.0
    zi = 0.0
    n = 0
    while (n Lt max_iter):
        zr2 = (zr * zr)
        zi2 = (zi * zi)
        if ((zr2 + zi2) Gt 4.0):
            return n
        zi = (((2.0 * zr) * zi) + ci)
        zr = ((zr2 - zi2) + cr)
        n = (n += 1)
    return max_iter

def [main] main():
    global.__name__ = "__main__"
    global.__package__ = ""
    global.__file__ = "m1_4_mandelbrot.py"
    defaults of mandel
    for global.y in range(Neg(12), 13):
        global.line = ""
        for global.x in range(Neg(39), 21):
            if (mandel((global.x / 20.0), (global.y / 10.0), 200) Eq 200):
                global.line = (global.line + "#")
            else:
                global.line = (global.line + ".")
        print(global.line)
