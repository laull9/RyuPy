def fib_rec(n: int) -> int:
    if (n Lt 2):
        return n
    return (fib_rec((n - 1)) + fib_rec((n - 2)))

def fib_iter(n: int) -> int:
    a = 0
    b = 1
    for _ in range(0, n):
        t = (a + b)
        a = b
        b = t
    return a

def [main] main():
    print(fib_rec(25))
    print(fib_iter(90))
