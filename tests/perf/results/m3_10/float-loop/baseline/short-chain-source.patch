diff --git a/crates/ryupy-codegen-cil/src/exact_f64_tests.rs b/crates/ryupy-codegen-cil/src/exact_f64_tests.rs
new file mode 100644
index 0000000..e4b4168
--- /dev/null
+++ b/crates/ryupy-codegen-cil/src/exact_f64_tests.rs
@@ -0,0 +1,178 @@
+//! Double原语的真实PE契约：isinst/unbox.any与独立mul/add，不引入Python转换或融合算术助手。
+use super::exact_i64_tests::{function, local, program, single_block};
+use dotnetdll::prelude::*;
+use la_arena::Arena;
+use ryupy_mir::{
+    BasicBlock, BinOp, Body, Constant, MirType, Operand, Rvalue, Statement, Terminator,
+};
+
+#[test]
+fn exact_double_guard_unbox_and_arithmetic_are_mechanical_clr_operations() {
+    let mut program = program();
+    let mut locals = Arena::default();
+    let input = local(&mut locals, MirType::Dynamic);
+    let guard = local(&mut locals, MirType::Bool);
+    let value = local(&mut locals, MirType::F64);
+    let mut blocks = Arena::default();
+    let entry = blocks.alloc(BasicBlock {
+        stmts: vec![Statement::Assign {
+            dest: guard,
+            value: Rvalue::IsBoxedF64 {
+                value: Operand::Local(input),
+            },
+        }],
+        terminator: Terminator::Unreachable,
+    });
+    let yes = blocks.alloc(BasicBlock {
+        stmts: vec![Statement::Assign {
+            dest: value,
+            value: Rvalue::UnboxExactF64 {
+                value: Operand::Local(input),
+            },
+        }],
+        terminator: Terminator::Return(Some(Operand::Local(value))),
+    });
+    let no = blocks.alloc(BasicBlock {
+        stmts: vec![],
+        terminator: Terminator::Return(Some(Operand::Const(Constant::F64(0.0)))),
+    });
+    blocks[entry].terminator = Terminator::Branch {
+        cond: Operand::Local(guard),
+        then_: yes,
+        else_: no,
+    };
+    program.functions.alloc(function(
+        "guarded_double",
+        Body {
+            locals,
+            blocks,
+            entry,
+            regions: vec![],
+        },
+        vec![input],
+        MirType::F64,
+    ));
+    let mut locals = Arena::default();
+    let input = local(&mut locals, MirType::Dynamic);
+    let value = local(&mut locals, MirType::F64);
+    program.functions.alloc(function(
+        "converting_double",
+        single_block(
+            locals,
+            vec![Statement::Assign {
+                dest: value,
+                value: Rvalue::Unbox {
+                    value: Operand::Local(input),
+                    to: MirType::F64,
+                },
+            }],
+            Some(Operand::Local(value)),
+        ),
+        vec![input],
+        MirType::F64,
+    ));
+    let mut locals = Arena::default();
+    let a = local(&mut locals, MirType::F64);
+    let b = local(&mut locals, MirType::F64);
+    let c = local(&mut locals, MirType::F64);
+    let product = local(&mut locals, MirType::F64);
+    let result = local(&mut locals, MirType::F64);
+    program.functions.alloc(function(
+        "double_chain",
+        single_block(
+            locals,
+            vec![
+                Statement::Assign {
+                    dest: product,
+                    value: Rvalue::Binary {
+                        op: BinOp::Mul,
+                        lhs: Operand::Local(a),
+                        rhs: Operand::Local(b),
+                    },
+                },
+                Statement::Assign {
+                    dest: result,
+                    value: Rvalue::Binary {
+                        op: BinOp::Add,
+                        lhs: Operand::Local(product),
+                        rhs: Operand::Local(c),
+                    },
+                },
+            ],
+            Some(Operand::Local(result)),
+        ),
+        vec![a, b, c],
+        MirType::F64,
+    ));
+    let bytes = crate::emit_assembly(
+        &program,
+        &crate::EmitOptions {
+            assembly_name: "exact_f64".into(),
+            entry_source_path: None,
+        },
+    )
+    .unwrap();
+    let res = Resolution::parse(&bytes, ReadOptions::default()).unwrap();
+    let instructions = |name: &str| {
+        &res.type_definitions
+            .iter()
+            .flat_map(|t| &t.methods)
+            .find(|m| m.name == name)
+            .unwrap()
+            .body
+            .as_ref()
+            .unwrap()
+            .instructions
+    };
+    let exact = instructions("guarded_double");
+    let guard = exact
+        .iter()
+        .position(|i| matches!(i, Instruction::IsInstance(_)))
+        .unwrap();
+    assert!(exact[guard].show(&res).contains("double"));
+    assert!(matches!(exact[guard + 1], Instruction::LoadNull));
+    assert!(matches!(exact[guard + 2], Instruction::CompareEqual));
+    assert!(matches!(
+        exact[guard + 3],
+        Instruction::LoadConstantInt32(0)
+    ));
+    assert!(matches!(exact[guard + 4], Instruction::CompareEqual));
+    assert!(
+        exact
+            .iter()
+            .find(|i| matches!(i, Instruction::UnboxIntoValue(_)))
+            .unwrap()
+            .show(&res)
+            .contains("double")
+    );
+    assert!(!exact.iter().any(|i| i.show(&res).contains("PyCast")));
+    assert!(
+        instructions("converting_double")
+            .iter()
+            .any(|i| i.show(&res).contains("ToFloat64"))
+    );
+    let chain = instructions("double_chain");
+    assert_eq!(
+        chain
+            .iter()
+            .filter(|i| matches!(i, Instruction::Multiply))
+            .count(),
+        1
+    );
+    assert_eq!(
+        chain
+            .iter()
+            .filter(|i| matches!(i, Instruction::Add))
+            .count(),
+        1
+    );
+    assert!(!chain.iter().any(|i| matches!(
+        i,
+        Instruction::AddOverflow(_) | Instruction::MultiplyOverflow(_)
+    )));
+    assert!(
+        !chain
+            .iter()
+            .any(|i| i.show(&res).contains("PyPic") || i.show(&res).contains("FusedMultiply"))
+    );
+}
diff --git a/crates/ryupy-driver/tests/float_chain.rs b/crates/ryupy-driver/tests/float_chain.rs
new file mode 100644
index 0000000..4007827
--- /dev/null
+++ b/crates/ryupy-driver/tests/float_chain.rs
@@ -0,0 +1,110 @@
+//! 短浮点链必须在真实源码命中；差分覆盖精确守卫失败、逐次舍入与原异常位置。
+use ryupy_driver::{BuildOptions, Session, Stage};
+mod support;
+
+fn section<'a>(mir: &'a str, name: &str) -> &'a str {
+    mir.split(&format!("fn {name}("))
+        .nth(1)
+        .unwrap_or_else(|| panic!("缺少被测试函数 {name}"))
+        .split("\nfn ")
+        .next()
+        .unwrap()
+}
+
+#[test]
+fn real_numeric_kernels_expose_guarded_float_chains() {
+    let root = ryupy_driver::runtime::workspace_root();
+    for (file, name) in [("matmul.py", "matmul"), ("nbody.py", "advance")] {
+        let mut session = Session::default();
+        let mir = support::dump(
+            &mut session,
+            &root.join("tests/benchmarks").join(file),
+            Stage::Mir,
+        )
+        .unwrap();
+        let function = section(&mir, name);
+        assert!(function.contains("is_boxed_f64"), "{name} 没有真实守卫");
+        assert!(
+            function.contains("unbox_exact_f64"),
+            "{name} 没有真实直接浮点拆箱"
+        );
+        assert!(function.contains("dyn.Mul"), "必须保留原动态失败路径");
+    }
+}
+
+#[test]
+fn float_chain_fixture_matches_pinned_python_after_real_specialization() {
+    let root = ryupy_driver::runtime::workspace_root();
+    let input = root.join("tests/e2e/phase3/m3_10_float_chain.py");
+    let python = std::env::var_os("PYTHON").unwrap_or_else(|| "python3".into());
+    let version = std::process::Command::new(&python)
+        .arg("--version")
+        .output()
+        .unwrap();
+    let pinned = std::fs::read_to_string(root.join("tests/pinned-python.txt")).unwrap();
+    assert!(String::from_utf8_lossy(&version.stdout).contains(pinned.trim()));
+    let expected = std::process::Command::new(&python)
+        .arg(&input)
+        .output()
+        .unwrap();
+    assert!(expected.status.success());
+    let mut session = Session::default();
+    let mir = support::dump(&mut session, &input, Stage::Mir).unwrap();
+    for name in ["mul_add", "norm_squared"] {
+        assert!(
+            section(&mir, name).contains("unbox_exact_f64"),
+            "真实语义差分必须命中 {name}"
+        );
+    }
+    let artifact = ryupy_driver::build(
+        &mut session,
+        &BuildOptions {
+            input,
+            out_dir: root.join("target/test_float_chain"),
+            aot: false,
+            search_paths: vec![],
+        },
+    )
+    .unwrap();
+    let actual = ryupy_driver::dotnet::run_dll(&artifact.dll).unwrap();
+    assert_eq!(
+        actual.status.code(),
+        expected.status.code(),
+        "{}",
+        String::from_utf8_lossy(&actual.stderr)
+    );
+    assert_eq!(actual.stdout, expected.stdout);
+    assert_eq!(actual.stderr, expected.stderr);
+}
+
+#[test]
+fn guard_failure_retains_original_user_protocol_traceback() {
+    let root = ryupy_driver::runtime::workspace_root();
+    let dir = root.join("target/test_float_chain_trace");
+    std::fs::create_dir_all(&dir).unwrap();
+    let input = dir.join("float_chain_error.py");
+    std::fs::write(
+        &input,
+        "class Bad:\n    def __radd__(self, other):\n        raise ValueError('原回调')\ndef fused(a, b, c):\n    return a * b + c\nprint(fused(2.0, 3.0, Bad()))\n",
+    )
+    .unwrap();
+    let mut session = Session::default();
+    let mir = support::dump(&mut session, &input, Stage::Mir).unwrap();
+    assert!(section(&mir, "fused").contains("unbox_exact_f64"));
+    let artifact = ryupy_driver::build(
+        &mut session,
+        &BuildOptions {
+            input,
+            out_dir: dir.join("build"),
+            aot: false,
+            search_paths: vec![],
+        },
+    )
+    .unwrap();
+    let actual = ryupy_driver::dotnet::run_dll(&artifact.dll).unwrap();
+    assert_eq!(actual.status.code(), Some(1));
+    let error = String::from_utf8_lossy(&actual.stderr);
+    assert!(error.contains("line 3, in __radd__"), "{error}");
+    assert!(error.contains("line 5, in fused"), "{error}");
+    assert!(error.contains("ValueError: 原回调"), "{error}");
+}
diff --git a/crates/ryupy-mir/src/exact_f64_tests.rs b/crates/ryupy-mir/src/exact_f64_tests.rs
new file mode 100644
index 0000000..fdb8157
--- /dev/null
+++ b/crates/ryupy-mir/src/exact_f64_tests.rs
@@ -0,0 +1,185 @@
+//! Double证明不能与Int64/bool混淆；同样遵守写kill、合流及循环回边的must事实契约。
+use crate::mir::*;
+fn sample() -> (Program, [BlockId; 3], [LocalId; 3]) {
+    let (mut p, blocks, locals) = super::tests::sample();
+    let [entry, yes, no] = blocks;
+    let [subject, cond, result] = locals;
+    let f = &mut p.functions[p.entry];
+    f.ret = MirType::F64;
+    f.body.locals[result].ty = MirType::F64;
+    f.body.blocks[entry].stmts = vec![Statement::Assign {
+        dest: cond,
+        value: Rvalue::IsBoxedF64 {
+            value: Operand::Local(subject),
+        },
+    }];
+    f.body.blocks[yes].stmts = vec![Statement::Assign {
+        dest: result,
+        value: Rvalue::UnboxExactF64 {
+            value: Operand::Local(subject),
+        },
+    }];
+    f.body.blocks[no].terminator = Terminator::Return(Some(Operand::Const(Constant::F64(0.0))));
+    (p, blocks, locals)
+}
+fn rejected(p: &Program) {
+    assert!(
+        crate::validate::validate(p)
+            .unwrap_err()
+            .iter()
+            .any(|error| error.contains("精确") || error.contains("拆箱"))
+    );
+}
+fn box_value(dest: LocalId, value: Constant, from: MirType) -> Statement {
+    Statement::Assign {
+        dest,
+        value: Rvalue::Box {
+            value: Operand::Const(value),
+            from,
+        },
+    }
+}
+#[test]
+fn guarded_double_and_preserving_alias_are_valid() {
+    let (mut p, [_, yes, _], [subject, _, _]) = sample();
+    crate::validate::validate(&p).unwrap();
+    p.functions[p.entry].body.blocks[yes].stmts.insert(
+        0,
+        Statement::Assign {
+            dest: subject,
+            value: Rvalue::Use(Operand::Local(subject)),
+        },
+    );
+    crate::validate::validate(&p).unwrap();
+}
+#[test]
+fn integer_guard_and_writes_cannot_prove_double() {
+    for case in 0..4 {
+        let (mut p, [entry, yes, _], [subject, cond, _]) = sample();
+        let f = &mut p.functions[p.entry];
+        match case {
+            0 => {
+                f.body.blocks[entry].stmts[0] = Statement::Assign {
+                    dest: cond,
+                    value: Rvalue::IsBoxedI64 {
+                        value: Operand::Local(subject),
+                    },
+                }
+            }
+            1 => f.body.blocks[yes]
+                .stmts
+                .insert(0, box_value(subject, Constant::I64(1), MirType::I64)),
+            2 => f.body.blocks[yes]
+                .stmts
+                .insert(0, box_value(subject, Constant::Bool(true), MirType::Bool)),
+            _ => f.body.blocks[entry].stmts.push(Statement::Assign {
+                dest: cond,
+                value: Rvalue::Use(Operand::Const(Constant::Bool(true))),
+            }),
+        }
+        rejected(&p);
+    }
+}
+#[test]
+fn mixed_kind_join_and_backedge_invalidate_double_fact() {
+    for mixed in [false, true] {
+        let (mut p, [entry, yes, no], [subject, cond, result]) = sample();
+        let f = &mut p.functions[p.entry];
+        f.body.blocks[entry].stmts = vec![Statement::Assign {
+            dest: cond,
+            value: Rvalue::Use(Operand::Const(Constant::Bool(true))),
+        }];
+        let join = f.body.blocks.alloc(BasicBlock {
+            stmts: vec![Statement::Assign {
+                dest: result,
+                value: Rvalue::UnboxExactF64 {
+                    value: Operand::Local(subject),
+                },
+            }],
+            terminator: Terminator::Return(Some(Operand::Local(result))),
+        });
+        f.body.blocks[yes].stmts = vec![box_value(subject, Constant::F64(1.0), MirType::F64)];
+        f.body.blocks[no].stmts = if mixed {
+            vec![box_value(subject, Constant::I64(1), MirType::I64)]
+        } else {
+            vec![box_value(subject, Constant::F64(2.0), MirType::F64)]
+        };
+        f.body.blocks[yes].terminator = Terminator::Goto(join);
+        f.body.blocks[no].terminator = Terminator::Goto(join);
+        if mixed {
+            rejected(&p);
+        } else {
+            crate::validate::validate(&p).unwrap();
+        }
+    }
+    let (mut p, [_, yes, no], [subject, _, _]) = sample();
+    let f = &mut p.functions[p.entry];
+    f.body.blocks[yes]
+        .stmts
+        .push(box_value(subject, Constant::I64(1), MirType::I64));
+    f.body.blocks[yes].terminator = Terminator::Branch {
+        cond: Operand::Const(Constant::Bool(true)),
+        then_: yes,
+        else_: no,
+    };
+    rejected(&p);
+}
+#[test]
+fn double_boxes_do_not_qualify_as_integer_leaf_arguments() {
+    let (mut p, [entry, yes, _], [subject, cond, result]) = sample();
+    let f = &mut p.functions[p.entry];
+    let output = f.body.locals.alloc(LocalDecl {
+        ty: MirType::Dynamic,
+        name: None,
+        is_cell: false,
+    });
+    f.body.blocks[entry].stmts = vec![
+        box_value(subject, Constant::F64(-0.0), MirType::F64),
+        Statement::Assign {
+            dest: cond,
+            value: Rvalue::Use(Operand::Const(Constant::Bool(true))),
+        },
+    ];
+    f.body.blocks[yes].stmts.push(Statement::Assign {
+        dest: output,
+        value: Rvalue::DynCallValue {
+            callee: Operand::Const(Constant::None),
+            args: vec![Operand::Local(subject)],
+        },
+    });
+    assert!(super::exact_call_sites(f).is_empty());
+    f.body.blocks[yes].stmts.pop();
+    crate::validate::validate(&p).unwrap();
+    // 相反方向同样不能用Double证明Int64拆箱。
+    let f = &mut p.functions[p.entry];
+    f.ret = MirType::I64;
+    f.body.locals[result].ty = MirType::I64;
+    f.body.blocks[yes].stmts[0] = Statement::Assign {
+        dest: result,
+        value: Rvalue::UnboxExactI64 {
+            value: Operand::Local(subject),
+        },
+    };
+    rejected(&p);
+}
+#[test]
+fn exact_double_requires_dynamic_input_f64_destination_and_no_dropped_value() {
+    for case in 0..3 {
+        let (mut p, [entry, yes, _], [subject, _, result]) = sample();
+        let f = &mut p.functions[p.entry];
+        match case {
+            0 => f.body.locals[result].ty = MirType::I64,
+            1 => {
+                f.body.blocks[yes].stmts[0] = Statement::Eval(Rvalue::UnboxExactF64 {
+                    value: Operand::Local(subject),
+                })
+            }
+            _ => {
+                f.body.blocks[entry].stmts[0] = Statement::Eval(Rvalue::IsBoxedF64 {
+                    value: Operand::Const(Constant::F64(1.0)),
+                })
+            }
+        }
+        rejected(&p);
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/float_chain.rs b/crates/ryupy-mir/src/passes/float_chain.rs
new file mode 100644
index 0000000..64f73e8
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_chain.rs
@@ -0,0 +1,268 @@
+//! 有界精确浮点算术链：守卫只放宽表示，不把动态协议或操作次序交给后端猜测。
+//!
+//! 首版仅连续的 2–8 条 Add/Sub/Mul，所有输入是动态局部；中间值无名字、无外部读取。
+//! 每函数最多尝试 16 个候选（失败也计入），块/局部/语句预算限制拒绝路径扫描成本。
+use super::MirPass;
+use super::dead_values::{read_operand, read_value};
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+pub struct FloatChain;
+const MAX_STEPS: usize = 8;
+const MAX_INPUTS: usize = 8;
+const MAX_ATTEMPTS: usize = 16;
+const MAX_BLOCKS: usize = 128;
+const MAX_LOCALS: usize = 512;
+const MAX_STATEMENTS: usize = 4096;
+
+pub(super) struct Step {
+    pub(super) dest: LocalId,
+    pub(super) op: BinOp,
+    pub(super) lhs: LocalId,
+    pub(super) rhs: LocalId,
+}
+pub(super) struct Plan {
+    pub(super) block: BlockId,
+    pub(super) start: usize,
+    pub(super) steps: Vec<Step>,
+    pub(super) inputs: Vec<LocalId>,
+}
+
+impl MirPass for FloatChain {
+    fn name(&self) -> &'static str {
+        "float_chain"
+    }
+    fn run(&self, function: &mut Function) {
+        if !eligible(function) {
+            return;
+        }
+        let mut candidates = Vec::new();
+        // 初次只记每个最大连续段的稳定首 dest；不在改写后重访慢路中的同一段。
+        'blocks: for (_, body) in function.body.blocks.iter() {
+            let mut inside = false;
+            for stmt in &body.stmts {
+                if let Some((dest, ..)) = dynamic_step(stmt) {
+                    if !inside {
+                        candidates.push(dest);
+                        if candidates.len() == MAX_ATTEMPTS {
+                            break 'blocks;
+                        }
+                    }
+                    inside = true;
+                } else {
+                    inside = false;
+                }
+            }
+        }
+        for dest in candidates {
+            let definitions = definitions(function);
+            let Some(positions) = definitions.get(&dest) else {
+                continue;
+            };
+            let [(block, start)] = positions.as_slice() else {
+                continue;
+            };
+            let Some(plan) = candidate(function, &definitions, *block, *start) else {
+                continue;
+            };
+            // 每输入三个局部（快照/guard/unbox），每步一个原生结果；CFG至多inputs+3块。
+            if function.body.locals.len() + 3 * plan.inputs.len() + plan.steps.len() > MAX_LOCALS
+                || function.body.blocks.len() + plan.inputs.len() + 3 > MAX_BLOCKS
+            {
+                continue;
+            }
+            super::float_chain_expand::expand(function, plan);
+        }
+    }
+}
+fn eligible(function: &Function) -> bool {
+    function.signature_global.is_some()
+        && function.env.is_none()
+        && function.body.regions.is_empty()
+        && function.body.locals.len() <= MAX_LOCALS
+        && function.body.blocks.len() <= MAX_BLOCKS
+        && function
+            .body
+            .blocks
+            .iter()
+            .map(|(_, block)| block.stmts.len())
+            .sum::<usize>()
+            <= MAX_STATEMENTS
+        && !function.body.locals.iter().any(|(_, local)| local.is_cell)
+        && !function.body.blocks.iter().any(|(_, block)| {
+            matches!(block.terminator, Terminator::Suspend { .. })
+                || block.stmts.iter().any(|stmt| {
+                    matches!(
+                        stmt,
+                        Statement::Assign {
+                            value: Rvalue::MakeGenerator { .. },
+                            ..
+                        } | Statement::Eval(Rvalue::MakeGenerator { .. })
+                    )
+                })
+        })
+}
+
+type Definitions = FxHashMap<LocalId, Vec<(BlockId, usize)>>;
+fn definitions(function: &Function) -> Definitions {
+    let mut result = Definitions::default();
+    for (block, body) in function.body.blocks.iter() {
+        for (position, statement) in body.stmts.iter().enumerate() {
+            if let Statement::Assign { dest, .. } = statement {
+                result.entry(*dest).or_default().push((block, position));
+            }
+        }
+    }
+    result
+}
+fn dynamic_step(statement: &Statement) -> Option<(LocalId, DynOp, &Operand, &Operand, bool)> {
+    match statement {
+        Statement::Assign {
+            dest,
+            value:
+                Rvalue::DynBinary {
+                    op,
+                    lhs,
+                    rhs,
+                    inplace,
+                },
+        } => Some((*dest, *op, lhs, rhs, *inplace)),
+        _ => None,
+    }
+}
+fn candidate(
+    function: &Function,
+    definitions: &Definitions,
+    block: BlockId,
+    start: usize,
+) -> Option<Plan> {
+    let statements = &function.body.blocks[block].stmts;
+    let count = statements[start..]
+        .iter()
+        .take_while(|stmt| dynamic_step(stmt).is_some())
+        .count();
+    if !(2..=MAX_STEPS).contains(&count) {
+        return None;
+    }
+    let mut destinations = FxHashSet::default();
+    for (offset, stmt) in statements[start..start + count].iter().enumerate() {
+        let (dest, _, _, _, _) = dynamic_step(stmt)?;
+        if function.body.locals[dest].ty != MirType::Dynamic
+            || function.params.contains(&dest)
+            || (offset + 1 != count && function.body.locals[dest].name.is_some())
+            || definitions.get(&dest)?.as_slice() != [(block, start + offset)]
+            || !destinations.insert(dest)
+        {
+            return None;
+        }
+    }
+    let mut plan = Plan {
+        block,
+        start,
+        steps: vec![],
+        inputs: vec![],
+    };
+    let mut produced = FxHashSet::default();
+    let mut inputs = FxHashSet::default();
+    let mut consumed = FxHashSet::default();
+    for (offset, stmt) in statements[start..start + count].iter().enumerate() {
+        let (dest, op, lhs, rhs, inplace) = dynamic_step(stmt)?;
+        let op = match op {
+            DynOp::Add => BinOp::Add,
+            DynOp::Sub => BinOp::Sub,
+            DynOp::Mul => BinOp::Mul,
+            _ => return None,
+        };
+        if inplace && (offset + 1 != count || !matches!(op, BinOp::Add | BinOp::Sub)) {
+            return None;
+        }
+        let (Operand::Local(lhs), Operand::Local(rhs)) = (lhs, rhs) else {
+            return None;
+        };
+        for operand in [*lhs, *rhs] {
+            if function.body.locals[operand].ty != MirType::Dynamic {
+                return None;
+            }
+            if destinations.contains(&operand) {
+                // 自写/前向读取不能当作已生成中间量，也不能降级成外部输入。
+                if !produced.contains(&operand) {
+                    return None;
+                }
+                consumed.insert(operand);
+            } else if inputs.insert(operand) {
+                plan.inputs.push(operand);
+            }
+        }
+        plan.steps.push(Step {
+            dest,
+            op,
+            lhs: *lhs,
+            rhs: *rhs,
+        });
+        produced.insert(dest);
+    }
+    if plan.inputs.len() > MAX_INPUTS || plan.inputs.is_empty() {
+        return None;
+    }
+    let intermediate: FxHashSet<_> = plan
+        .steps
+        .iter()
+        .take(count - 1)
+        .map(|step| step.dest)
+        .collect();
+    // 不删除独立、无消费者的算术；首切只接受每个中间值都真正流向链内后续操作。
+    if !intermediate.iter().all(|local| consumed.contains(local)) {
+        return None;
+    }
+    for (id, body) in function.body.blocks.iter() {
+        if !terminator_reads(&body.terminator).is_disjoint(&intermediate) {
+            return None;
+        }
+        for (index, statement) in body.stmts.iter().enumerate() {
+            if id == block && (start..start + count).contains(&index) {
+                continue;
+            }
+            if !statement_reads(statement).is_disjoint(&intermediate) {
+                return None;
+            }
+        }
+    }
+    Some(plan)
+}
+fn statement_reads(statement: &Statement) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match statement {
+        Statement::Assign { value, .. } | Statement::Eval(value) => read_value(value, &mut reads),
+        Statement::SetField { obj, value, .. } => {
+            read_operand(obj, &mut reads);
+            read_operand(value, &mut reads);
+        }
+        Statement::SetGlobal { value, .. } => read_operand(value, &mut reads),
+        Statement::Line(_) => {}
+    }
+    reads
+}
+fn terminator_reads(terminator: &Terminator) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match terminator {
+        Terminator::Branch { cond, .. } => read_operand(cond, &mut reads),
+        Terminator::Suspend { value, input, .. } => {
+            read_operand(value, &mut reads);
+            if let Some(input) = input {
+                reads.insert(*input);
+            }
+        }
+        Terminator::Return(value) => {
+            if let Some(value) = value {
+                read_operand(value, &mut reads);
+            }
+        }
+        Terminator::Raise { value, cause } => {
+            for operand in value.iter().chain(cause.iter()) {
+                read_operand(operand, &mut reads);
+            }
+        }
+        Terminator::Goto(_) | Terminator::Unreachable => {}
+    }
+    reads
+}
diff --git a/crates/ryupy-mir/src/passes/float_chain_expand.rs b/crates/ryupy-mir/src/passes/float_chain_expand.rs
new file mode 100644
index 0000000..21be230
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_chain_expand.rs
@@ -0,0 +1,96 @@
+//! 将已证明无观察的浮点链展开成精确类型守卫、原生计算与原动态慢路。
+//!
+//! 输入只冻结引用，失败路径搬移原语句而非重新求值；快路保持每次 F64 运算与舍入顺序，
+//! 不重结合、不使用 FMA，只有最终结果装箱。普通对象仍按原 DynBinary 协议执行。
+use super::float_chain::Plan;
+use crate::mir::*;
+use rustc_hash::FxHashMap;
+
+pub(super) fn expand(function: &mut Function, plan: Plan) {
+    let Some(final_dest) = plan.steps.last().map(|step| step.dest) else {
+        return;
+    };
+    let tail = function.body.blocks[plan.block]
+        .stmts
+        .split_off(plan.start + plan.steps.len());
+    let original = function.body.blocks[plan.block].stmts.split_off(plan.start);
+    let next = std::mem::replace(
+        &mut function.body.blocks[plan.block].terminator,
+        Terminator::Unreachable,
+    );
+    let continuation = block(function, tail, next);
+    let fallback = block(function, original, Terminator::Goto(continuation));
+    let mut raw = FxHashMap::default();
+    let mut frozen = Vec::new();
+    let mut fast = Vec::new();
+    for input in &plan.inputs {
+        let snapshot = local(function, MirType::Dynamic);
+        function.body.blocks[plan.block]
+            .stmts
+            .push(assign(snapshot, Rvalue::Use(get(*input))));
+        let value = local(function, MirType::F64);
+        fast.push(assign(
+            value,
+            Rvalue::UnboxExactF64 {
+                value: get(snapshot),
+            },
+        ));
+        raw.insert(*input, value);
+        frozen.push(snapshot);
+    }
+    for step in &plan.steps {
+        let result = local(function, MirType::F64);
+        fast.push(assign(
+            result,
+            Rvalue::Binary {
+                op: step.op,
+                lhs: get(raw[&step.lhs]),
+                rhs: get(raw[&step.rhs]),
+            },
+        ));
+        raw.insert(step.dest, result);
+    }
+    fast.push(assign(
+        final_dest,
+        Rvalue::Box {
+            value: get(raw[&final_dest]),
+            from: MirType::F64,
+        },
+    ));
+    let mut success = block(function, fast, Terminator::Goto(continuation));
+    // 每个 exact unbox 均由所有输入的真分支支配；不靠运行时转换或静态注解冒充证明。
+    for snapshot in frozen.into_iter().rev() {
+        let condition = local(function, MirType::Bool);
+        success = block(
+            function,
+            vec![assign(
+                condition,
+                Rvalue::IsBoxedF64 {
+                    value: get(snapshot),
+                },
+            )],
+            Terminator::Branch {
+                cond: get(condition),
+                then_: success,
+                else_: fallback,
+            },
+        );
+    }
+    function.body.blocks[plan.block].terminator = Terminator::Goto(success);
+}
+fn local(function: &mut Function, ty: MirType) -> LocalId {
+    function.body.locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn block(function: &mut Function, stmts: Vec<Statement>, terminator: Terminator) -> BlockId {
+    function.body.blocks.alloc(BasicBlock { stmts, terminator })
+}
+fn assign(dest: LocalId, value: Rvalue) -> Statement {
+    Statement::Assign { dest, value }
+}
+fn get(local: LocalId) -> Operand {
+    Operand::Local(local)
+}
diff --git a/crates/ryupy-mir/src/passes/float_chain_tests.rs b/crates/ryupy-mir/src/passes/float_chain_tests.rs
new file mode 100644
index 0000000..21ff703
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_chain_tests.rs
@@ -0,0 +1,270 @@
+//! 浮点链只在精确守卫成功时消除中间盒；逃逸、别名与协议边界保留动态路径。
+use super::MirPass;
+use super::float_chain::FloatChain;
+use crate::mir::*;
+use la_arena::{Arena, RawIdx};
+
+fn local(locals: &mut Arena<LocalDecl>) -> LocalId {
+    locals.alloc(LocalDecl {
+        ty: MirType::Dynamic,
+        name: None,
+        is_cell: false,
+    })
+}
+fn operation(dest: LocalId, op: DynOp, lhs: LocalId, rhs: LocalId, inplace: bool) -> Statement {
+    Statement::Assign {
+        dest,
+        value: Rvalue::DynBinary {
+            op,
+            lhs: Operand::Local(lhs),
+            rhs: Operand::Local(rhs),
+            inplace,
+        },
+    }
+}
+fn sample() -> (Function, [LocalId; 5]) {
+    let mut locals = Arena::default();
+    let a = local(&mut locals);
+    let b = local(&mut locals);
+    let c = local(&mut locals);
+    let middle = local(&mut locals);
+    let result = local(&mut locals);
+    let mut blocks = Arena::default();
+    let entry = blocks.alloc(BasicBlock {
+        stmts: vec![
+            operation(middle, DynOp::Mul, a, b, false),
+            operation(result, DynOp::Add, middle, c, true),
+        ],
+        terminator: Terminator::Return(Some(Operand::Local(result))),
+    });
+    (
+        Function {
+            name: "float_chain".into(),
+            codegen_name: "float_chain".into(),
+            source_file: "float_chain.py".into(),
+            params: vec![a, b, c],
+            ret: MirType::Dynamic,
+            body: Body {
+                locals,
+                blocks,
+                entry,
+                regions: vec![],
+            },
+            param_meta: vec![],
+            function_global: None,
+            defaults_global: None,
+            specialization_identity_global: None,
+            signature_global: Some(GlobalId::from_raw(RawIdx::from(0))),
+            env: None,
+        },
+        [a, b, c, middle, result],
+    )
+}
+fn count(f: &Function, predicate: impl Fn(&Rvalue) -> bool) -> usize {
+    f.body
+        .blocks
+        .iter()
+        .flat_map(|(_, block)| &block.stmts)
+        .filter(|stmt| match stmt {
+            Statement::Assign { value, .. } | Statement::Eval(value) => predicate(value),
+            _ => false,
+        })
+        .count()
+}
+#[test]
+fn guarded_chain_keeps_original_fallback_and_boxes_only_final_fast_result() {
+    let (mut f, [a, b, c, _, _]) = sample();
+    FloatChain.run(&mut f);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 3);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::UnboxExactF64 { .. })), 3);
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Binary {
+                op: BinOp::Mul | BinOp::Add,
+                ..
+            }
+        )),
+        2
+    );
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Box {
+                from: MirType::F64,
+                ..
+            }
+        )),
+        1
+    );
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::DynBinary { .. })), 2);
+    let snapshots = &f.body.blocks[f.body.entry].stmts;
+    for (stmt, input) in snapshots.iter().take(3).zip([a, b, c]) {
+        assert!(
+            matches!(stmt, Statement::Assign { value: Rvalue::Use(Operand::Local(source)), .. } if *source == input)
+        );
+    }
+}
+#[test]
+fn escaping_middle_and_redefined_or_aliased_destinations_reject_chain() {
+    for case in 0..5 {
+        let (mut f, [a, _, c, middle, result]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => f.body.blocks[entry].terminator = Terminator::Return(Some(Operand::Local(middle))),
+            1 => f.body.locals[middle].name = Some("observed".into()),
+            2 => f.body.blocks[entry].stmts.push(Statement::Assign {
+                dest: result,
+                value: Rvalue::Use(Operand::Local(a)),
+            }),
+            3 => f.body.blocks[entry].stmts[1] = operation(c, DynOp::Add, middle, c, true),
+            _ => f.body.blocks[entry]
+                .stmts
+                .push(Statement::Eval(Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeTuple,
+                    prefix: vec![],
+                    args: vec![Operand::Array(vec![Operand::Local(middle)])],
+                })),
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(
+            count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })),
+            0,
+            "case {case}"
+        );
+    }
+}
+#[test]
+fn callbacks_lines_copies_and_cross_block_chains_are_not_fused() {
+    for case in 0..4 {
+        let (mut f, [a, _, _, _, result]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => f.body.blocks[entry].stmts.insert(1, Statement::Line(10)),
+            1 => f.body.blocks[entry].stmts.insert(
+                1,
+                Statement::Assign {
+                    dest: result,
+                    value: Rvalue::Use(Operand::Local(a)),
+                },
+            ),
+            2 => f.body.blocks[entry].stmts.insert(
+                1,
+                Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![Operand::Local(a)],
+                }),
+            ),
+            _ => {
+                let last = f.body.blocks[entry].stmts.pop().unwrap();
+                let next = f.body.blocks.alloc(BasicBlock {
+                    stmts: vec![last],
+                    terminator: Terminator::Return(Some(Operand::Local(result))),
+                });
+                f.body.blocks[entry].terminator = Terminator::Goto(next);
+            }
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 0);
+    }
+}
+#[test]
+fn exception_closure_cell_generator_and_intermediate_inplace_are_rejected() {
+    for case in 0..6 {
+        let (mut f, [a, b, _, middle, _]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => f.env = Some(a),
+            1 => f.body.locals[a].is_cell = true,
+            2 => f.signature_global = None,
+            3 => f.body.regions.push(Region {
+                kind: RegionKind::CatchAll,
+                try_start: entry,
+                try_len: 1,
+                handler: entry,
+                exc_local: None,
+            }),
+            4 => {
+                f.body.blocks[entry].terminator = Terminator::Suspend {
+                    value: Operand::Local(a),
+                    resume: entry,
+                    input: None,
+                    delegated: false,
+                }
+            }
+            _ => f.body.blocks[entry].stmts[0] = operation(middle, DynOp::Mul, a, b, true),
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 0);
+    }
+}
+#[test]
+fn failed_candidates_consume_attempt_budget() {
+    let (mut f, [a, b, c, _, _]) = sample();
+    let entry = f.body.entry;
+    f.body.blocks[entry].stmts.clear();
+    for index in 0..17 {
+        let middle = local(&mut f.body.locals);
+        let result = local(&mut f.body.locals);
+        if index < 16 {
+            f.body.locals[middle].name = Some("escape".into());
+        }
+        f.body.blocks[entry].stmts.extend([
+            operation(middle, DynOp::Mul, a, b, false),
+            operation(result, DynOp::Add, middle, c, true),
+            Statement::Line(index),
+        ]);
+    }
+    FloatChain.run(&mut f);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 0);
+}
+
+#[test]
+fn chain_input_and_function_size_budgets_preserve_original_operations() {
+    for case in 0..4 {
+        let (mut f, [a, b, _, middle, result]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 | 1 => {
+                f.body.blocks[entry].stmts.clear();
+                let count = if case == 0 { 9 } else { 8 };
+                let mut previous = a;
+                for _ in 0..count {
+                    let input = if case == 1 {
+                        local(&mut f.body.locals)
+                    } else {
+                        b
+                    };
+                    let dest = local(&mut f.body.locals);
+                    f.body.blocks[entry].stmts.push(operation(
+                        dest,
+                        DynOp::Add,
+                        previous,
+                        input,
+                        false,
+                    ));
+                    previous = dest;
+                }
+                f.body.blocks[entry].terminator =
+                    Terminator::Return(Some(Operand::Local(previous)));
+            }
+            2 => {
+                for _ in 0..512 {
+                    local(&mut f.body.locals);
+                }
+            }
+            _ => {
+                f.body.blocks[entry].stmts = vec![
+                    operation(middle, DynOp::Mul, a, b, false),
+                    operation(result, DynOp::Mul, middle, b, true),
+                ];
+            }
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(
+            count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })),
+            0,
+            "预算/末条操作限制 {case}"
+        );
+    }
+}
