+//! 浮点链只在精确守卫成功时消除中间盒；逃逸、别名与协议边界保留动态路径。
+use super::MirPass;
+use super::float_chain::FloatChain;
+use crate::mir::*;
+use la_arena::{Arena, RawIdx};
+
+fn local(locals: &mut Arena<LocalDecl>) -> LocalId {
+    locals.alloc(LocalDecl {
+        ty: MirType::Dynamic,
+        name: None,
+        is_cell: false,
+    })
+}
+fn operation(dest: LocalId, op: DynOp, lhs: LocalId, rhs: LocalId, inplace: bool) -> Statement {
+    Statement::Assign {
+        dest,
+        value: Rvalue::DynBinary {
+            op,
+            lhs: Operand::Local(lhs),
+            rhs: Operand::Local(rhs),
+            inplace,
+        },
+    }
+}
+fn sample() -> (Function, [LocalId; 5]) {
+    let mut locals = Arena::default();
+    let a = local(&mut locals);
+    let b = local(&mut locals);
+    let c = local(&mut locals);
+    let middle = local(&mut locals);
+    let result = local(&mut locals);
+    let mut blocks = Arena::default();
+    let entry = blocks.alloc(BasicBlock {
+        stmts: vec![
+            operation(middle, DynOp::Mul, a, b, false),
+            operation(result, DynOp::Add, middle, c, true),
+        ],
+        terminator: Terminator::Return(Some(Operand::Local(result))),
+    });
+    (
+        Function {
+            name: "float_chain".into(),
+            codegen_name: "float_chain".into(),
+            source_file: "float_chain.py".into(),
+            params: vec![a, b, c],
+            ret: MirType::Dynamic,
+            body: Body {
+                locals,
+                blocks,
+                entry,
+                regions: vec![],
+            },
+            param_meta: vec![],
+            function_global: None,
+            defaults_global: None,
+            specialization_identity_global: None,
+            signature_global: Some(GlobalId::from_raw(RawIdx::from(0))),
+            env: None,
+        },
+        [a, b, c, middle, result],
+    )
+}
+fn count(f: &Function, predicate: impl Fn(&Rvalue) -> bool) -> usize {
+    f.body
+        .blocks
+        .iter()
+        .flat_map(|(_, block)| &block.stmts)
+        .filter(|stmt| match stmt {
+            Statement::Assign { value, .. } | Statement::Eval(value) => predicate(value),
+            _ => false,
+        })
+        .count()
+}
+#[test]
+fn guarded_chain_keeps_original_fallback_and_boxes_only_final_fast_result() {
+    let (mut f, [a, b, c, _, _]) = sample();
+    FloatChain.run(&mut f);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 3);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::UnboxExactF64 { .. })), 3);
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Binary {
+                op: BinOp::Mul | BinOp::Add,
+                ..
+            }
+        )),
+        2
+    );
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Box {
+                from: MirType::F64,
+                ..
+            }
+        )),
+        1
+    );
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::DynBinary { .. })), 2);
+    let snapshots = &f.body.blocks[f.body.entry].stmts;
+    for (stmt, input) in snapshots.iter().take(3).zip([a, b, c]) {
+        assert!(
+            matches!(stmt, Statement::Assign { value: Rvalue::Use(Operand::Local(source)), .. } if *source == input)
+        );
+    }
+}
+#[test]
+fn escaping_middle_and_redefined_or_aliased_destinations_reject_chain() {
+    for case in 0..5 {
+        let (mut f, [a, _, c, middle, result]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => f.body.blocks[entry].terminator = Terminator::Return(Some(Operand::Local(middle))),
+            1 => f.body.locals[middle].name = Some("observed".into()),
+            2 => f.body.blocks[entry].stmts.push(Statement::Assign {
+                dest: result,
+                value: Rvalue::Use(Operand::Local(a)),
+            }),
+            3 => f.body.blocks[entry].stmts[1] = operation(c, DynOp::Add, middle, c, true),
+            _ => f.body.blocks[entry]
+                .stmts
+                .push(Statement::Eval(Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeTuple,
+                    prefix: vec![],
+                    args: vec![Operand::Array(vec![Operand::Local(middle)])],
+                })),
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(
+            count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })),
+            0,
+            "case {case}"
+        );
+    }
+}
+#[test]
+fn callbacks_lines_copies_and_cross_block_chains_are_not_fused() {
+    for case in 0..4 {
+        let (mut f, [a, _, _, _, result]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => f.body.blocks[entry].stmts.insert(1, Statement::Line(10)),
+            1 => f.body.blocks[entry].stmts.insert(
+                1,
+                Statement::Assign {
+                    dest: result,
+                    value: Rvalue::Use(Operand::Local(a)),
+                },
+            ),
+            2 => f.body.blocks[entry].stmts.insert(
+                1,
+                Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![Operand::Local(a)],
+                }),
+            ),
+            _ => {
+                let last = f.body.blocks[entry].stmts.pop().unwrap();
+                let next = f.body.blocks.alloc(BasicBlock {
+                    stmts: vec![last],
+                    terminator: Terminator::Return(Some(Operand::Local(result))),
+                });
+                f.body.blocks[entry].terminator = Terminator::Goto(next);
+            }
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 0);
+    }
+}
+#[test]
+fn exception_closure_cell_generator_and_intermediate_inplace_are_rejected() {
+    for case in 0..6 {
+        let (mut f, [a, b, _, middle, _]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => f.env = Some(a),
+            1 => f.body.locals[a].is_cell = true,
+            2 => f.signature_global = None,
+            3 => f.body.regions.push(Region {
+                kind: RegionKind::CatchAll,
+                try_start: entry,
+                try_len: 1,
+                handler: entry,
+                exc_local: None,
+            }),
+            4 => {
+                f.body.blocks[entry].terminator = Terminator::Suspend {
+                    value: Operand::Local(a),
+                    resume: entry,
+                    input: None,
+                    delegated: false,
+                }
+            }
+            _ => f.body.blocks[entry].stmts[0] = operation(middle, DynOp::Mul, a, b, true),
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 0);
+    }
+}
+#[test]
+fn failed_candidates_consume_attempt_budget() {
+    let (mut f, [a, b, c, _, _]) = sample();
+    let entry = f.body.entry;
+    f.body.blocks[entry].stmts.clear();
+    for index in 0..17 {
+        let middle = local(&mut f.body.locals);
+        let result = local(&mut f.body.locals);
+        if index < 16 {
+            f.body.locals[middle].name = Some("escape".into());
+        }
+        f.body.blocks[entry].stmts.extend([
+            operation(middle, DynOp::Mul, a, b, false),
+            operation(result, DynOp::Add, middle, c, true),
+            Statement::Line(index),
+        ]);
+    }
+    FloatChain.run(&mut f);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 0);
+}
+
+#[test]
+fn chain_input_and_function_size_budgets_preserve_original_operations() {
+    for case in 0..4 {
+        let (mut f, [a, b, _, middle, result]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 | 1 => {
+                f.body.blocks[entry].stmts.clear();
+                let count = if case == 0 { 9 } else { 8 };
+                let mut previous = a;
+                for _ in 0..count {
+                    let input = if case == 1 {
+                        local(&mut f.body.locals)
+                    } else {
+                        b
+                    };
+                    let dest = local(&mut f.body.locals);
+                    f.body.blocks[entry].stmts.push(operation(
+                        dest,
+                        DynOp::Add,
+                        previous,
+                        input,
+                        false,
+                    ));
+                    previous = dest;
+                }
+                f.body.blocks[entry].terminator =
+                    Terminator::Return(Some(Operand::Local(previous)));
+            }
+            2 => {
+                for _ in 0..512 {
+                    local(&mut f.body.locals);
+                }
+            }
+            _ => {
+                f.body.blocks[entry].stmts = vec![
+                    operation(middle, DynOp::Mul, a, b, false),
+                    operation(result, DynOp::Mul, middle, b, true),
+                ];
+            }
+        }
+        FloatChain.run(&mut f);
+        assert_eq!(
+            count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })),
+            0,
+            "预算/末条操作限制 {case}"
+        );
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/float_loop.rs b/crates/ryupy-mir/src/passes/float_loop.rs
new file mode 100644
index 0000000..f70718c
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_loop.rs
@@ -0,0 +1,239 @@
+//! 浮点链的循环状态策略：只接受唯一入口/出口的五块循环与本次入口的精确浮点重置。
+//!
+//! 共用 FloatChain 的候选、逃逸检查及尝试预算；此处再证明累加槽不可在循环中观察。
+//! 外层可重入 preheader，但每次必须先重新赋初值；不猜用户类型，不改变旧整数 holder。
+use super::dead_values::{read_operand, read_value};
+use super::float_chain::Plan as Chain;
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+pub(super) struct Plan {
+    pub(super) preheader: BlockId,
+    pub(super) header: BlockId,
+    pub(super) exit: BlockId,
+    pub(super) total: LocalId,
+}
+
+pub(super) fn try_expand(function: &mut Function, chain: &Chain) -> bool {
+    let Some(plan) = candidate(function, chain) else {
+        return false;
+    };
+    let mut island = super::numeric_list::candidate(function, chain, &plan);
+    let inputs = chain.inputs.len() - 1;
+    // 岛预算不够只退回原FloatLoop，不能先改工厂再放弃load/sink任一端。
+    if let Some(numeric) = &island
+        && (function.body.locals.len()
+            + 4
+            + 3 * inputs
+            + chain.steps.len()
+            + numeric.extra_locals()
+            > 512
+            || function.body.blocks.len() + inputs + 10 + numeric.extra_blocks() > 128)
+    {
+        island = None;
+    }
+    // 状态四槽；其余每输入三个槽，每步一个原生结果。慢路/出口/初始化共新增九块；岛额外分离输入拆箱与算术块。
+    if function.body.locals.len() + 4 + 3 * inputs + chain.steps.len() > 512
+        || function.body.blocks.len() + inputs + 9 > 128
+    {
+        return false;
+    }
+    super::float_loop_expand::expand(function, chain, plan, island);
+    true
+}
+fn candidate(function: &Function, chain: &Chain) -> Option<Plan> {
+    let body = chain.block;
+    let predecessor = super::numeric_accumulator_match::predecessors(function);
+    let [header] = predecessor.get(&body)?.as_slice() else {
+        return None;
+    };
+    let header = *header;
+    let Terminator::Branch {
+        then_, else_: exit, ..
+    } = function.body.blocks[header].terminator
+    else {
+        return None;
+    };
+    if then_ != body {
+        return None;
+    }
+    let Terminator::Goto(latch) = function.body.blocks[body].terminator else {
+        return None;
+    };
+    if !matches!(function.body.blocks[latch].terminator, Terminator::Goto(target) if target == header)
+        || predecessor.get(&latch)?.as_slice() != [body]
+        || predecessor.get(&exit)?.as_slice() != [header]
+    {
+        return None;
+    }
+    let incoming = predecessor.get(&header)?;
+    if incoming.len() != 2 || !incoming.contains(&latch) {
+        return None;
+    }
+    let preheader = *incoming.iter().find(|&&source| source != latch)?;
+    if !matches!(function.body.blocks[preheader].terminator, Terminator::Goto(target) if target == header)
+        || [preheader, header, body, latch, exit]
+            .into_iter()
+            .collect::<FxHashSet<_>>()
+            .len()
+            != 5
+        || [header, body, latch, exit].contains(&function.body.entry)
+    {
+        return None;
+    }
+    let last_position = chain.start + chain.steps.len() - 1;
+    let Statement::Assign {
+        dest: temporary,
+        value:
+            Rvalue::DynBinary {
+                op: DynOp::Add | DynOp::Sub,
+                lhs: Operand::Local(total),
+                inplace: true,
+                ..
+            },
+    } = &function.body.blocks[body].stmts[last_position]
+    else {
+        return None;
+    };
+    let temporary = *temporary;
+    let total = *total;
+    if !chain.inputs.contains(&total)
+        || function.params.contains(&total)
+        || function.body.locals[total].ty != MirType::Dynamic
+        || !matches!(function.body.blocks[body].stmts.get(last_position + 1),
+            Some(Statement::Assign { dest, value: Rvalue::Use(Operand::Local(source)) }) if *dest == total && *source == temporary)
+    {
+        return None;
+    }
+    // s 在链内只能是末条 lhs；其它读取即使没有逃逸，也会要求观察当前盒。
+    if chain.steps[..chain.steps.len() - 1]
+        .iter()
+        .any(|step| step.lhs == total || step.rhs == total)
+        || chain.steps.last()?.rhs == total
+    {
+        return None;
+    }
+    let mut writes = Vec::new();
+    let mut temporary_reads = 0;
+    for (id, block) in function.body.blocks.iter() {
+        let reads = terminator_reads(&block.terminator);
+        if reads.contains(&temporary)
+            || ([header, body, latch].contains(&id) && reads.contains(&total))
+        {
+            return None;
+        }
+        for (position, statement) in block.stmts.iter().enumerate() {
+            let reads = statement_reads(statement);
+            if reads.contains(&temporary) {
+                if id != body || position != last_position + 1 {
+                    return None;
+                }
+                temporary_reads += 1;
+            }
+            if [header, body, latch].contains(&id)
+                && reads.contains(&total)
+                && (id != body || position != last_position)
+            {
+                return None;
+            }
+            if let Statement::Assign { dest, .. } = statement
+                && *dest == total
+            {
+                writes.push((id, position));
+            }
+        }
+    }
+    if temporary_reads != 1 || writes.len() != 2 || !writes.contains(&(body, last_position + 1)) {
+        return None;
+    }
+    let reset = writes.iter().find(|(id, _)| *id == preheader)?.1;
+    if !initial_float(function, preheader, reset, total) {
+        return None;
+    }
+    Some(Plan {
+        preheader,
+        header,
+        exit,
+        total,
+    })
+}
+
+fn initial_float(function: &Function, block: BlockId, reset: usize, total: LocalId) -> bool {
+    // 一次建全函数定义表；沿最多16层同pre块、严格向前的只读Use链寻找BoxF64。
+    let mut definitions: FxHashMap<LocalId, Vec<(BlockId, usize)>> = FxHashMap::default();
+    for (id, body) in function.body.blocks.iter() {
+        for (position, stmt) in body.stmts.iter().enumerate() {
+            if let Statement::Assign { dest, .. } = stmt {
+                definitions.entry(*dest).or_default().push((id, position));
+            }
+        }
+    }
+    let mut current = reset;
+    for _ in 0..16 {
+        match &function.body.blocks[block].stmts[current] {
+            Statement::Assign {
+                value: Rvalue::Box {
+                    from: MirType::F64, ..
+                },
+                ..
+            } => return true,
+            Statement::Assign {
+                value: Rvalue::Use(Operand::Local(source)),
+                ..
+            } => {
+                if *source == total || function.params.contains(source) {
+                    return false;
+                }
+                let Some(positions) = definitions.get(source) else {
+                    return false;
+                };
+                let [(id, position)] = positions.as_slice() else {
+                    return false;
+                };
+                if *id != block || *position >= current {
+                    return false;
+                }
+                current = *position;
+            }
+            _ => return false,
+        }
+    }
+    false
+}
+fn statement_reads(statement: &Statement) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match statement {
+        Statement::Assign { value, .. } | Statement::Eval(value) => read_value(value, &mut reads),
+        Statement::SetField { obj, value, .. } => {
+            read_operand(obj, &mut reads);
+            read_operand(value, &mut reads);
+        }
+        Statement::SetGlobal { value, .. } => read_operand(value, &mut reads),
+        Statement::Line(_) => {}
+    }
+    reads
+}
+fn terminator_reads(terminator: &Terminator) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match terminator {
+        Terminator::Branch { cond, .. } => read_operand(cond, &mut reads),
+        Terminator::Suspend { value, input, .. } => {
+            read_operand(value, &mut reads);
+            if let Some(input) = input {
+                reads.insert(*input);
+            }
+        }
+        Terminator::Return(value) => {
+            if let Some(value) = value {
+                read_operand(value, &mut reads);
+            }
+        }
+        Terminator::Raise { value, cause } => {
+            for value in value.iter().chain(cause.iter()) {
+                read_operand(value, &mut reads);
+            }
+        }
+        Terminator::Goto(_) | Terminator::Unreachable => {}
+    }
+    reads
+}
