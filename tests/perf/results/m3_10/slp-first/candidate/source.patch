@@ -0,0 +1,122 @@
+//! 数值列表岛的局部分析工具：穷尽读取扫描与有限CFG支配关系，不引入全程序SSA。
+use super::dead_values::{read_operand, read_value};
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+pub(super) type Definitions = FxHashMap<LocalId, Vec<(BlockId, usize)>>;
+pub(super) fn definitions(f: &Function) -> Definitions {
+    let mut result = Definitions::default();
+    for (id, body) in f.body.blocks.iter() {
+        for (position, stmt) in body.stmts.iter().enumerate() {
+            if let Statement::Assign { dest, .. } = stmt {
+                result.entry(*dest).or_default().push((id, position));
+            }
+        }
+    }
+    result
+}
+pub(super) fn reads(statement: &Statement) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match statement {
+        Statement::Assign { value, .. } | Statement::Eval(value) => read_value(value, &mut reads),
+        Statement::SetField { obj, value, .. } => {
+            read_operand(obj, &mut reads);
+            read_operand(value, &mut reads);
+        }
+        Statement::SetGlobal { value, .. } => read_operand(value, &mut reads),
+        Statement::Line(_) => {}
+    }
+    reads
+}
+pub(super) fn terminator_reads(terminator: &Terminator) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match terminator {
+        Terminator::Branch { cond, .. } => read_operand(cond, &mut reads),
+        Terminator::Suspend { value, input, .. } => {
+            read_operand(value, &mut reads);
+            if let Some(input) = input {
+                reads.insert(*input);
+            }
+        }
+        Terminator::Return(value) => {
+            if let Some(value) = value {
+                read_operand(value, &mut reads);
+            }
+        }
+        Terminator::Raise { value, cause } => {
+            for operand in value.iter().chain(cause.iter()) {
+                read_operand(operand, &mut reads);
+            }
+        }
+        Terminator::Goto(_) | Terminator::Unreachable => {}
+    }
+    reads
+}
+pub(super) fn dominators(f: &Function) -> FxHashMap<BlockId, FxHashSet<BlockId>> {
+    let predecessors = super::numeric_accumulator_match::predecessors(f);
+    // 先取可达集合；不可达源不能凭空证明动态局部已初始化。
+    let mut reachable = FxHashSet::default();
+    let mut pending = vec![f.body.entry];
+    while let Some(id) = pending.pop() {
+        if !reachable.insert(id) {
+            continue;
+        }
+        match &f.body.blocks[id].terminator {
+            Terminator::Goto(target) => pending.push(*target),
+            Terminator::Branch { then_, else_, .. } => pending.extend([*then_, *else_]),
+            _ => {}
+        }
+    }
+    let mut result: FxHashMap<_, _> = reachable
+        .iter()
+        .map(|id| {
+            (
+                *id,
+                if *id == f.body.entry {
+                    FxHashSet::from_iter([*id])
+                } else {
+                    reachable.clone()
+                },
+            )
+        })
+        .collect();
+    // 至多128块，集合严格单调收缩；有限交集迭代不依赖Python运行时数据。
+    loop {
+        let mut changed = false;
+        for &id in &reachable {
+            if id == f.body.entry {
+                continue;
+            }
+            let mut incoming = predecessors[&id]
+                .iter()
+                .filter(|source| reachable.contains(source));
+            let mut next = incoming
+                .next()
+                .map(|source| result[source].clone())
+                .unwrap_or_default();
+            for source in incoming {
+                next.retain(|item| result[source].contains(item));
+            }
+            next.insert(id);
+            if next != result[&id] {
+                result.insert(id, next);
+                changed = true;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    result
+}
+pub(super) fn dominates(
+    dom: &FxHashMap<BlockId, FxHashSet<BlockId>>,
+    definition: (BlockId, usize),
+    usage: (BlockId, usize),
+) -> bool {
+    if definition.0 == usage.0 {
+        definition.1 < usage.1 && dom.contains_key(&usage.0)
+    } else {
+        dom.get(&usage.0)
+            .is_some_and(|set| set.contains(&definition.0))
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/numeric_list_expand.rs b/crates/ryupy-mir/src/passes/numeric_list_expand.rs
new file mode 100644
index 0000000..9f6a0fd
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/numeric_list_expand.rs
@@ -0,0 +1,139 @@
+//! 数值列表岛的机械MIR展开：无副作用预检先行，失败回到原GetItem序列且仅执行一次。
+//! typed读取与旧boxed读取汇入同一原生算术块；出口仅dirty值绕过原append物化。
+use super::numeric_list::Plan;
+use crate::mir::*;
+use rustc_hash::FxHashMap;
+
+pub(super) struct ReadTargets<'a> {
+    pub(super) mode: LocalId,
+    pub(super) ordinary_guards: BlockId,
+    pub(super) dynamic: BlockId,
+    pub(super) arithmetic: BlockId,
+    pub(super) raw: &'a FxHashMap<LocalId, LocalId>,
+}
+pub(super) fn rewrite_factory(f: &mut Function, plan: &Plan) {
+    if let Statement::Assign { value, .. } =
+        &mut f.body.blocks[plan.factory.0].stmts[plan.factory.1]
+    {
+        *value = Rvalue::Call {
+            callee: Callee::Runtime(RuntimeFn::NumericListCreate),
+            args: vec![],
+        };
+    }
+}
+pub(super) fn read_path(
+    f: &mut Function,
+    plan: &Plan,
+    mut original: Vec<Statement>,
+    boxed_inputs: Vec<Statement>,
+    targets: ReadTargets<'_>,
+) -> Terminator {
+    original.extend(boxed_inputs);
+    let original_path = block(
+        f,
+        original,
+        branch(targets.mode, targets.ordinary_guards, targets.dynamic),
+    );
+    let mut children = FxHashMap::default();
+    let mut guards = Vec::new();
+    let mut typed = Vec::new();
+    for load in &plan.loads {
+        let root = children.get(&load.root).copied().unwrap_or(load.root);
+        let condition = local(f, MirType::Bool);
+        let statements = if load.child {
+            let child = local(f, MirType::Dynamic);
+            children.insert(load.dest, child);
+            vec![
+                call(
+                    child,
+                    RuntimeFn::NumericListPeekList,
+                    vec![get(root), get(load.key)],
+                ),
+                assign(
+                    condition,
+                    Rvalue::Binary {
+                        op: BinOp::Ne,
+                        lhs: get(child),
+                        rhs: Operand::Const(Constant::Null),
+                    },
+                ),
+            ]
+        } else {
+            typed.push(call(
+                targets.raw[&load.dest],
+                RuntimeFn::NumericListReadF64,
+                vec![get(root), get(load.key)],
+            ));
+            vec![call(
+                condition,
+                RuntimeFn::NumericListCanReadF64,
+                vec![get(root), get(load.key)],
+            )]
+        };
+        guards.push((condition, statements));
+    }
+    let mut success = block(f, typed, Terminator::Goto(targets.arithmetic));
+    for (condition, statements) in guards.into_iter().rev() {
+        success = block(f, statements, branch(condition, success, original_path));
+    }
+    branch(targets.mode, success, original_path)
+}
+
+pub(super) fn exit_paths(
+    f: &mut Function,
+    plan: &Plan,
+    raw_total: LocalId,
+    mut statements: Vec<Statement>,
+    terminator: Terminator,
+) -> (BlockId, BlockId) {
+    let tail = statements.split_off(plan.sink_position + 1);
+    let after = block(f, tail, terminator);
+    // clean路径完整保留原Line/append（共享盒和零轮初值）；dirty路径仅替换这一条调用。
+    let mut typed: Vec<_> = statements[..plan.sink_position]
+        .iter()
+        .filter_map(|stmt| match stmt {
+            Statement::Line(line) => Some(Statement::Line(*line)),
+            _ => None,
+        })
+        .collect();
+    typed.push(call(
+        plan.sink_dest,
+        RuntimeFn::NumericListAppendF64,
+        vec![get(plan.receiver), get(raw_total)],
+    ));
+    let ordinary = block(f, statements, Terminator::Goto(after));
+    let numeric = block(f, typed, Terminator::Goto(after));
+    (ordinary, numeric)
+}
+fn local(f: &mut Function, ty: MirType) -> LocalId {
+    f.body.locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn block(f: &mut Function, stmts: Vec<Statement>, terminator: Terminator) -> BlockId {
+    f.body.blocks.alloc(BasicBlock { stmts, terminator })
+}
+fn assign(dest: LocalId, value: Rvalue) -> Statement {
+    Statement::Assign { dest, value }
+}
+fn call(dest: LocalId, callee: RuntimeFn, args: Vec<Operand>) -> Statement {
+    assign(
+        dest,
+        Rvalue::Call {
+            callee: Callee::Runtime(callee),
+            args,
+        },
+    )
+}
+fn get(local: LocalId) -> Operand {
+    Operand::Local(local)
+}
+fn branch(cond: LocalId, then_: BlockId, else_: BlockId) -> Terminator {
+    Terminator::Branch {
+        cond: get(cond),
+        then_,
+        else_,
+    }
+}
