@@ -0,0 +1,333 @@
+//! producer/consumer岛必须同时命中；失败预检保原GetItem序列，所有观察/支配风险保普通路径。
+use super::MirPass;
+use super::float_chain::FloatChain;
+use crate::mir::*;
+
+fn local(f: &mut Function) -> LocalId {
+    f.body.locals.alloc(LocalDecl {
+        ty: MirType::Dynamic,
+        name: None,
+        is_cell: false,
+    })
+}
+fn call(dest: LocalId, callee: RuntimeFn, args: Vec<Operand>) -> Statement {
+    Statement::Assign {
+        dest,
+        value: Rvalue::Call {
+            callee: Callee::Runtime(callee),
+            args,
+        },
+    }
+}
+fn get(value: LocalId) -> Operand {
+    Operand::Local(value)
+}
+struct Sample {
+    f: Function,
+    blocks: [BlockId; 5],
+    total: LocalId,
+    receiver: LocalId,
+    root: LocalId,
+    leaves: [LocalId; 2],
+    child: LocalId,
+    keys: [LocalId; 2],
+}
+fn sample() -> Sample {
+    let (mut f, blocks, [a, b, _, total, product, result]) = super::float_loop_tests::sample();
+    let [pre, _, body, _, exit] = blocks;
+    let root = local(&mut f);
+    let receiver = local(&mut f);
+    let first = local(&mut f);
+    let child = local(&mut f);
+    let second = local(&mut f);
+    let key = local(&mut f);
+    let column = local(&mut f);
+    let output = local(&mut f);
+    f.params.extend([key, column]);
+    f.body.blocks[pre].stmts.splice(
+        0..0,
+        [
+            Statement::Assign {
+                dest: root,
+                value: Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeList,
+                    prefix: vec![],
+                    args: vec![],
+                },
+            },
+            Statement::Assign {
+                dest: receiver,
+                value: Rvalue::Use(get(root)),
+            },
+        ],
+    );
+    f.body.blocks[body].stmts = vec![
+        call(first, RuntimeFn::GetItem, vec![get(a), get(key)]),
+        call(child, RuntimeFn::GetItem, vec![get(b), get(key)]),
+        call(second, RuntimeFn::GetItem, vec![get(child), get(column)]),
+        Statement::Assign {
+            dest: product,
+            value: Rvalue::DynBinary {
+                op: DynOp::Mul,
+                lhs: get(first),
+                rhs: get(second),
+                inplace: false,
+            },
+        },
+        Statement::Assign {
+            dest: result,
+            value: Rvalue::DynBinary {
+                op: DynOp::Add,
+                lhs: get(total),
+                rhs: get(product),
+                inplace: true,
+            },
+        },
+        Statement::Assign {
+            dest: total,
+            value: Rvalue::Use(get(result)),
+        },
+    ];
+    f.body.blocks[exit].stmts = vec![
+        Statement::Line(21),
+        Statement::Assign {
+            dest: output,
+            value: Rvalue::DynCallMethod {
+                obj: get(receiver),
+                name: "append".into(),
+                args: vec![get(total)],
+            },
+        },
+    ];
+    f.body.blocks[exit].terminator = Terminator::Return(Some(get(receiver)));
+    Sample {
+        f,
+        blocks,
+        total,
+        receiver,
+        root,
+        leaves: [first, second],
+        child,
+        keys: [key, column],
+    }
+}
+fn calls(f: &Function, callee: RuntimeFn) -> usize {
+    f.body.blocks.iter().flat_map(|(_,b)|&b.stmts).filter(|s|matches!(s,
+        Statement::Assign{value:Rvalue::Call{callee:Callee::Runtime(found),..},..}|Statement::Eval(Rvalue::Call{callee:Callee::Runtime(found),..}) if *found==callee)).count()
+}
+#[test]
+fn real_two_level_region_shares_arithmetic_and_preserves_original_read_fallback() {
+    let mut s = sample();
+    FloatChain.run(&mut s.f);
+    for (callee, expected) in [
+        (RuntimeFn::NumericListCreate, 1),
+        (RuntimeFn::NumericListAppendF64, 1),
+        (RuntimeFn::NumericListPeekList, 1),
+        (RuntimeFn::NumericListCanReadF64, 2),
+        (RuntimeFn::NumericListReadF64, 2),
+        (RuntimeFn::GetItem, 3),
+    ] {
+        assert_eq!(calls(&s.f, callee), expected, "{callee:?}");
+    }
+    let (original_id, original) =
+        s.f.body
+            .blocks
+            .iter()
+            .find(|(_, b)| {
+                b.stmts.iter().any(|s| {
+                    matches!(
+                        s,
+                        Statement::Assign {
+                            value: Rvalue::Call {
+                                callee: Callee::Runtime(RuntimeFn::GetItem),
+                                ..
+                            },
+                            ..
+                        }
+                    )
+                })
+            })
+            .unwrap();
+    let ids: Vec<_> = original
+        .stmts
+        .iter()
+        .filter_map(|stmt| match stmt {
+            Statement::Assign {
+                dest,
+                value:
+                    Rvalue::Call {
+                        callee: Callee::Runtime(RuntimeFn::GetItem),
+                        ..
+                    },
+            } => Some(*dest),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        ids,
+        [s.leaves[0], s.child, s.leaves[1]],
+        "失败后原读取依源序一次执行"
+    );
+    for (_, block) in s.f.body.blocks.iter() {
+        if block.stmts.iter().any(|stmt| {
+            matches!(
+                stmt,
+                Statement::Assign {
+                    value: Rvalue::Call {
+                        callee: Callee::Runtime(RuntimeFn::NumericListCanReadF64),
+                        ..
+                    },
+                    ..
+                }
+            )
+        }) {
+            assert!(matches!(block.terminator,Terminator::Branch{else_,..} if else_==original_id));
+        }
+    }
+    let arithmetic: Vec<_> =
+        s.f.body
+            .blocks
+            .iter()
+            .filter(|(_, b)| {
+                b.stmts.iter().any(|stmt| {
+                    matches!(
+                        stmt,
+                        Statement::Assign {
+                            value: Rvalue::Binary { op: BinOp::Mul, .. },
+                            ..
+                        }
+                    )
+                })
+            })
+            .collect();
+    assert_eq!(arithmetic.len(), 1, "typed与boxed路径共享算术块");
+    assert!(
+        s.f.body
+            .locals
+            .iter()
+            .any(|(_, local)| local.name.as_deref() == Some("$float_loop_raw"))
+    );
+}
+#[test]
+fn total_observation_or_non_append_sink_does_not_change_list_factory() {
+    for case in 0..4 {
+        let mut s = sample();
+        let exit = s.blocks[4];
+        match case {
+            0 => s.f.body.blocks[exit].terminator = Terminator::Return(Some(get(s.total))),
+            1 => {
+                if let Statement::Assign {
+                    value: Rvalue::DynCallMethod { name, .. },
+                    ..
+                } = &mut s.f.body.blocks[exit].stmts[1]
+                {
+                    *name = "extend".into();
+                }
+            }
+            2 => s.f.body.blocks[exit].stmts.insert(
+                0,
+                Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![get(s.receiver)],
+                }),
+            ),
+            _ => s.f.body.blocks[exit]
+                .stmts
+                .push(Statement::Eval(Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeTuple,
+                    prefix: vec![],
+                    args: vec![Operand::Array(vec![get(s.total)])],
+                })),
+        }
+        FloatChain.run(&mut s.f);
+        assert_eq!(calls(&s.f, RuntimeFn::NumericListCreate), 0, "case {case}");
+        assert!(
+            s.f.body
+                .locals
+                .iter()
+                .any(|(_, l)| l.name.as_deref() == Some("$float_loop_raw")),
+            "只退回现FloatLoop"
+        );
+    }
+}
+#[test]
+fn unique_but_non_dominating_factory_is_not_a_proof_of_list_identity() {
+    let mut s = sample();
+    let pre = s.blocks[0];
+    let factory = s.f.body.blocks[pre].stmts.remove(0);
+    s.f.body.blocks.alloc(BasicBlock {
+        stmts: vec![factory],
+        terminator: Terminator::Return(None),
+    });
+    FloatChain.run(&mut s.f);
+    assert_eq!(calls(&s.f, RuntimeFn::NumericListCreate), 0);
+}
+#[test]
+fn observed_loads_callback_boundaries_and_dependent_indices_reject_island() {
+    for case in 0..4 {
+        let mut s = sample();
+        let body = s.blocks[2];
+        let exit = s.blocks[4];
+        match case {
+            0 => s.f.body.blocks[exit]
+                .stmts
+                .push(Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![get(s.leaves[0])],
+                })),
+            1 => s.f.body.blocks[body].stmts.insert(2, Statement::Line(9)),
+            2 => s.f.body.blocks[body].stmts.insert(
+                2,
+                Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![get(s.keys[0])],
+                }),
+            ),
+            _ => {
+                if let Statement::Assign {
+                    value: Rvalue::Call { args, .. },
+                    ..
+                } = &mut s.f.body.blocks[body].stmts[2]
+                {
+                    args[1] = get(s.leaves[0]);
+                }
+            }
+        }
+        FloatChain.run(&mut s.f);
+        assert_eq!(calls(&s.f, RuntimeFn::NumericListCreate), 0, "case {case}");
+    }
+}
+#[test]
+fn excess_depth_and_partial_budget_never_rewrite_the_factory() {
+    for case in 0..2 {
+        let mut s = sample();
+        let body = s.blocks[2];
+        if case == 0 {
+            let deeper = local(&mut s.f);
+            s.f.body.blocks[body].stmts.insert(
+                2,
+                call(
+                    deeper,
+                    RuntimeFn::GetItem,
+                    vec![get(s.child), get(s.keys[0])],
+                ),
+            );
+            if let Statement::Assign {
+                value: Rvalue::Call { args, .. },
+                ..
+            } = &mut s.f.body.blocks[body].stmts[3]
+            {
+                args[0] = get(deeper);
+            }
+        } else {
+            // 普通loop扩张12个局部刚好可用，岛还需4个；失败不得留下半转换的工厂。
+            while s.f.body.locals.len() < 500 {
+                local(&mut s.f);
+            }
+        }
+        FloatChain.run(&mut s.f);
+        assert_eq!(calls(&s.f, RuntimeFn::NumericListCreate), 0);
+        assert!(s.f.body.blocks.iter().any(|(_,b)|b.stmts.iter().any(|stmt|matches!(stmt,
+            Statement::Assign{dest,value:Rvalue::CallWithArgs{callee:RuntimeFn::MakeList,..}} if *dest==s.root))));
+    }
+}
diff --git a/crates/ryupy-mir/src/validate_vectors.rs b/crates/ryupy-mir/src/validate_vectors.rs
new file mode 100644
index 0000000..3a1f419
--- /dev/null
+++ b/crates/ryupy-mir/src/validate_vectors.rs
@@ -0,0 +1,281 @@
+//! 私有向量的类型、无逃逸与硬件支配验证；不可达状态和已达空事实严格分离。
+use crate::mir::*;
+use crate::passes::dead_values::{read_operand, read_value};
+use crate::validate::operand_type;
+use rustc_hash::{FxHashMap, FxHashSet};
+use std::collections::VecDeque;
+
+#[derive(Clone, Default, PartialEq, Eq)]
+struct Facts {
+    hardware: bool,
+    predicates: FxHashSet<LocalId>,
+}
+impl Facts {
+    fn transfer(&mut self, statement: &Statement) {
+        if let Statement::Assign { dest, value } = statement {
+            self.predicates.remove(dest);
+            if matches!(value, Rvalue::IsVector128Supported) {
+                self.predicates.insert(*dest);
+            }
+        }
+    }
+    fn meet(&mut self, other: &Self) {
+        self.hardware &= other.hardware;
+        self.predicates.retain(|id| other.predicates.contains(id));
+    }
+}
+
+fn inputs(function: &Function) -> FxHashMap<BlockId, Facts> {
+    let mut inputs = FxHashMap::default();
+    inputs.insert(function.body.entry, Facts::default());
+    let mut queue = VecDeque::from([function.body.entry]);
+    while let Some(id) = queue.pop_front() {
+        let Some((_, block)) = function.body.blocks.iter().find(|(other, _)| *other == id) else {
+            continue;
+        };
+        let mut state = inputs[&id].clone();
+        for statement in &block.stmts {
+            state.transfer(statement);
+        }
+        let edges = match &block.terminator {
+            Terminator::Goto(next) => vec![(*next, state)],
+            Terminator::Branch { cond, then_, else_ } => {
+                let mut yes = state.clone();
+                if let Operand::Local(condition) = cond
+                    && state.predicates.contains(condition)
+                {
+                    yes.hardware = true;
+                }
+                vec![(*then_, yes), (*else_, state)]
+            }
+            _ => vec![],
+        };
+        for (target, incoming) in edges {
+            if let Some(previous) = inputs.get_mut(&target) {
+                let old = previous.clone();
+                previous.meet(&incoming);
+                if *previous != old {
+                    queue.push_back(target);
+                }
+            } else {
+                inputs.insert(target, incoming);
+                queue.push_back(target);
+            }
+        }
+    }
+    inputs
+}
+
+pub(crate) fn validate(program: &Program, errors: &mut Vec<String>) {
+    for (_, global) in program.globals.iter() {
+        if global.ty == MirType::V128F64 {
+            errors.push("向量不得存入模块全局".into());
+        }
+    }
+    for (_, class) in program.classes.iter() {
+        if class.fields.iter().any(|(_, ty)| *ty == MirType::V128F64) {
+            errors.push("向量不得存入类字段".into());
+        }
+    }
+    for (_, function) in program.functions.iter() {
+        validate_function(program, function, errors);
+    }
+}
+
+fn validate_function(program: &Program, function: &Function, errors: &mut Vec<String>) {
+    let vectors: FxHashSet<_> = function
+        .body
+        .locals
+        .iter()
+        .filter(|(_, local)| local.ty == MirType::V128F64)
+        .map(|(id, _)| id)
+        .collect();
+    if function.ret == MirType::V128F64
+        || function.params.iter().any(|id| vectors.contains(id))
+        || function
+            .param_meta
+            .iter()
+            .any(|param| param.ty == MirType::V128F64)
+        || function.env.is_some_and(|id| vectors.contains(&id))
+    {
+        errors.push(format!(
+            "函数 {} 的向量不得进入参数或返回ABI",
+            function.name
+        ));
+    }
+    if vectors.iter().any(|id| function.body.locals[*id].is_cell) {
+        errors.push("向量不得进入cell".into());
+    }
+    let has_vector_op = function.body.blocks.iter().any(|(_, block)| {
+        block.stmts.iter().any(|stmt| {
+            matches!(
+                stmt,
+                Statement::Assign {
+                    value: Rvalue::Box {
+                        from: MirType::V128F64,
+                        ..
+                    } | Rvalue::Unbox {
+                        to: MirType::V128F64,
+                        ..
+                    } | Rvalue::IsVector128Supported
+                        | Rvalue::VectorPackF64 { .. }
+                        | Rvalue::VectorBinaryF64 { .. }
+                        | Rvalue::VectorLaneF64 { .. },
+                    ..
+                } | Statement::Eval(
+                    Rvalue::Box {
+                        from: MirType::V128F64,
+                        ..
+                    } | Rvalue::Unbox {
+                        to: MirType::V128F64,
+                        ..
+                    } | Rvalue::IsVector128Supported
+                        | Rvalue::VectorPackF64 { .. }
+                        | Rvalue::VectorBinaryF64 { .. }
+                        | Rvalue::VectorLaneF64 { .. }
+                )
+            )
+        })
+    });
+    if vectors.is_empty() && !has_vector_op {
+        return;
+    }
+    if !function.body.regions.is_empty()
+        || function.env.is_some()
+        || function
+            .body
+            .blocks
+            .iter()
+            .any(|(_, b)| matches!(b.terminator, Terminator::Suspend { .. }))
+    {
+        errors.push("私有向量首版不支持EH、闭包或暂停函数".into());
+    }
+    let states = inputs(function);
+    for (id, block) in function.body.blocks.iter() {
+        let mut state = states.get(&id).cloned();
+        for stmt in &block.stmts {
+            match stmt {
+                Statement::Assign { dest, value } => {
+                    let result = function
+                        .body
+                        .locals
+                        .iter()
+                        .find(|(id, _)| id == dest)
+                        .map(|(_, local)| &local.ty);
+                    check_value(
+                        program,
+                        function,
+                        value,
+                        result,
+                        state.as_ref(),
+                        &vectors,
+                        errors,
+                    );
+                }
+                Statement::Eval(value) => check_value(
+                    program,
+                    function,
+                    value,
+                    None,
+                    state.as_ref(),
+                    &vectors,
+                    errors,
+                ),
+                Statement::SetField { obj, value, .. } => {
+                    reject_operand(obj, &vectors, errors);
+                    reject_operand(value, &vectors, errors);
+                }
+                Statement::SetGlobal { value, .. } => reject_operand(value, &vectors, errors),
+                Statement::Line(_) => {}
+            }
+            if let Some(state) = &mut state {
+                state.transfer(stmt);
+            }
+        }
+        match &block.terminator {
+            Terminator::Branch { cond, .. } => reject_operand(cond, &vectors, errors),
+            Terminator::Return(value) => {
+                if let Some(value) = value {
+                    reject_operand(value, &vectors, errors);
+                }
+            }
+            Terminator::Raise { value, cause } => {
+                for value in value.iter().chain(cause) {
+                    reject_operand(value, &vectors, errors);
+                }
+            }
+            Terminator::Suspend { value, .. } => reject_operand(value, &vectors, errors),
+            Terminator::Goto(_) | Terminator::Unreachable => {}
+        }
+    }
+}
+
+fn reject_operand(operand: &Operand, vectors: &FxHashSet<LocalId>, errors: &mut Vec<String>) {
+    let mut reads = FxHashSet::default();
+    read_operand(operand, &mut reads);
+    if reads.iter().any(|id| vectors.contains(id)) {
+        errors.push("私有向量不能逃逸到Python或通用ABI".into());
+    }
+}
+
+fn check_value(
+    program: &Program,
+    function: &Function,
+    value: &Rvalue,
+    result: Option<&MirType>,
+    facts: Option<&Facts>,
+    vectors: &FxHashSet<LocalId>,
+    errors: &mut Vec<String>,
+) {
+    let is_type = |operand, ty| operand_type(program, function, operand) == Some(ty);
+    let (expected, valid, needs_hardware) = match value {
+        Rvalue::IsVector128Supported => (MirType::Bool, true, false),
+        Rvalue::VectorPackF64 { low, high } => (
+            MirType::V128F64,
+            is_type(low, MirType::F64) && is_type(high, MirType::F64),
+            true,
+        ),
+        Rvalue::VectorBinaryF64 { op, lhs, rhs } => (
+            MirType::V128F64,
+            matches!(op, BinOp::Add | BinOp::Sub | BinOp::Mul)
+                && is_type(lhs, MirType::V128F64)
+                && is_type(rhs, MirType::V128F64),
+            true,
+        ),
+        Rvalue::VectorLaneF64 { value, lane } => (
+            MirType::F64,
+            *lane < 2 && is_type(value, MirType::V128F64),
+            true,
+        ),
+        Rvalue::Use(Operand::Local(local)) if vectors.contains(local) => {
+            (MirType::V128F64, true, false)
+        }
+        _ => {
+            let mut reads = FxHashSet::default();
+            read_value(value, &mut reads);
+            if result == Some(&MirType::V128F64)
+                || reads.iter().any(|id| vectors.contains(id))
+                || matches!(
+                    value,
+                    Rvalue::Box {
+                        from: MirType::V128F64,
+                        ..
+                    } | Rvalue::Unbox {
+                        to: MirType::V128F64,
+                        ..
+                    }
+                )
+            {
+                errors.push("私有向量只能通过向量节点或同型局部Use读写".into());
+            }
+            return;
+        }
+    };
+    if !valid || result != Some(&expected) {
+        errors.push("向量节点的操作、通道、参数或返回类型错误".into());
+    }
+    // 尚不可达的块不构成硬件证明；即使不会执行，也拒绝未受证明的intrinsic。
+    if needs_hardware && !facts.is_some_and(|state| state.hardware) {
+        errors.push("向量操作缺少硬件支持真边支配".into());
+    }
+}
