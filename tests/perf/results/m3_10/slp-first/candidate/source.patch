index 0000000..72b3a67
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_loop_expand.rs
@@ -0,0 +1,227 @@
+//! 循环浮点状态展开：原对象缓存/原生值/模式分离，跨迭代只在可观察边界物化。
+//!
+//! mode && total==CLR null 表示快路产生了尚未装箱的新值；零轮与慢路返回的原盒保持身份。
+//! 原动态链与写回整体搬入慢路，任何用户异常发生前都不提前提交下一轮状态。
+use super::float_chain::Plan as Chain;
+use super::float_loop::Plan;
+use crate::mir::*;
+use rustc_hash::FxHashMap;
+
+pub(super) fn expand(
+    f: &mut Function,
+    chain: &Chain,
+    plan: Plan,
+    island: Option<super::numeric_list::Plan>,
+) {
+    if let Some(numeric) = &island {
+        super::numeric_list_expand::rewrite_factory(f, numeric);
+    }
+    let raw_total = local(f, MirType::F64);
+    let mode = local(f, MirType::Bool);
+    f.body.locals[raw_total].name = Some("$float_loop_raw".into());
+    f.body.locals[mode].name = Some("$float_loop_mode".into());
+    let is_null = local(f, MirType::Bool);
+    let dirty = local(f, MirType::Bool);
+    let tail = f.body.blocks[chain.block]
+        .stmts
+        .split_off(chain.start + chain.steps.len() + 1);
+    let original = f.body.blocks[chain.block].stmts.split_off(chain.start);
+    let next = std::mem::replace(
+        &mut f.body.blocks[chain.block].terminator,
+        Terminator::Unreachable,
+    );
+    let continuation = block(f, tail, next);
+    let reload = block(
+        f,
+        vec![unbox(raw_total, plan.total)],
+        Terminator::Goto(continuation),
+    );
+    let mut slow_statements = original;
+    slow_statements.push(assign(
+        mode,
+        Rvalue::IsBoxedF64 {
+            value: get(plan.total),
+        },
+    ));
+    let slow = block(f, slow_statements, branch(mode, reload, continuation));
+    let materialize = block(
+        f,
+        vec![boxed(plan.total, raw_total)],
+        Terminator::Goto(slow),
+    );
+    let fallback = block(
+        f,
+        dirty_guard(plan.total, mode, is_null, dirty),
+        branch(dirty, materialize, slow),
+    );
+
+    let mut raw = FxHashMap::default();
+    raw.insert(plan.total, raw_total);
+    let mut fast_statements = Vec::new();
+    let mut unboxes = Vec::new();
+    let mut boxed_inputs = Vec::new();
+    let mut snapshots = Vec::new();
+    for &input in chain.inputs.iter().filter(|&&input| input != plan.total) {
+        let snapshot = local(f, MirType::Dynamic);
+        boxed_inputs.push(assign(snapshot, Rvalue::Use(get(input))));
+        let native = local(f, MirType::F64);
+        raw.insert(input, native);
+        snapshots.push(snapshot);
+        unboxes.push(unbox(native, snapshot));
+    }
+    let mut last_result = raw_total;
+    for step in &chain.steps {
+        let result = local(f, MirType::F64);
+        fast_statements.push(assign(
+            result,
+            Rvalue::Binary {
+                op: step.op,
+                lhs: get(raw[&step.lhs]),
+                rhs: get(raw[&step.rhs]),
+            },
+        ));
+        raw.insert(step.dest, result);
+        last_result = result;
+    }
+    fast_statements.extend([
+        assign(raw_total, Rvalue::Use(get(last_result))),
+        assign(plan.total, Rvalue::Use(Operand::Const(Constant::Null))),
+    ]);
+    let (arithmetic, mut fast) = if island.is_some() {
+        let arithmetic = block(f, fast_statements, Terminator::Goto(continuation));
+        let unbox_inputs = block(f, unboxes, Terminator::Goto(arithmetic));
+        (arithmetic, unbox_inputs)
+    } else {
+        // 未命中岛时保原FloatLoop的单一快块与块数，不为实验改变既有生成形状。
+        unboxes.extend(fast_statements);
+        let fast = block(f, unboxes, Terminator::Goto(continuation));
+        (fast, fast)
+    };
+    for snapshot in snapshots.into_iter().rev() {
+        let check = local(f, MirType::Bool);
+        fast = block(
+            f,
+            vec![assign(
+                check,
+                Rvalue::IsBoxedF64 {
+                    value: get(snapshot),
+                },
+            )],
+            branch(check, fast, fallback),
+        );
+    }
+    if let Some(numeric) = &island {
+        let original_prefix = f.body.blocks[chain.block]
+            .stmts
+            .split_off(numeric.prefix_start);
+        let terminator = super::numeric_list_expand::read_path(
+            f,
+            numeric,
+            original_prefix,
+            boxed_inputs,
+            super::numeric_list_expand::ReadTargets {
+                mode,
+                ordinary_guards: fast,
+                dynamic: fallback,
+                arithmetic,
+                raw: &raw,
+            },
+        );
+        f.body.blocks[chain.block].terminator = terminator;
+    } else {
+        f.body.blocks[chain.block].stmts.extend(boxed_inputs);
+        f.body.blocks[chain.block].terminator = branch(mode, fast, fallback);
+    }
+
+    // 每次外层重入都重置模式和raw；保留pre中原Box/Use写入的对象，不复制初始盒。
+    let initial_reload = block(
+        f,
+        vec![unbox(raw_total, plan.total)],
+        Terminator::Goto(plan.header),
+    );
+    f.body.blocks[plan.preheader].stmts.extend([
+        assign(raw_total, Rvalue::Use(Operand::Const(Constant::F64(0.0)))),
+        assign(
+            mode,
+            Rvalue::IsBoxedF64 {
+                value: get(plan.total),
+            },
+        ),
+    ]);
+    f.body.blocks[plan.preheader].terminator = branch(mode, initial_reload, plan.header);
+
+    // 唯一正常出口只物化dirty值；慢路产生的共享盒与零轮初值都直接沿用。
+    let exit_stmts = std::mem::take(&mut f.body.blocks[plan.exit].stmts);
+    let exit_term = std::mem::replace(
+        &mut f.body.blocks[plan.exit].terminator,
+        Terminator::Unreachable,
+    );
+    let (final_exit, exit_box) = if let Some(numeric) = &island {
+        super::numeric_list_expand::exit_paths(f, numeric, raw_total, exit_stmts, exit_term)
+    } else {
+        let final_exit = block(f, exit_stmts, exit_term);
+        let exit_box = block(
+            f,
+            vec![boxed(plan.total, raw_total)],
+            Terminator::Goto(final_exit),
+        );
+        (final_exit, exit_box)
+    };
+    f.body.blocks[plan.exit].stmts = dirty_guard(plan.total, mode, is_null, dirty);
+    f.body.blocks[plan.exit].terminator = branch(dirty, exit_box, final_exit);
+}
+fn dirty_guard(total: LocalId, mode: LocalId, is_null: LocalId, dirty: LocalId) -> Vec<Statement> {
+    vec![
+        assign(
+            is_null,
+            Rvalue::Binary {
+                op: BinOp::Eq,
+                lhs: get(total),
+                rhs: Operand::Const(Constant::Null),
+            },
+        ),
+        assign(
+            dirty,
+            Rvalue::Binary {
+                op: BinOp::BitAnd,
+                lhs: get(mode),
+                rhs: get(is_null),
+            },
+        ),
+    ]
+}
+fn unbox(dest: LocalId, source: LocalId) -> Statement {
+    assign(dest, Rvalue::UnboxExactF64 { value: get(source) })
+}
+fn boxed(dest: LocalId, source: LocalId) -> Statement {
+    assign(
+        dest,
+        Rvalue::Box {
+            value: get(source),
+            from: MirType::F64,
+        },
+    )
+}
+fn local(f: &mut Function, ty: MirType) -> LocalId {
+    f.body.locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn block(f: &mut Function, stmts: Vec<Statement>, terminator: Terminator) -> BlockId {
+    f.body.blocks.alloc(BasicBlock { stmts, terminator })
+}
+fn assign(dest: LocalId, value: Rvalue) -> Statement {
+    Statement::Assign { dest, value }
+}
+fn get(local: LocalId) -> Operand {
+    Operand::Local(local)
+}
+fn branch(cond: LocalId, then_: BlockId, else_: BlockId) -> Terminator {
+    Terminator::Branch {
+        cond: get(cond),
+        then_,
+        else_,
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/float_loop_tests.rs b/crates/ryupy-mir/src/passes/float_loop_tests.rs
new file mode 100644
index 0000000..e821795
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_loop_tests.rs
@@ -0,0 +1,373 @@
+//! 浮点循环状态策略的结构验收：每次重入重置、原盒/慢路保留、严格图与观察约束。
+use super::MirPass;
+use super::float_chain::FloatChain;
+use crate::mir::*;
+use la_arena::{Arena, RawIdx};
+
+fn local(locals: &mut Arena<LocalDecl>, ty: MirType) -> LocalId {
+    locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn assign(dest: LocalId, value: Rvalue) -> Statement {
+    Statement::Assign { dest, value }
+}
+pub(super) fn sample() -> (Function, [BlockId; 5], [LocalId; 6]) {
+    let mut locals = Arena::default();
+    let a = local(&mut locals, MirType::Dynamic);
+    let b = local(&mut locals, MirType::Dynamic);
+    let initial = local(&mut locals, MirType::Dynamic);
+    let total = local(&mut locals, MirType::Dynamic);
+    let product = local(&mut locals, MirType::Dynamic);
+    let result = local(&mut locals, MirType::Dynamic);
+    locals[total].name = Some("total".into());
+    let mut blocks = Arena::default();
+    let ids: Vec<_> = (0..5)
+        .map(|_| {
+            blocks.alloc(BasicBlock {
+                stmts: vec![],
+                terminator: Terminator::Unreachable,
+            })
+        })
+        .collect();
+    let [pre, header, body, latch, exit] = ids.try_into().unwrap();
+    blocks[pre].stmts = vec![
+        assign(
+            initial,
+            Rvalue::Box {
+                value: Operand::Const(Constant::F64(0.0)),
+                from: MirType::F64,
+            },
+        ),
+        assign(total, Rvalue::Use(Operand::Local(initial))),
+    ];
+    blocks[pre].terminator = Terminator::Goto(header);
+    blocks[header].terminator = Terminator::Branch {
+        cond: Operand::Const(Constant::Bool(true)),
+        then_: body,
+        else_: exit,
+    };
+    blocks[body].stmts = vec![
+        assign(
+            product,
+            Rvalue::DynBinary {
+                op: DynOp::Mul,
+                lhs: Operand::Local(a),
+                rhs: Operand::Local(b),
+                inplace: false,
+            },
+        ),
+        assign(
+            result,
+            Rvalue::DynBinary {
+                op: DynOp::Add,
+                lhs: Operand::Local(total),
+                rhs: Operand::Local(product),
+                inplace: true,
+            },
+        ),
+        assign(total, Rvalue::Use(Operand::Local(result))),
+    ];
+    blocks[body].terminator = Terminator::Goto(latch);
+    blocks[latch].terminator = Terminator::Goto(header);
+    blocks[exit].terminator = Terminator::Return(Some(Operand::Local(total)));
+    (
+        Function {
+            name: "float_loop".into(),
+            codegen_name: "float_loop".into(),
+            source_file: "float_loop.py".into(),
+            params: vec![a, b],
+            ret: MirType::Dynamic,
+            body: Body {
+                locals,
+                blocks,
+                entry: pre,
+                regions: vec![],
+            },
+            param_meta: vec![],
+            function_global: None,
+            defaults_global: None,
+            specialization_identity_global: None,
+            signature_global: Some(GlobalId::from_raw(RawIdx::from(0))),
+            env: None,
+        },
+        [pre, header, body, latch, exit],
+        [a, b, initial, total, product, result],
+    )
+}
+fn optimized(f: &Function) -> bool {
+    f.body
+        .locals
+        .iter()
+        .any(|(_, l)| l.name.as_deref() == Some("$float_loop_raw"))
+}
+fn count(f: &Function, predicate: impl Fn(&Rvalue) -> bool) -> usize {
+    f.body
+        .blocks
+        .iter()
+        .flat_map(|(_, b)| &b.stmts)
+        .filter(|s| match s {
+            Statement::Assign { value, .. } | Statement::Eval(value) => predicate(value),
+            _ => false,
+        })
+        .count()
+}
+#[test]
+fn raw_state_has_only_boundary_boxes_and_keeps_original_dynamic_chain() {
+    let (mut f, [pre, _, _, _, exit], [_, _, _, total, _, _]) = sample();
+    FloatChain.run(&mut f);
+    assert!(optimized(&f));
+    assert_eq!(
+        count(&f, |v| matches!(v, Rvalue::DynBinary { .. })),
+        2,
+        "原慢路不应再被短链guard包装"
+    );
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Box {
+                from: MirType::F64,
+                ..
+            }
+        )),
+        3,
+        "初值盒+慢路物化+出口物化"
+    );
+    assert_eq!(
+        count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })),
+        4,
+        "两个普通输入与初始化/慢路模式检查"
+    );
+    assert!(matches!(
+        f.body.blocks[pre].terminator,
+        Terminator::Branch { .. }
+    ));
+    assert!(matches!(
+        f.body.blocks[exit].terminator,
+        Terminator::Branch { .. }
+    ));
+    let fast = f
+        .body
+        .blocks
+        .iter()
+        .find(|(_, b)| {
+            b.stmts.iter().any(|s| {
+                matches!(s,
+        Statement::Assign{dest,value:Rvalue::Use(Operand::Const(Constant::Null))} if *dest==total)
+            })
+        })
+        .unwrap()
+        .1;
+    assert!(!fast.stmts.iter().any(|s| matches!(
+        s,
+        Statement::Assign {
+            value: Rvalue::Box { .. },
+            ..
+        }
+    )));
+    assert!(
+        f.body.blocks[pre].stmts.iter().any(|s| matches!(s,
+        Statement::Assign{dest,value:Rvalue::Use(Operand::Local(_))} if *dest==total)),
+        "零轮保原对象写入"
+    );
+}
+#[test]
+fn outer_reentry_is_allowed_only_with_a_new_preheader_reset() {
+    let (mut f, [pre, _, _, _, exit], _) = sample();
+    let outer = f.body.blocks.alloc(BasicBlock {
+        stmts: vec![],
+        terminator: Terminator::Goto(pre),
+    });
+    f.body.entry = outer;
+    f.body.blocks[exit].terminator = Terminator::Goto(pre);
+    FloatChain.run(&mut f);
+    assert!(optimized(&f));
+    assert!(f.body.blocks[pre].stmts.iter().any(|s|matches!(s,
+        Statement::Assign{value:Rvalue::Use(Operand::Const(Constant::F64(value))),..} if *value==0.0)),"每次pre重入重置raw再检查真实初值");
+}
+#[test]
+fn non_float_initial_value_and_missing_or_extra_resets_keep_short_chain_strategy() {
+    for case in 0..4 {
+        let (mut f, [pre, _, _, _, _], [a, _, initial, total, _, _]) = sample();
+        match case {
+            0 => {
+                f.body.blocks[pre].stmts[0] = assign(
+                    initial,
+                    Rvalue::Box {
+                        value: Operand::Const(Constant::I64(0)),
+                        from: MirType::I64,
+                    },
+                )
+            }
+            1 => f.body.blocks[pre].stmts[1] = assign(total, Rvalue::Use(Operand::Local(a))),
+            2 => f.body.blocks[pre]
+                .stmts
+                .push(assign(total, Rvalue::Use(Operand::Local(initial)))),
+            _ => {
+                f.body.blocks[pre].stmts.remove(1);
+                f.params.push(total);
+            }
+        }
+        FloatChain.run(&mut f);
+        assert!(!optimized(&f), "case {case}");
+        assert!(
+            count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })) > 0,
+            "不匹配loop仍沿原短链"
+        );
+    }
+}
+#[test]
+fn extra_incoming_edges_breaks_and_accumulator_observation_prevent_loop_strategy() {
+    for case in 0..5 {
+        let (mut f, [pre, header, body, latch, exit], [_, _, _, total, _, result]) = sample();
+        match case {
+            0 => {
+                f.body.blocks.alloc(BasicBlock {
+                    stmts: vec![],
+                    terminator: Terminator::Goto(exit),
+                });
+            }
+            1 => {
+                f.body.blocks[body].terminator = Terminator::Branch {
+                    cond: Operand::Const(Constant::Bool(true)),
+                    then_: latch,
+                    else_: exit,
+                }
+            }
+            2 => f.body.blocks[header]
+                .stmts
+                .push(Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![Operand::Local(total)],
+                })),
+            3 => f.body.blocks[latch]
+                .stmts
+                .push(Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![Operand::Local(total)],
+                })),
+            _ => f.body.blocks[pre].stmts.push(Statement::Eval(Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::DynStr),
+                args: vec![Operand::Local(result)],
+            })),
+        }
+        FloatChain.run(&mut f);
+        assert!(!optimized(&f), "case {case}");
+    }
+}
+#[test]
+fn observing_total_earlier_in_the_chain_and_escaping_final_temporary_are_rejected() {
+    for case in 0..2 {
+        let (mut f, [_, _, body, _, exit], [a, _, _, total, product, result]) = sample();
+        if case == 0 {
+            f.body.blocks[body].stmts[0] = assign(
+                product,
+                Rvalue::DynBinary {
+                    op: DynOp::Mul,
+                    lhs: Operand::Local(total),
+                    rhs: Operand::Local(a),
+                    inplace: false,
+                },
+            );
+        } else {
+            f.body.blocks[exit].terminator = Terminator::Return(Some(Operand::Local(result)));
+        }
+        FloatChain.run(&mut f);
+        assert!(!optimized(&f));
+    }
+}
+
+#[test]
+fn no_loop_internal_block_may_be_the_function_entry() {
+    for position in 1..5 {
+        let (mut f, blocks, _) = sample();
+        f.body.entry = blocks[position];
+        FloatChain.run(&mut f);
+        assert!(!optimized(&f));
+    }
+}
+
+#[test]
+fn no_more_than_four_loops_use_raw_state_in_one_function() {
+    let (mut f, _, [a, b, ..]) = sample();
+    f.body.blocks = Arena::default();
+    let mut previous_exit: Option<BlockId> = None;
+    for index in 0..5 {
+        let initial = local(&mut f.body.locals, MirType::Dynamic);
+        let total = local(&mut f.body.locals, MirType::Dynamic);
+        let product = local(&mut f.body.locals, MirType::Dynamic);
+        let result = local(&mut f.body.locals, MirType::Dynamic);
+        let ids: Vec<_> = (0..5)
+            .map(|_| {
+                f.body.blocks.alloc(BasicBlock {
+                    stmts: vec![],
+                    terminator: Terminator::Unreachable,
+                })
+            })
+            .collect();
+        let [pre, header, body, latch, exit] = ids.try_into().unwrap();
+        if let Some(previous) = previous_exit {
+            f.body.blocks[previous].terminator = Terminator::Goto(pre);
+        } else {
+            f.body.entry = pre;
+        }
+        f.body.blocks[pre].stmts = vec![
+            assign(
+                initial,
+                Rvalue::Box {
+                    value: Operand::Const(Constant::F64(index as f64)),
+                    from: MirType::F64,
+                },
+            ),
+            assign(total, Rvalue::Use(Operand::Local(initial))),
+        ];
+        f.body.blocks[pre].terminator = Terminator::Goto(header);
+        f.body.blocks[header].terminator = Terminator::Branch {
+            cond: Operand::Const(Constant::Bool(true)),
+            then_: body,
+            else_: exit,
+        };
+        f.body.blocks[body].stmts = vec![
+            assign(
+                product,
+                Rvalue::DynBinary {
+                    op: DynOp::Mul,
+                    lhs: Operand::Local(a),
+                    rhs: Operand::Local(b),
+                    inplace: false,
+                },
+            ),
+            assign(
+                result,
+                Rvalue::DynBinary {
+                    op: DynOp::Add,
+                    lhs: Operand::Local(total),
+                    rhs: Operand::Local(product),
+                    inplace: true,
+                },
+            ),
+            assign(total, Rvalue::Use(Operand::Local(result))),
+        ];
+        f.body.blocks[body].terminator = Terminator::Goto(latch);
+        f.body.blocks[latch].terminator = Terminator::Goto(header);
+        f.body.blocks[exit].terminator = Terminator::Return(Some(Operand::Local(total)));
+        previous_exit = Some(exit);
+    }
+    FloatChain.run(&mut f);
+    assert_eq!(
+        f.body
+            .locals
+            .iter()
+            .filter(|(_, local)| local.name.as_deref() == Some("$float_loop_raw"))
+            .count(),
+        4
+    );
+    assert!(f.body.blocks.len() <= 128 && f.body.locals.len() <= 512);
+    assert_eq!(
+        count(&f, |v| matches!(v, Rvalue::DynBinary { .. })),
+        10,
+        "每个动态原链只留一份，不重复特化"
+    );
+}
diff --git a/crates/ryupy-mir/src/passes/float_slp.rs b/crates/ryupy-mir/src/passes/float_slp.rs
new file mode 100644
index 0000000..df07cef
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_slp.rs
@@ -0,0 +1,338 @@
+//! 两 lane 新鲜浮点链的有界 SLP：只配对有序依赖拓扑相同、连续且无观察的产物。
+//!
+//! 容器与未配对尾项保持原位置；每lane分别装箱，不能把数值相同当作可共享对象身份。
+//! 全函数≤16次尝试/≤4次成功；拒绝失败同样消耗预算，不跨用户调用、Line或Use。
+use super::MirPass;
+use super::numeric_list_analysis::{Definitions, definitions, reads, terminator_reads};
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+pub struct FloatSlp {
+    /// 公平测量控制臂：保同ISA/type守卫，仅用原生标量F64发射快路。
+    pub scalar: bool,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Source {
+    Input(usize),
+    Step(usize),
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Operation {
+    pub(super) op: BinOp,
+    pub(super) lhs: Source,
+    pub(super) rhs: Source,
+}
+pub(super) struct Lane {
+    pub(super) start: usize,
+    pub(super) finish: usize,
+    pub(super) final_dest: LocalId,
+    pub(super) inputs: Vec<LocalId>,
+    pub(super) destinations: Vec<LocalId>,
+    pub(super) operations: Vec<Operation>,
+}
+pub(super) struct Plan {
+    pub(super) block: BlockId,
+    pub(super) lanes: [Lane; 2],
+    pub(super) inputs: Vec<LocalId>,
+}
+impl MirPass for FloatSlp {
+    fn name(&self) -> &'static str {
+        "float_slp"
+    }
+    fn run(&self, f: &mut Function) {
+        if !eligible(f) {
+            return;
+        }
+        let mut candidates = Vec::new();
+        'scan: for (_, body) in f.body.blocks.iter() {
+            for stmt in &body.stmts {
+                let Statement::Assign {
+                    dest,
+                    value:
+                        Rvalue::CallWithArgs {
+                            callee: RuntimeFn::MakeList | RuntimeFn::MakeTuple,
+                            prefix,
+                            args,
+                        },
+                } = stmt
+                else {
+                    continue;
+                };
+                if !prefix.is_empty() || args.len() > 8 {
+                    continue;
+                }
+                for low in 0..args.len() {
+                    for high in low + 1..args.len() {
+                        if matches!(
+                            (&args[low], &args[high]),
+                            (Operand::Local(_), Operand::Local(_))
+                        ) {
+                            candidates.push((*dest, low, high));
+                            if candidates.len() == 16 {
+                                break 'scan;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        let mut successes = 0;
+        for (sink, low, high) in candidates {
+            if successes == 4 {
+                break;
+            }
+            let definitions = definitions(f);
+            let Some(locations) = definitions.get(&sink) else {
+                continue;
+            };
+            let [(block, position)] = locations.as_slice() else {
+                continue;
+            };
+            let Some(plan) = candidate(f, &definitions, *block, *position, low, high) else {
+                continue;
+            };
+            // 每个外部引用快照/拆箱/guard三槽；packed输入/每步向量/两lane结果/ISA/慢路末值。
+            let vector_extra = plan.lanes[0].inputs.len() + plan.lanes[0].operations.len() + 5;
+            let scalar_extra = 2 * plan.lanes[0].operations.len() + 3;
+            let extra = 3 * plan.inputs.len() + vector_extra.max(scalar_extra);
+            if f.body.locals.len() + extra > 512
+                || f.body.blocks.len() + plan.inputs.len() + 4 > 128
+            {
+                continue;
+            }
+            super::float_slp_expand::expand(f, plan, self.scalar);
+            successes += 1;
+        }
+    }
+}
+fn eligible(f: &Function) -> bool {
+    f.signature_global.is_some()
+        && f.env.is_none()
+        && f.body.regions.is_empty()
+        && f.body.blocks.len() <= 128
+        && f.body.locals.len() <= 512
+        && f.body
+            .blocks
+            .iter()
+            .map(|(_, b)| b.stmts.len())
+            .sum::<usize>()
+            <= 4096
+        && !f.body.locals.iter().any(|(_, l)| l.is_cell)
+        && !f.body.blocks.iter().any(|(_, b)| {
+            matches!(b.terminator, Terminator::Suspend { .. })
+                || b.stmts.iter().any(|s| {
+                    matches!(
+                        s,
+                        Statement::Assign {
+                            value: Rvalue::MakeGenerator { .. },
+                            ..
+                        } | Statement::Eval(Rvalue::MakeGenerator { .. })
+                    )
+                })
+        })
+}
+fn candidate(
+    f: &Function,
+    defs: &Definitions,
+    block: BlockId,
+    sink: usize,
+    low: usize,
+    high: usize,
+) -> Option<Plan> {
+    let Statement::Assign {
+        value: Rvalue::CallWithArgs { args, .. },
+        ..
+    } = &f.body.blocks[block].stmts[sink]
+    else {
+        return None;
+    };
+    let (Operand::Local(left), Operand::Local(right)) = (&args[low], &args[high]) else {
+        return None;
+    };
+    if left == right
+        || args
+            .iter()
+            .filter(|op| matches!(op,Operand::Local(id)if id==left))
+            .count()
+            != 1
+        || args
+            .iter()
+            .filter(|op| matches!(op,Operand::Local(id)if id==right))
+            .count()
+            != 1
+    {
+        return None;
+    }
+    let lane0 = lane(f, defs, block, sink, *left)?;
+    let lane1 = lane(f, defs, block, sink, *right)?;
+    if lane0.finish + 1 != lane1.start || lane0.operations != lane1.operations {
+        return None;
+    }
+    let destinations: FxHashSet<_> = lane0
+        .destinations
+        .iter()
+        .chain(&lane1.destinations)
+        .copied()
+        .collect();
+    if destinations.len() != lane0.destinations.len() + lane1.destinations.len() {
+        return None;
+    }
+    let mut inputs = Vec::new();
+    let mut seen = FxHashSet::default();
+    for input in lane0.inputs.iter().chain(&lane1.inputs) {
+        if destinations.contains(input) {
+            return None;
+        }
+        if seen.insert(*input) {
+            inputs.push(*input);
+        }
+    }
+    // 最终值只在同一个容器直接消费一次；任何其它读（含tail回调参数/嵌套Array）拒绝。
+    for (id, body) in f.body.blocks.iter() {
+        if !terminator_reads(&body.terminator).is_disjoint(&destinations) {
+            return None;
+        }
+        for (position, stmt) in body.stmts.iter().enumerate() {
+            if id == block && (lane0.start..=lane1.finish).contains(&position) {
+                continue;
+            }
+            let used = reads(stmt);
+            if used.is_disjoint(&destinations) {
+                continue;
+            }
+            if id != block
+                || position != sink
+                || used
+                    .intersection(&destinations)
+                    .any(|id| id != left && id != right)
+            {
+                return None;
+            }
+        }
+    }
+    Some(Plan {
+        block,
+        lanes: [lane0, lane1],
+        inputs,
+    })
+}
+fn dyn_operation(stmt: &Statement) -> Option<(LocalId, BinOp, &Operand, &Operand)> {
+    let Statement::Assign {
+        dest,
+        value:
+            Rvalue::DynBinary {
+                op,
+                lhs,
+                rhs,
+                inplace: false,
+            },
+    } = stmt
+    else {
+        return None;
+    };
+    let op = match op {
+        DynOp::Add => BinOp::Add,
+        DynOp::Sub => BinOp::Sub,
+        DynOp::Mul => BinOp::Mul,
+        _ => return None,
+    };
+    Some((*dest, op, lhs, rhs))
+}
+fn lane(
+    f: &Function,
+    defs: &Definitions,
+    block: BlockId,
+    sink: usize,
+    final_dest: LocalId,
+) -> Option<Lane> {
+    let [(id, finish)] = defs.get(&final_dest)?.as_slice() else {
+        return None;
+    };
+    if *id != block || *finish >= sink {
+        return None;
+    }
+    let finish = *finish;
+    let statements = &f.body.blocks[block].stmts;
+    let mut boundary = finish;
+    while boundary > 0 && dyn_operation(&statements[boundary - 1]).is_some() {
+        boundary -= 1;
+    }
+    let mut pending = vec![finish];
+    let mut positions = FxHashSet::default();
+    while let Some(position) = pending.pop() {
+        if !positions.insert(position) {
+            continue;
+        }
+        if positions.len() > 8 {
+            return None;
+        }
+        let (dest, _, lhs, rhs) = dyn_operation(&statements[position])?;
+        if f.params.contains(&dest)
+            || f.body.locals[dest].name.is_some()
+            || f.body.locals[dest].ty != MirType::Dynamic
+            || defs.get(&dest)?.as_slice() != [(block, position)]
+        {
+            return None;
+        }
+        for operand in [lhs, rhs] {
+            let Operand::Local(source) = operand else {
+                return None;
+            };
+            if f.body.locals[*source].ty != MirType::Dynamic {
+                return None;
+            }
+            if let Some(locations) = defs.get(source)
+                && let [(source_block, source_position)] = locations.as_slice()
+                && *source_block == block
+                && (boundary..=finish).contains(source_position)
+            {
+                if *source_position >= position {
+                    return None;
+                }
+                pending.push(*source_position);
+            }
+        }
+    }
+    let start = *positions.iter().min()?;
+    if !(2..=8).contains(&positions.len()) || positions.len() != finish - start + 1 {
+        return None;
+    }
+    let mut known = FxHashMap::default();
+    let mut input_slots = FxHashMap::default();
+    let mut inputs = Vec::new();
+    let mut destinations = Vec::new();
+    let mut operations = Vec::new();
+    for (index, stmt) in statements[start..=finish].iter().enumerate() {
+        let (dest, op, lhs, rhs) = dyn_operation(stmt)?;
+        let mut source = |operand: &Operand| -> Option<Source> {
+            let Operand::Local(local) = operand else {
+                return None;
+            };
+            if let Some(step) = known.get(local) {
+                Some(Source::Step(*step))
+            } else {
+                let slot = *input_slots.entry(*local).or_insert_with(|| {
+                    let index = inputs.len();
+                    inputs.push(*local);
+                    index
+                });
+                Some(Source::Input(slot))
+            }
+        };
+        operations.push(Operation {
+            op,
+            lhs: source(lhs)?,
+            rhs: source(rhs)?,
+        });
+        known.insert(dest, index);
+        destinations.push(dest);
+    }
+    Some(Lane {
+        start,
+        finish,
+        final_dest,
+        inputs,
+        destinations,
+        operations,
+    })
+}
diff --git a/crates/ryupy-mir/src/passes/float_slp_expand.rs b/crates/ryupy-mir/src/passes/float_slp_expand.rs
new file mode 100644
index 0000000..355efac
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_slp_expand.rs
@@ -0,0 +1,185 @@
+//! 两lane SLP 展开：ISA与精确double双重守卫、显式Vector128运算、每lane独立最终盒。
+//! 原动态链仍按lane0完整执行再lane1；原容器和第三尾项留在同一continuation，不移动副作用。
+use super::float_slp::{Plan, Source};
+use crate::mir::*;
+use rustc_hash::FxHashMap;
+
+pub(super) fn expand(f: &mut Function, plan: Plan, scalar: bool) {
+    let start = plan.lanes[0].start;
+    let finish = plan.lanes[1].finish;
+    let tail = f.body.blocks[plan.block].stmts.split_off(finish + 1);
+    let original = f.body.blocks[plan.block].stmts.split_off(start);
+    let next = std::mem::replace(
+        &mut f.body.blocks[plan.block].terminator,
+        Terminator::Unreachable,
+    );
+    let continuation = block(f, tail, next);
+    // 独立slow_final仍唯一定义；Use分隔两lane，后续FloatChain可优化标量回退而不重包SIMD。
+    let slow_finals = [local(f, MirType::Dynamic), local(f, MirType::Dynamic)];
+    let mut slow = Vec::new();
+    for (mut statement, position) in original.into_iter().zip(start..=finish) {
+        for (lane, temporary) in plan.lanes.iter().zip(slow_finals) {
+            if position == lane.finish {
+                if let Statement::Assign { dest, .. } = &mut statement {
+                    *dest = temporary;
+                }
+            }
+        }
+        slow.push(statement);
+        for (lane, temporary) in plan.lanes.iter().zip(slow_finals) {
+            if position == lane.finish {
+                slow.push(assign(lane.final_dest, Rvalue::Use(get(temporary))));
+            }
+        }
+    }
+    let fallback = block(f, slow, Terminator::Goto(continuation));
+    let mut raw = FxHashMap::default();
+    let mut snapshots = Vec::new();
+    let mut fast = Vec::new();
+    for input in &plan.inputs {
+        let snapshot = local(f, MirType::Dynamic);
+        let value = local(f, MirType::F64);
+        f.body.blocks[plan.block]
+            .stmts
+            .push(assign(snapshot, Rvalue::Use(get(*input))));
+        fast.push(assign(
+            value,
+            Rvalue::UnboxExactF64 {
+                value: get(snapshot),
+            },
+        ));
+        raw.insert(*input, value);
+        snapshots.push(snapshot);
+    }
+    fast.extend(if scalar {
+        scalar_body(f, &plan, &raw)
+    } else {
+        vector_body(f, &plan, &raw)
+    });
+    let mut success = block(f, fast, Terminator::Goto(continuation));
+    for snapshot in snapshots.into_iter().rev() {
+        let guard = local(f, MirType::Bool);
+        success = block(
+            f,
+            vec![assign(
+                guard,
+                Rvalue::IsBoxedF64 {
+                    value: get(snapshot),
+                },
+            )],
+            branch(guard, success, fallback),
+        );
+    }
+    let hardware = local(f, MirType::Bool);
+    let hardware_block = block(
+        f,
+        vec![assign(hardware, Rvalue::IsVector128Supported)],
+        branch(hardware, success, fallback),
+    );
+    f.body.blocks[plan.block].terminator = Terminator::Goto(hardware_block);
+}
+/// 对照臂保原lane次序及每一步舍入，ISA/type入口与packed臂完全共用。
+fn scalar_body(f: &mut Function, plan: &Plan, raw: &FxHashMap<LocalId, LocalId>) -> Vec<Statement> {
+    let mut statements = Vec::new();
+    for lane in &plan.lanes {
+        let mut results = Vec::new();
+        for operation in &lane.operations {
+            let source = |source: Source| match source {
+                Source::Input(index) => raw[&lane.inputs[index]],
+                Source::Step(index) => results[index],
+            };
+            let result = local(f, MirType::F64);
+            statements.push(assign(
+                result,
+                Rvalue::Binary {
+                    op: operation.op,
+                    lhs: get(source(operation.lhs)),
+                    rhs: get(source(operation.rhs)),
+                },
+            ));
+            results.push(result);
+        }
+        statements.push(assign(
+            lane.final_dest,
+            Rvalue::Box {
+                value: get(results[results.len() - 1]),
+                from: MirType::F64,
+            },
+        ));
+    }
+    statements
+}
+fn vector_body(f: &mut Function, plan: &Plan, raw: &FxHashMap<LocalId, LocalId>) -> Vec<Statement> {
+    let mut statements = Vec::new();
+    let mut packed = Vec::new();
+    for (low, high) in plan.lanes[0].inputs.iter().zip(&plan.lanes[1].inputs) {
+        let vector = local(f, MirType::V128F64);
+        statements.push(assign(
+            vector,
+            Rvalue::VectorPackF64 {
+                low: get(raw[low]),
+                high: get(raw[high]),
+            },
+        ));
+        packed.push(vector);
+    }
+    let mut results = Vec::new();
+    for operation in &plan.lanes[0].operations {
+        let source = |source: Source| match source {
+            Source::Input(index) => packed[index],
+            Source::Step(index) => results[index],
+        };
+        let vector = local(f, MirType::V128F64);
+        statements.push(assign(
+            vector,
+            Rvalue::VectorBinaryF64 {
+                op: operation.op,
+                lhs: get(source(operation.lhs)),
+                rhs: get(source(operation.rhs)),
+            },
+        ));
+        results.push(vector);
+    }
+    let result = results[results.len() - 1];
+    for (index, lane) in plan.lanes.iter().enumerate() {
+        let value = local(f, MirType::F64);
+        statements.push(assign(
+            value,
+            Rvalue::VectorLaneF64 {
+                value: get(result),
+                lane: index as u8,
+            },
+        ));
+        statements.push(assign(
+            lane.final_dest,
+            Rvalue::Box {
+                value: get(value),
+                from: MirType::F64,
+            },
+        ));
+    }
+    statements
+}
+fn local(f: &mut Function, ty: MirType) -> LocalId {
+    f.body.locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn block(f: &mut Function, stmts: Vec<Statement>, terminator: Terminator) -> BlockId {
+    f.body.blocks.alloc(BasicBlock { stmts, terminator })
+}
+fn assign(dest: LocalId, value: Rvalue) -> Statement {
+    Statement::Assign { dest, value }
+}
+fn get(local: LocalId) -> Operand {
+    Operand::Local(local)
+}
+fn branch(cond: LocalId, then_: BlockId, else_: BlockId) -> Terminator {
+    Terminator::Branch {
+        cond: get(cond),
+        then_,
+        else_,
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/float_slp_tests.rs b/crates/ryupy-mir/src/passes/float_slp_tests.rs
new file mode 100644
index 0000000..090f753
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/float_slp_tests.rs
@@ -0,0 +1,441 @@
+//! SLP只打包两个独立新鲜结果：有序拓扑、尾部副作用、身份观察与标量fallback均锁定。
+use super::float_slp::FloatSlp;
+use super::{FloatChain, MirPass};
+use crate::mir::*;
+use la_arena::{Arena, RawIdx};
+fn local(locals: &mut Arena<LocalDecl>) -> LocalId {
+    locals.alloc(LocalDecl {
+        ty: MirType::Dynamic,
+        name: None,
+        is_cell: false,
+    })
+}
+fn binary(dest: LocalId, op: DynOp, lhs: LocalId, rhs: LocalId) -> Statement {
+    Statement::Assign {
+        dest,
+        value: Rvalue::DynBinary {
+            op,
+            lhs: Operand::Local(lhs),
+            rhs: Operand::Local(rhs),
+            inplace: false,
+        },
+    }
+}
+fn sample() -> (Function, [LocalId; 11]) {
+    let mut locals = Arena::default();
+    let ids: Vec<_> = (0..11).map(|_| local(&mut locals)).collect();
+    let [a, b, c, d, e, f, l0, l1, r0, r1, sink] = ids.try_into().unwrap();
+    let mut blocks = Arena::default();
+    let entry = blocks.alloc(BasicBlock {
+        stmts: vec![
+            binary(l0, DynOp::Mul, a, b),
+            binary(l1, DynOp::Add, l0, c),
+            binary(r0, DynOp::Mul, d, e),
+            binary(r1, DynOp::Add, r0, f),
+            Statement::Assign {
+                dest: sink,
+                value: Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeList,
+                    prefix: vec![],
+                    args: vec![Operand::Local(l1), Operand::Local(r1)],
+                },
+            },
+        ],
+        terminator: Terminator::Return(Some(Operand::Local(sink))),
+    });
+    (
+        Function {
+            name: "slp".into(),
+            codegen_name: "slp".into(),
+            source_file: "slp.py".into(),
+            params: vec![a, b, c, d, e, f],
+            ret: MirType::Dynamic,
+            body: Body {
+                locals,
+                blocks,
+                entry,
+                regions: vec![],
+            },
+            param_meta: vec![],
+            function_global: None,
+            defaults_global: None,
+            specialization_identity_global: None,
+            signature_global: Some(GlobalId::from_raw(RawIdx::from(0))),
+            env: None,
+        },
+        [a, b, c, d, e, f, l0, l1, r0, r1, sink],
+    )
+}
+fn count(f: &Function, predicate: impl Fn(&Rvalue) -> bool) -> usize {
+    f.body
+        .blocks
+        .iter()
+        .flat_map(|(_, b)| &b.stmts)
+        .filter(|s| match s {
+            Statement::Assign { value, .. } | Statement::Eval(value) => predicate(value),
+            _ => false,
+        })
+        .count()
+}
+#[test]
+fn paired_chain_has_isa_guard_two_final_boxes_and_optimizable_scalar_fallback() {
+    let (mut f, [_, _, _, _, _, _, _, left, _, right, _]) = sample();
+    FloatSlp { scalar: false }.run(&mut f);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsVector128Supported)), 1);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::VectorPackF64 { .. })), 3);
+    assert_eq!(
+        count(&f, |v| matches!(v, Rvalue::VectorBinaryF64 { .. })),
+        2
+    );
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::VectorLaneF64 { .. })), 2);
+    let fast = f
+        .body
+        .blocks
+        .iter()
+        .find(|(_, b)| {
+            b.stmts.iter().any(|s| {
+                matches!(
+                    s,
+                    Statement::Assign {
+                        value: Rvalue::VectorLaneF64 { .. },
+                        ..
+                    }
+                )
+            })
+        })
+        .unwrap()
+        .1;
+    let finals: Vec<_> = fast
+        .stmts
+        .iter()
+        .filter_map(|s| match s {
+            Statement::Assign {
+                dest,
+                value: Rvalue::Box {
+                    from: MirType::F64, ..
+                },
+            } => Some(*dest),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(finals, [left, right]);
+    FloatChain.run(&mut f);
+    assert_eq!(
+        count(&f, |v| matches!(v, Rvalue::VectorBinaryF64 { .. })),
+        2
+    );
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Binary {
+                op: BinOp::Add | BinOp::Mul,
+                ..
+            }
+        )),
+        4,
+        "两个slow lane仍可各自走scalar F64"
+    );
+}
+#[test]
+fn unchanged_third_item_call_stays_after_both_lanes_and_before_container() {
+    let (mut f, [a, ..]) = sample();
+    let entry = f.body.entry;
+    let tail = local(&mut f.body.locals);
+    f.body.blocks[entry].stmts.insert(
+        4,
+        Statement::Assign {
+            dest: tail,
+            value: Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::DynStr),
+                args: vec![Operand::Local(a)],
+            },
+        },
+    );
+    if let Statement::Assign {
+        value: Rvalue::CallWithArgs { args, .. },
+        ..
+    } = &mut f.body.blocks[entry].stmts[5]
+    {
+        args.push(Operand::Local(tail));
+    }
+    FloatSlp { scalar: false }.run(&mut f);
+    assert_eq!(
+        count(&f, |v| matches!(v, Rvalue::VectorBinaryF64 { .. })),
+        2
+    );
+    let tail_block = f
+        .body
+        .blocks
+        .iter()
+        .find(|(_, b)| {
+            b.stmts
+                .iter()
+                .any(|s| matches!(s,Statement::Assign{dest,..}if *dest==tail))
+        })
+        .unwrap()
+        .1;
+    assert!(matches!(&tail_block.stmts[0],Statement::Assign{dest,..}if *dest==tail));
+    assert!(matches!(
+        &tail_block.stmts[1],
+        Statement::Assign {
+            value: Rvalue::CallWithArgs {
+                callee: RuntimeFn::MakeList,
+                ..
+            },
+            ..
+        }
+    ));
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::DynStr),
+                ..
+            }
+        )),
+        1
+    );
+}
+#[test]
+fn shared_output_observation_and_cross_lane_dependency_are_rejected() {
+    for case in 0..4 {
+        let (mut f, [a, _, _, _, _, last, _, left, middle, right, _]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => {
+                if let Statement::Assign {
+                    value: Rvalue::CallWithArgs { args, .. },
+                    ..
+                } = &mut f.body.blocks[entry].stmts[4]
+                {
+                    args[1] = Operand::Local(left);
+                }
+            }
+            1 => f.body.blocks[entry]
+                .stmts
+                .push(Statement::Eval(Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeTuple,
+                    prefix: vec![],
+                    args: vec![Operand::Array(vec![Operand::Local(left)])],
+                })),
+            2 => f.body.blocks[entry].stmts[3] = binary(right, DynOp::Add, left, last),
+            _ => {
+                f.body.locals[middle].name = Some("named".into());
+                f.body.blocks[entry].stmts[2] = binary(middle, DynOp::Mul, a, last);
+            }
+        }
+        FloatSlp { scalar: false }.run(&mut f);
+        assert_eq!(
+            count(&f, |v| matches!(v, Rvalue::IsVector128Supported)),
+            0,
+            "case {case}"
+        );
+    }
+}
+#[test]
+fn ordered_dependency_topology_and_contiguous_regions_are_required() {
+    for case in 0..4 {
+        let (mut f, [a, _, _, d, _, last, _, _, middle, right, _]) = sample();
+        let entry = f.body.entry;
+        match case {
+            0 => f.body.blocks[entry].stmts[3] = binary(right, DynOp::Add, last, middle),
+            1 => f.body.blocks[entry].stmts.insert(2, Statement::Line(2)),
+            2 => f.body.blocks[entry].stmts.insert(
+                2,
+                Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::DynStr),
+                    args: vec![Operand::Local(a)],
+                }),
+            ),
+            _ => f.body.blocks[entry].stmts[3] = binary(right, DynOp::Sub, middle, d),
+        }
+        FloatSlp { scalar: false }.run(&mut f);
+        assert_eq!(
+            count(&f, |v| matches!(v, Rvalue::VectorBinaryF64 { .. })),
+            0
+        );
+    }
+}
+#[test]
+fn shared_readonly_external_keeps_distinct_fresh_results() {
+    let (mut f, [a, b, c, _, _, _, _, _, middle, right, _]) = sample();
+    let entry = f.body.entry;
+    f.body.blocks[entry].stmts[2] = binary(middle, DynOp::Mul, a, b);
+    f.body.blocks[entry].stmts[3] = binary(right, DynOp::Add, middle, c);
+    FloatSlp { scalar: false }.run(&mut f);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 3);
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Box {
+                from: MirType::F64,
+                ..
+            }
+        )),
+        2
+    );
+}
+
+#[test]
+fn scalar_control_arm_keeps_identical_guards_boxes_and_original_lane_order() {
+    let (mut f, [_, _, _, _, _, _, _, left, _, right, _]) = sample();
+    FloatSlp { scalar: true }.run(&mut f);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsVector128Supported)), 1);
+    assert_eq!(count(&f, |v| matches!(v, Rvalue::IsBoxedF64 { .. })), 6);
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::VectorPackF64 { .. }
+                | Rvalue::VectorBinaryF64 { .. }
+                | Rvalue::VectorLaneF64 { .. }
+        )),
+        0
+    );
+    assert_eq!(
+        count(&f, |v| matches!(
+            v,
+            Rvalue::Box {
+                from: MirType::F64,
+                ..
+            }
+        )),
+        2
+    );
+    let fast = f
+        .body
+        .blocks
+        .iter()
+        .find(|(_, body)| {
+            body.stmts.iter().any(|stmt| {
+                matches!(
+                    stmt,
+                    Statement::Assign {
+                        value: Rvalue::UnboxExactF64 { .. },
+                        ..
+                    }
+                )
+            })
+        })
+        .unwrap()
+        .1;
+    let ops: Vec<_> = fast
+        .stmts
+        .iter()
+        .filter_map(|stmt| match stmt {
+            Statement::Assign {
+                value: Rvalue::Binary { op, .. },
+                ..
+            } => Some((*op, None)),
+            Statement::Assign {
+                dest,
+                value: Rvalue::Box {
+                    from: MirType::F64, ..
+                },
+            } => Some((BinOp::Eq, Some(*dest))),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        ops,
+        [
+            (BinOp::Mul, None),
+            (BinOp::Add, None),
+            (BinOp::Eq, Some(left)),
+            (BinOp::Mul, None),
+            (BinOp::Add, None),
+            (BinOp::Eq, Some(right))
+        ]
+    );
+}
+
+#[test]
+fn rejected_pairs_consume_attempt_budget_and_success_budget_is_four() {
+    for failed_prefix in [true, false] {
+        let (mut f, ids) = sample();
+        let [a, b, c, d, e, last, ..] = ids;
+        let entry = f.body.entry;
+        f.body.blocks[entry].stmts.clear();
+        f.body.blocks[entry].terminator = Terminator::Return(None);
+        let pairs = if failed_prefix { 17 } else { 5 };
+        for index in 0..pairs {
+            let l0 = local(&mut f.body.locals);
+            let l1 = local(&mut f.body.locals);
+            let r0 = local(&mut f.body.locals);
+            let r1 = local(&mut f.body.locals);
+            let sink = local(&mut f.body.locals);
+            if failed_prefix && index < 16 {
+                f.body.locals[l0].name = Some("observed".into());
+            }
+            f.body.blocks[entry].stmts.extend([
+                binary(l0, DynOp::Mul, a, b),
+                binary(l1, DynOp::Add, l0, c),
+                binary(r0, DynOp::Mul, d, e),
+                binary(r1, DynOp::Add, r0, last),
+                Statement::Assign {
+                    dest: sink,
+                    value: Rvalue::CallWithArgs {
+                        callee: RuntimeFn::MakeList,
+                        prefix: vec![],
+                        args: vec![Operand::Local(l1), Operand::Local(r1)],
+                    },
+                },
+            ]);
+        }
+        FloatSlp { scalar: false }.run(&mut f);
+        assert_eq!(
+            count(&f, |v| matches!(v, Rvalue::IsVector128Supported)),
+            if failed_prefix { 0 } else { 4 }
+        );
+        assert!(f.body.locals.len() <= 512 && f.body.blocks.len() <= 128);
+    }
+}
+
+#[test]
+fn no_hardware_path_jumps_to_original_scalar_operations_without_vector_instructions() {
+    let (mut f, _) = sample();
+    FloatSlp { scalar: false }.run(&mut f);
+    let hardware = f
+        .body
+        .blocks
+        .iter()
+        .find(|(_, block)| {
+            block.stmts.iter().any(|stmt| {
+                matches!(
+                    stmt,
+                    Statement::Assign {
+                        value: Rvalue::IsVector128Supported,
+                        ..
+                    }
+                )
+            })
+        })
+        .unwrap()
+        .1;
+    let Terminator::Branch { else_, .. } = hardware.terminator else {
+        panic!("ISA必须显式分支")
+    };
+    let fallback = &f.body.blocks[else_];
+    assert_eq!(
+        fallback
+            .stmts
+            .iter()
+            .filter(|stmt| matches!(
+                stmt,
+                Statement::Assign {
+                    value: Rvalue::DynBinary { .. },
+                    ..
+                }
+            ))
+            .count(),
+        4
+    );
+    assert!(!fallback.stmts.iter().any(|stmt| matches!(
+        stmt,
+        Statement::Assign {
+            value: Rvalue::VectorPackF64 { .. }
+                | Rvalue::VectorBinaryF64 { .. }
+                | Rvalue::VectorLaneF64 { .. },
+            ..
+        }
+    )));
+}
diff --git a/crates/ryupy-mir/src/passes/numeric_list.rs b/crates/ryupy-mir/src/passes/numeric_list.rs
new file mode 100644
index 0000000..3ce43e2
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/numeric_list.rs
@@ -0,0 +1,252 @@
+//! 数值列表岛的双端匹配：同时证明无观察的 append 出口与纯列表读取前缀，才改变工厂。
+//!
+//! 仅复用已确认的 FloatLoop；≤4 次 GetItem、≤2 层，索引/外部根均已求值为动态局部。
+//! 工厂与 Use 链必须支配使用，不能把“唯一赋值”误当“所有路径已初始化”。
+use super::float_chain::Plan as Chain;
+use super::float_loop::Plan as Loop;
+use super::numeric_list_analysis::{
+    Definitions, definitions, dominates, dominators, reads, terminator_reads,
+};
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+pub(super) struct Load {
+    pub(super) dest: LocalId,
+    pub(super) root: LocalId,
+    pub(super) key: LocalId,
+    pub(super) child: bool,
+}
+pub(super) struct Plan {
+    pub(super) factory: (BlockId, usize),
+    pub(super) prefix_start: usize,
+    pub(super) loads: Vec<Load>,
+    pub(super) sink_position: usize,
+    pub(super) sink_dest: LocalId,
+    pub(super) receiver: LocalId,
+}
+impl Plan {
+    pub(super) fn extra_locals(&self) -> usize {
+        // 每次预检一个bool，子节点额外一个私有引用；typed读取复用已有原生输入槽。
+        self.loads.len() + self.loads.iter().filter(|load| load.child).count()
+    }
+    pub(super) fn extra_blocks(&self) -> usize {
+        // 预检块、typed读取、原GetItem前缀以及分离出口后继；通用unbox分块单独计费。
+        self.loads.len() + 3
+    }
+}
+
+pub(super) fn candidate(f: &Function, chain: &Chain, loop_plan: &Loop) -> Option<Plan> {
+    let definitions = definitions(f);
+    let exit = &f.body.blocks[loop_plan.exit];
+    let sink_position = exit
+        .stmts
+        .iter()
+        .position(|stmt| !matches!(stmt, Statement::Line(_)))?;
+    let Statement::Assign {
+        dest: sink_dest,
+        value:
+            Rvalue::DynCallMethod {
+                obj: Operand::Local(receiver),
+                name,
+                args,
+            },
+    } = &exit.stmts[sink_position]
+    else {
+        return None;
+    };
+    if name != "append"
+        || !matches!(args.as_slice(), [Operand::Local(total)] if *total == loop_plan.total)
+        || f.body.locals[*receiver].ty != MirType::Dynamic
+        || *sink_dest == loop_plan.total
+    {
+        return None;
+    }
+    let last = chain.start + chain.steps.len() - 1;
+    // 累加槽只允许链末 lhs 与唯一 append；临时/帧/容器中的隐藏观察同样拒绝。
+    for (id, body) in f.body.blocks.iter() {
+        if terminator_reads(&body.terminator).contains(&loop_plan.total) {
+            return None;
+        }
+        for (position, stmt) in body.stmts.iter().enumerate() {
+            if reads(stmt).contains(&loop_plan.total)
+                && (id, position) != (chain.block, last)
+                && (id, position) != (loop_plan.exit, sink_position)
+            {
+                return None;
+            }
+        }
+    }
+    let dominators = dominators(f);
+    let factory = factory(
+        f,
+        &definitions,
+        &dominators,
+        *receiver,
+        (loop_plan.exit, sink_position),
+    )?;
+    // 工厂不能只在循环某一轮执行；必须先于每次preheader及其出口。
+    if !dominates(
+        &dominators,
+        factory,
+        (
+            loop_plan.preheader,
+            f.body.blocks[loop_plan.preheader].stmts.len(),
+        ),
+    ) {
+        return None;
+    }
+    let statements = &f.body.blocks[chain.block].stmts;
+    let mut start = chain.start;
+    while start > 0 && item(&statements[start - 1]).is_some() {
+        start -= 1;
+    }
+    if !(1..=4).contains(&(chain.start - start)) {
+        return None;
+    }
+    let mut positions = FxHashMap::default();
+    let mut loads = Vec::new();
+    for (offset, stmt) in statements[start..chain.start].iter().enumerate() {
+        let (dest, root, key) = item(stmt)?;
+        if f.params.contains(&dest)
+            || f.body.locals[dest].name.is_some()
+            || f.body.locals[dest].ty != MirType::Dynamic
+            || f.body.locals[root].ty != MirType::Dynamic
+            || f.body.locals[key].ty != MirType::Dynamic
+            || definitions.get(&dest)?.as_slice() != [(chain.block, start + offset)]
+            || positions.insert(dest, offset).is_some()
+        {
+            return None;
+        }
+        loads.push(Load {
+            dest,
+            root,
+            key,
+            child: false,
+        });
+    }
+    let leaf_inputs: FxHashSet<_> = chain
+        .inputs
+        .iter()
+        .copied()
+        .filter(|input| *input != loop_plan.total)
+        .collect();
+    if leaf_inputs.is_empty()
+        || !leaf_inputs
+            .iter()
+            .all(|input| positions.contains_key(input))
+    {
+        return None;
+    }
+    let mut depths = Vec::new();
+    let mut children = FxHashSet::default();
+    for (index, load) in loads.iter().enumerate() {
+        if positions.contains_key(&load.key) {
+            return None;
+        }
+        let depth = if let Some(parent) = positions.get(&load.root) {
+            if *parent >= index {
+                return None;
+            }
+            children.insert(load.root);
+            depths[*parent] + 1
+        } else {
+            1
+        };
+        if depth > 2 {
+            return None;
+        }
+        depths.push(depth);
+    }
+    for load in &mut loads {
+        load.child = children.contains(&load.dest);
+        if load.child == leaf_inputs.contains(&load.dest) {
+            return None;
+        }
+    }
+    let outputs: FxHashSet<_> = positions.keys().copied().collect();
+    for (id, body) in f.body.blocks.iter() {
+        if !terminator_reads(&body.terminator).is_disjoint(&outputs) {
+            return None;
+        }
+        for (position, stmt) in body.stmts.iter().enumerate() {
+            if id == chain.block && (start..chain.start + chain.steps.len()).contains(&position) {
+                continue;
+            }
+            if !reads(stmt).is_disjoint(&outputs) {
+                return None;
+            }
+        }
+    }
+    Some(Plan {
+        factory,
+        prefix_start: start,
+        loads,
+        sink_position,
+        sink_dest: *sink_dest,
+        receiver: *receiver,
+    })
+}
+fn item(statement: &Statement) -> Option<(LocalId, LocalId, LocalId)> {
+    let Statement::Assign {
+        dest,
+        value:
+            Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::GetItem),
+                args,
+            },
+    } = statement
+    else {
+        return None;
+    };
+    let [Operand::Local(root), Operand::Local(key)] = args.as_slice() else {
+        return None;
+    };
+    Some((*dest, *root, *key))
+}
+fn factory(
+    f: &Function,
+    definitions: &Definitions,
+    dominators: &FxHashMap<BlockId, FxHashSet<BlockId>>,
+    mut receiver: LocalId,
+    mut usage: (BlockId, usize),
+) -> Option<(BlockId, usize)> {
+    for _ in 0..16 {
+        if f.params.contains(&receiver) {
+            return None;
+        }
+        let [location] = definitions.get(&receiver)?.as_slice() else {
+            return None;
+        };
+        if !dominates(dominators, *location, usage) {
+            return None;
+        }
+        match &f.body.blocks[location.0].stmts[location.1] {
+            Statement::Assign {
+                value: Rvalue::Use(Operand::Local(source)),
+                ..
+            } => {
+                receiver = *source;
+                usage = *location;
+            }
+            Statement::Assign {
+                value:
+                    Rvalue::CallWithArgs {
+                        callee: RuntimeFn::MakeList,
+                        prefix,
+                        args,
+                    },
+                ..
+            } if prefix.is_empty() && args.is_empty() => return Some(*location),
+            Statement::Assign {
+                value:
+                    Rvalue::Call {
+                        callee: Callee::Runtime(RuntimeFn::NumericListCreate),
+                        args,
+                    },
+                ..
+            } if args.is_empty() => return Some(*location),
+            _ => return None,
+        }
+    }
+    None
+}
