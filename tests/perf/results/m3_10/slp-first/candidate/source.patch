+            diagnostic_scalar_slp: scalar,
+            ..Session::default()
+        };
+        let artifact = ryupy_driver::build(
+            &mut session,
+            &BuildOptions {
+                input: input.clone(),
+                out_dir: root.join(format!("target/test_float_slp_{scalar}")),
+                aot: false,
+                search_paths: vec![],
+            },
