+//! 合流、bool排除、溢出和预算负例；证明不能把Top/未访问混为一谈或改变既有盒身份。
+use super::{MirPass, interval_facts, interval_narrow::IntervalNarrow};
+use crate::mir::*;
+use la_arena::{Arena, Idx, RawIdx};
+fn local(f: &mut Function, ty: MirType) -> LocalId {
+    f.body.locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn boxed(dest: LocalId, value: i64) -> Statement {
+    Statement::Assign {
+        dest,
+        value: Rvalue::Box {
+            value: Operand::Const(Constant::I64(value)),
+            from: MirType::I64,
+        },
+    }
+}
+fn sample() -> (Function, LocalId, BlockId) {
+    let mut blocks = Arena::default();
+    let entry = blocks.alloc(BasicBlock {
+        stmts: vec![],
+        terminator: Terminator::Unreachable,
+    });
+    let yes = blocks.alloc(BasicBlock {
+        stmts: vec![],
+        terminator: Terminator::Unreachable,
+    });
+    let no = blocks.alloc(BasicBlock {
+        stmts: vec![],
+        terminator: Terminator::Unreachable,
+    });
+    let join = blocks.alloc(BasicBlock {
+        stmts: vec![],
+        terminator: Terminator::Unreachable,
+    });
+    let mut f = Function {
+        name: "join".into(),
+        codegen_name: "join".into(),
+        source_file: "join.py".into(),
+        params: vec![],
+        ret: MirType::Dynamic,
+        body: Body {
+            locals: Arena::default(),
+            blocks,
+            entry,
+            regions: vec![],
+        },
+        param_meta: vec![],
+        function_global: None,
+        specialization_identity_global: None,
+        defaults_global: None,
+        signature_global: Some(Idx::from_raw(RawIdx::from_u32(0))),
+        env: None,
+    };
+    let value = local(&mut f, MirType::Dynamic);
+    let two = local(&mut f, MirType::Dynamic);
+    let sum = local(&mut f, MirType::Dynamic);
+    f.body.blocks[entry].terminator = Terminator::Branch {
+        cond: Operand::Const(Constant::Bool(true)),
+        then_: yes,
+        else_: no,
+    };
+    f.body.blocks[yes].stmts = vec![boxed(value, 3)];
+    f.body.blocks[yes].terminator = Terminator::Goto(join);
+    f.body.blocks[no].stmts = vec![boxed(value, 7)];
+    f.body.blocks[no].terminator = Terminator::Goto(join);
+    f.body.blocks[join].stmts = vec![
+        boxed(two, 2),
+        Statement::Assign {
+            dest: sum,
+            value: Rvalue::DynBinary {
+                op: DynOp::Add,
+                lhs: Operand::Local(value),
+                rhs: Operand::Local(two),
+                inplace: false,
+            },
+        },
+    ];
+    f.body.blocks[join].terminator = Terminator::Return(Some(Operand::Local(sum)));
+    (f, value, join)
+}
+fn unboxes(f: &Function) -> usize {
+    f.body
+        .blocks
+        .iter()
+        .flat_map(|(_, b)| &b.stmts)
+        .filter(|s| {
+            matches!(
+                s,
+                Statement::Assign {
+                    value: Rvalue::UnboxExactI64 { .. },
+                    ..
+                }
+            )
+        })
+        .count()
+}
+#[test]
+fn hull_drives_automatic_unbox_without_changing_source_boxes() {
+    let (mut f, value, join) = sample();
+    let states = interval_facts::inputs(&f).unwrap();
+    let range = states[&join].ranges[&value];
+    assert_eq!((range.lo, range.hi), (3, 7));
+    IntervalNarrow.run(&mut f);
+    assert_eq!(unboxes(&f), 2);
+    // 原分支各自的Box必须保留，不能把其观察身份替成新的求和值盒。
+    assert_eq!(
+        f.body
+            .blocks
+            .iter()
+            .flat_map(|(_, b)| &b.stmts)
+            .filter(|s| matches!(s,Statement::Assign{dest,value:Rvalue::Box{..}}if *dest==value))
+            .count(),
+        2
+    );
+}
+#[test]
+fn bool_missing_and_overflow_branches_stay_dynamic() {
+    for case in 0..3 {
+        let (mut f, value, _) = sample();
+        let no = Idx::from_raw(RawIdx::from_u32(2));
+        f.body.blocks[no].stmts = match case {
+            0 => vec![Statement::Assign {
+                dest: value,
+                value: Rvalue::Box {
+                    value: Operand::Const(Constant::Bool(true)),
+                    from: MirType::Bool,
+                },
+            }],
+            1 => vec![],
+            _ => vec![boxed(value, i64::MAX)],
+        };
+        IntervalNarrow.run(&mut f);
+        assert_eq!(unboxes(&f), 0);
+    }
+}
+#[test]
+fn growing_backedge_widens_to_top() {
+    let (mut f, value, join) = sample();
+    let counter = local(&mut f, MirType::I64);
+    f.body.blocks[f.body.entry].stmts.push(Statement::Assign {
+        dest: counter,
+        value: Rvalue::Use(Operand::Const(Constant::I64(0))),
+    });
+    f.body.blocks[join].stmts = vec![
+        Statement::Assign {
+            dest: counter,
+            value: Rvalue::Binary {
+                op: BinOp::Add,
+                lhs: Operand::Local(counter),
+                rhs: Operand::Const(Constant::I64(1)),
+            },
+        },
+        Statement::Assign {
+            dest: value,
+            value: Rvalue::Box {
+                value: Operand::Local(counter),
+                from: MirType::I64,
+            },
+        },
+    ];
+    f.body.blocks[join].terminator = Terminator::Goto(join);
+    let states = interval_facts::inputs(&f).unwrap();
+    assert!(!states[&join].ranges.contains_key(&counter));
+}
+#[test]
+fn over_budget_and_cell_inputs_are_unchanged() {
+    for cell in [true, false] {
+        let (mut f, value, _) = sample();
+        if cell {
+            f.body.locals[value].is_cell = true;
+        } else {
+            for _ in 0..129 {
+                f.body.blocks.alloc(BasicBlock {
+                    stmts: vec![],
+                    terminator: Terminator::Unreachable,
+                });
+            }
+        }
+        let before = format!("{:?}", f.body);
+        IntervalNarrow.run(&mut f);
+        assert_eq!(before, format!("{:?}", f.body));
+    }
+}
+
+#[test]
+fn transformed_join_passes_independent_exact_type_verifier() {
+    let (mut f, _, _) = sample();
+    IntervalNarrow.run(&mut f);
+    let mut functions = Arena::default();
+    let entry = functions.alloc(f);
+    let mut globals = Arena::default();
+    globals.alloc(GlobalDecl {
+        name: "signature".into(),
+        ty: MirType::Dynamic,
+    });
+    let program = Program {
+        functions,
+        classes: Arena::default(),
+        globals,
+        entry,
+        source_name: "join.py".into(),
+    };
+    crate::validate::validate(&program).unwrap();
+}
+
+#[test]
+fn unknown_native_local_or_call_result_does_not_invent_interval() {
+    let (mut f, value, join) = sample();
+    let native = local(&mut f, MirType::I64);
+    let no = Idx::from_raw(RawIdx::from_u32(2));
+    f.body.blocks[no].stmts = vec![Statement::Assign {
+        dest: value,
+        value: Rvalue::Box {
+            value: Operand::Local(native),
+            from: MirType::I64,
+        },
+    }];
+    let states = interval_facts::inputs(&f).unwrap();
+    assert!(!states[&join].ranges.contains_key(&value));
+    IntervalNarrow.run(&mut f);
+    assert_eq!(unboxes(&f), 0);
+    let (mut f, value, join) = sample();
+    f.body.blocks[join].stmts.insert(
+        0,
+        Statement::Assign {
+            dest: value,
+            value: Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::LoadName),
+                args: vec![
+                    Operand::Const(Constant::Null),
+                    Operand::Const(Constant::Str("unknown".into())),
+                ],
+            },
+        },
+    );
+    IntervalNarrow.run(&mut f);
+    assert_eq!(unboxes(&f), 0);
+}
diff --git a/crates/ryupy-mir/src/passes/leaf_inline.rs b/crates/ryupy-mir/src/passes/leaf_inline.rs
new file mode 100644
index 0000000..386ddb6
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/leaf_inline.rs
@@ -0,0 +1,150 @@
+//! 有预算的调用点特化：模块槽来源只用于预测，原函数的不可变身份锚点才是正确性守卫。
+//! 默认只选择调用前全部实参已有must精确Int64证明的位置，未知/bool不额外添加guard开销。
+//! 每目标最多一个纯叶摘要、每函数四处、每模块三十二处和八个目标；失败保留完整动态调用。
+use super::{ProgramPass, leaf_inline_expand, leaf_inline_summary};
+use crate::mir::*;
+use rustc_hash::FxHashMap;
+
+pub struct LeafInline;
+impl ProgramPass for LeafInline {
+    fn name(&self) -> &'static str {
+        "guarded_leaf_inline"
+    }
+    fn run(&self, program: &mut Program) {
+        let leaves: Vec<_> = program
+            .functions
+            .iter()
+            .filter_map(|(id, f)| leaf_inline_summary::summarize(id, f))
+            .take(8)
+            .collect();
+        if leaves.is_empty() {
+            return;
+        }
+        let mut globals: FxHashMap<GlobalId, usize> = leaves
+            .iter()
+            .enumerate()
+            .map(|(i, l)| (l.global, i))
+            .collect();
+        // 有界传播只发现已赋过原函数的别名，不将其视为不变事实；后续未知写入仍由身份guard兜底。
+        for _ in 0..8 {
+            let mut changed = false;
+            for (_, f) in program.functions.iter() {
+                for (_, b) in f.body.blocks.iter() {
+                    let mut locals: FxHashMap<LocalId, usize> = FxHashMap::default();
+                    for stmt in &b.stmts {
+                        if let Statement::SetGlobal { dest, value } = stmt
+                            && let Some(which) = origin(value, &locals, &globals)
+                            && !globals.contains_key(dest)
+                        {
+                            globals.insert(*dest, which);
+                            changed = true;
+                        }
+                        transfer(stmt, &mut locals, &globals);
+                    }
+                }
+            }
+            if !changed {
+                break;
+            }
+        }
+        let mut budget = 32;
+        let mut anchors = FxHashMap::default();
+        let ids: Vec<_> = program.functions.iter().map(|(id, _)| id).collect();
+        for id in ids {
+            let f = &program.functions[id];
+            if f.signature_global.is_none()
+                || f.env.is_some()
+                || !f.body.regions.is_empty()
+                || f.body.locals.iter().any(|(_, l)| l.is_cell)
+                || f.body.blocks.iter().any(|(_, b)| {
+                    matches!(b.terminator, Terminator::Suspend { .. })
+                        || b.stmts.iter().any(|s| {
+                            matches!(
+                                s,
+                                Statement::Assign {
+                                    value: Rvalue::MakeGenerator { .. },
+                                    ..
+                                }
+                            )
+                        })
+                })
+            {
+                continue;
+            }
+            // 先记录源调用的dest，展开新增块后再找位置，避免遍历新fallback重复特化。
+            let exact_sites = crate::exact_types::exact_call_sites(f);
+            let mut calls = Vec::new();
+            for (bb, b) in f.body.blocks.iter() {
+                let mut locals: FxHashMap<LocalId, usize> = FxHashMap::default();
+                for (position, stmt) in b.stmts.iter().enumerate() {
+                    if let Statement::Assign {
+                        dest,
+                        value:
+                            Rvalue::DynCallValue {
+                                callee: Operand::Local(callee),
+                                args,
+                            },
+                    } = stmt
+                        && let Some(&which) = locals.get(callee)
+                        && args.len() == leaves[which].arity
+                        && exact_sites.contains(&(bb, position))
+                    {
+                        calls.push((*dest, which));
+                    }
+                    transfer(stmt, &mut locals, &globals);
+                }
+            }
+            for (dest, which) in calls.into_iter().take(4) {
+                if budget == 0 {
+                    return;
+                }
+                let leaf = leaves[which];
+                let anchor = *anchors.entry(which).or_insert_with(|| {
+                    let slot = program.globals.alloc(GlobalDecl {
+                        name: format!("__leaf_identity_{}", leaf.function.into_raw()),
+                        ty: MirType::Dynamic,
+                    });
+                    program.functions[leaf.function].specialization_identity_global = Some(slot);
+                    slot
+                });
+                let f = &mut program.functions[id];
+                let found=f.body.blocks.iter().find_map(|(bb,b)| b.stmts.iter().position(|s|matches!(s,Statement::Assign{dest:d,value:Rvalue::DynCallValue{..}}if *d==dest)).map(|pos|(bb,pos)));
+                if let Some((bb, pos)) = found {
+                    leaf_inline_expand::expand(f, bb, pos, anchor, leaf);
+                    budget -= 1;
+                }
+            }
+        }
+    }
+}
+fn origin(
+    op: &Operand,
+    locals: &FxHashMap<LocalId, usize>,
+    globals: &FxHashMap<GlobalId, usize>,
+) -> Option<usize> {
+    match op {
+        Operand::Local(l) => locals.get(l).copied(),
+        Operand::Global(g) => globals.get(g).copied(),
+        _ => None,
+    }
+}
+fn transfer(
+    stmt: &Statement,
+    locals: &mut FxHashMap<LocalId, usize>,
+    globals: &FxHashMap<GlobalId, usize>,
+) {
+    if let Statement::Assign { dest, value } = stmt {
+        let source = match value {
+            Rvalue::Use(op) => origin(op, locals, globals),
+            Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::LoadName),
+                args,
+            } => args.first().and_then(|op| origin(op, locals, globals)),
+            _ => None,
+        };
+        locals.remove(dest);
+        if let Some(which) = source {
+            locals.insert(*dest, which);
+        }
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/leaf_inline_expand.rs b/crates/ryupy-mir/src/passes/leaf_inline_expand.rs
new file mode 100644
index 0000000..cd8e8bd
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/leaf_inline_expand.rs
@@ -0,0 +1,136 @@
+//! 在原调用点展开身份、精确类型和溢出守卫。成功执行有类型算术、递归深度检查与整数装箱；失败执行原调用。
+//! 不重读公开模块槽、不重新求参数，因而参数回调重绑定公开函数也不改变本次callee。
+use super::leaf_inline_summary::Leaf;
+use crate::mir::*;
+
+pub(super) fn expand(f: &mut Function, bb: BlockId, pos: usize, anchor: GlobalId, leaf: Leaf) {
+    let Statement::Assign {
+        dest,
+        value: Rvalue::DynCallValue { callee, args },
+    } = &f.body.blocks[bb].stmts[pos]
+    else {
+        return;
+    };
+    let (dest, callee, args) = (*dest, callee.clone(), args.clone());
+    let rest = f.body.blocks[bb].stmts.split_off(pos + 1);
+    f.body.blocks[bb].stmts.truncate(pos);
+    let term = std::mem::replace(&mut f.body.blocks[bb].terminator, Terminator::Unreachable);
+    let next = block(f, rest, term);
+    let saved_callee = local(f, MirType::Dynamic);
+    f.body.blocks[bb]
+        .stmts
+        .push(assign(saved_callee, Rvalue::Use(callee)));
+    let mut saved = Vec::new();
+    for arg in args {
+        let slot = local(f, MirType::Dynamic);
+        f.body.blocks[bb].stmts.push(assign(slot, Rvalue::Use(arg)));
+        saved.push(slot);
+    }
+    let fallback = block(
+        f,
+        vec![assign(
+            dest,
+            Rvalue::DynCallValue {
+                callee: get(saved_callee),
+                args: saved.iter().copied().map(get).collect(),
+            },
+        )],
+        Terminator::Goto(next),
+    );
+    let left = local(f, MirType::I64);
+    let right = local(f, MirType::I64);
+    let sum = local(f, MirType::I64);
+    let left_sign = local(f, MirType::I64);
+    let right_sign = local(f, MirType::I64);
+    let overflow = local(f, MirType::I64);
+    let safe = local(f, MirType::Bool);
+    let success = block(
+        f,
+        vec![
+            Statement::Eval(Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::TraceCheckDepth),
+                args: vec![],
+            }),
+            assign(
+                dest,
+                Rvalue::Box {
+                    value: get(sum),
+                    from: MirType::I64,
+                },
+            ),
+        ],
+        Terminator::Goto(next),
+    );
+    let calculation = block(
+        f,
+        vec![
+            assign(
+                left,
+                Rvalue::UnboxExactI64 {
+                    value: get(saved[leaf.left]),
+                },
+            ),
+            assign(
+                right,
+                Rvalue::UnboxExactI64 {
+                    value: get(saved[leaf.right]),
+                },
+            ),
+            binary(sum, BinOp::WrappingAdd, get(left), get(right)),
+            binary(left_sign, BinOp::BitXor, get(left), get(sum)),
+            binary(right_sign, BinOp::BitXor, get(right), get(sum)),
+            binary(overflow, BinOp::BitAnd, get(left_sign), get(right_sign)),
+            binary(
+                safe,
+                BinOp::Ge,
+                get(overflow),
+                Operand::Const(Constant::I64(0)),
+            ),
+        ],
+        branch(safe, success, fallback),
+    );
+    let mut guarded = calculation;
+    for arg in saved.into_iter().rev() {
+        let condition = local(f, MirType::Bool);
+        guarded = block(
+            f,
+            vec![assign(condition, Rvalue::IsBoxedI64 { value: get(arg) })],
+            branch(condition, guarded, fallback),
+        );
+    }
+    let same = local(f, MirType::Bool);
+    // Binary Eq在Dynamic上是CLR引用ceq，不调用Python __eq__；锚点从不由Python写入。
+    f.body.blocks[bb].stmts.push(binary(
+        same,
+        BinOp::Eq,
+        get(saved_callee),
+        Operand::Global(anchor),
+    ));
+    f.body.blocks[bb].terminator = branch(same, guarded, fallback);
+}
+fn local(f: &mut Function, ty: MirType) -> LocalId {
+    f.body.locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn block(f: &mut Function, stmts: Vec<Statement>, terminator: Terminator) -> BlockId {
+    f.body.blocks.alloc(BasicBlock { stmts, terminator })
+}
+fn get(id: LocalId) -> Operand {
+    Operand::Local(id)
+}
+fn assign(dest: LocalId, value: Rvalue) -> Statement {
+    Statement::Assign { dest, value }
+}
+fn binary(dest: LocalId, op: BinOp, lhs: Operand, rhs: Operand) -> Statement {
+    assign(dest, Rvalue::Binary { op, lhs, rhs })
+}
+fn branch(cond: LocalId, then_: BlockId, else_: BlockId) -> Terminator {
+    Terminator::Branch {
+        cond: get(cond),
+        then_,
+        else_,
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/leaf_inline_summary.rs b/crates/ryupy-mir/src/passes/leaf_inline_summary.rs
new file mode 100644
index 0000000..d5e28a0
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/leaf_inline_summary.rs
@@ -0,0 +1,137 @@
+//! 纯叶摘要只解释可证明的参数复制与一次普通加法；未知操作立即放弃，不猜注解。
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+#[derive(Clone, Copy)]
+pub(super) struct Leaf {
+    pub function: FnId,
+    pub global: GlobalId,
+    pub arity: usize,
+    pub left: usize,
+    pub right: usize,
+}
+#[derive(Clone, Copy)]
+enum Value {
+    Param(usize),
+    Sum,
+}
+
+pub(super) fn summarize(id: FnId, f: &Function) -> Option<Leaf> {
+    let global = f.function_global?;
+    if !(1..=2).contains(&f.params.len())
+        || f.ret != MirType::Dynamic
+        || f.env.is_some()
+        || !f.body.regions.is_empty()
+        || f.defaults_global.is_none()
+        || f.signature_global.is_none()
+        || f.param_meta.len() != f.params.len()
+        || f.param_meta.iter().any(|p| {
+            p.has_default
+                || !matches!(
+                    p.kind,
+                    ParamKind::PositionalOnly | ParamKind::PositionalOrKeyword
+                )
+        })
+        || f.body.locals.iter().any(|(_, l)| l.is_cell)
+        || f.params
+            .iter()
+            .any(|p| f.body.locals[*p].ty != MirType::Dynamic)
+    {
+        return None;
+    }
+    let mut values: FxHashMap<_, _> = f
+        .params
+        .iter()
+        .enumerate()
+        .map(|(i, p)| (*p, Value::Param(i)))
+        .collect();
+    let mut visited = FxHashSet::default();
+    let mut next = f.body.entry;
+    let mut addition = None;
+    let mut trace = None;
+    let mut popped = false;
+    let mut statements = 0;
+    loop {
+        if !visited.insert(next) {
+            return None;
+        }
+        let b = &f.body.blocks[next];
+        for stmt in &b.stmts {
+            statements += 1;
+            if statements > 32 {
+                return None;
+            }
+            match stmt {
+                Statement::Line(_) if !popped => {}
+                Statement::Assign {
+                    dest,
+                    value:
+                        Rvalue::Call {
+                            callee: Callee::Runtime(RuntimeFn::TracePush),
+                            args,
+                        },
+                } if trace.is_none()
+                    && addition.is_none()
+                    && args.len() == 2
+                    && args
+                        .iter()
+                        .all(|a| matches!(a, Operand::Const(Constant::Str(_)))) =>
+                {
+                    // TracePush也写局部：不能沿用该槽之前的参数/求和值事实。
+                    values.remove(dest);
+                    trace = Some(*dest);
+                }
+                Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::TracePopTo),
+                    args,
+                }) if !popped
+                    && matches!(args.as_slice(), [Operand::Local(value)] if Some(*value)==trace) =>
+                {
+                    popped = true;
+                }
+                Statement::Assign {
+                    dest,
+                    value: Rvalue::Use(Operand::Local(src)),
+                } if !popped && Some(*dest) != trace => {
+                    let value = *values.get(src)?;
+                    values.insert(*dest, value);
+                }
+                Statement::Assign {
+                    dest,
+                    value:
+                        Rvalue::DynBinary {
+                            op: DynOp::Add,
+                            lhs: Operand::Local(lhs),
+                            rhs: Operand::Local(rhs),
+                            inplace: false,
+                        },
+                } if addition.is_none() && !popped && Some(*dest) != trace => {
+                    let (Value::Param(left), Value::Param(right)) =
+                        (*values.get(lhs)?, *values.get(rhs)?)
+                    else {
+                        return None;
+                    };
+                    addition = Some((left, right));
+                    values.insert(*dest, Value::Sum);
+                }
+                _ => return None,
+            }
+        }
+        match b.terminator {
+            Terminator::Goto(target) => next = target,
+            Terminator::Return(Some(Operand::Local(result)))
+                if popped && matches!(values.get(&result), Some(Value::Sum)) =>
+            {
+                let (left, right) = addition?;
+                return Some(Leaf {
+                    function: id,
+                    global,
+                    arity: f.params.len(),
+                    left,
+                    right,
+                });
+            }
+            _ => return None,
+        }
+    }
+}
diff --git a/crates/ryupy-mir/src/passes/leaf_inline_tests.rs b/crates/ryupy-mir/src/passes/leaf_inline_tests.rs
new file mode 100644
index 0000000..dd072d7
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/leaf_inline_tests.rs
@@ -0,0 +1,375 @@
+//! 叶摘要、调用点预算与不可变身份槽的结构回归；运行时语义另由真实源码差分覆盖。
+use super::{ProgramPass, leaf_inline::LeafInline};
+use crate::mir::*;
+use la_arena::Arena;
+
+fn local(f: &mut Function, ty: MirType) -> LocalId {
+    f.body.locals.alloc(LocalDecl {
+        ty,
+        name: None,
+        is_cell: false,
+    })
+}
+fn assign(dest: LocalId, value: Rvalue) -> Statement {
+    Statement::Assign { dest, value }
+}
+fn get(id: LocalId) -> Operand {
+    Operand::Local(id)
+}
+fn call(runtime: RuntimeFn, args: Vec<Operand>) -> Rvalue {
+    Rvalue::Call {
+        callee: Callee::Runtime(runtime),
+        args,
+    }
+}
+fn empty(name: &str) -> Function {
+    let mut blocks = Arena::default();
+    let entry = blocks.alloc(BasicBlock {
+        stmts: vec![],
+        terminator: Terminator::Return(None),
+    });
+    Function {
+        name: name.into(),
+        codegen_name: name.into(),
+        source_file: "leaf.py".into(),
+        params: vec![],
+        ret: MirType::Dynamic,
+        body: Body {
+            locals: Arena::default(),
+            blocks,
+            entry,
+            regions: vec![],
+        },
+        param_meta: vec![],
+        function_global: None,
+        specialization_identity_global: None,
+        defaults_global: None,
+        signature_global: None,
+        env: None,
+    }
+}
+fn sample(calls: usize) -> (Program, FnId, FnId) {
+    let mut globals = Arena::default();
+    let mut slot = || {
+        globals.alloc(GlobalDecl {
+            name: "slot".into(),
+            ty: MirType::Dynamic,
+        })
+    };
+    let fg = slot();
+    let defaults = slot();
+    let sig = slot();
+    let alias = slot();
+    let caller_sig = slot();
+    let mut leaf = empty("twice");
+    leaf.function_global = Some(fg);
+    leaf.defaults_global = Some(defaults);
+    leaf.signature_global = Some(sig);
+    let param = local(&mut leaf, MirType::Dynamic);
+    leaf.params.push(param);
+    leaf.param_meta.push(ParamMeta {
+        name: "value".into(),
+        kind: ParamKind::PositionalOrKeyword,
+        has_default: false,
+        ty: MirType::Dynamic,
+    });
+    let depth = local(&mut leaf, MirType::I64);
+    let result = local(&mut leaf, MirType::Dynamic);
+    let b = &mut leaf.body.blocks[leaf.body.entry];
+    b.stmts = vec![
+        assign(
+            depth,
+            call(
+                RuntimeFn::TracePush,
+                vec![
+                    Operand::Const(Constant::Str("leaf.py".into())),
+                    Operand::Const(Constant::Str("twice".into())),
+                ],
+            ),
+        ),
+        Statement::Line(2),
+        assign(
+            result,
+            Rvalue::DynBinary {
+                op: DynOp::Add,
+                lhs: get(param),
+                rhs: get(param),
+                inplace: false,
+            },
+        ),
+        Statement::Eval(call(RuntimeFn::TracePopTo, vec![get(depth)])),
+    ];
+    b.terminator = Terminator::Return(Some(get(result)));
+    let mut caller = empty("invoke");
+    caller.signature_global = Some(caller_sig);
+    let arg = local(&mut caller, MirType::Dynamic);
+    caller.params.push(arg);
+    let callee = local(&mut caller, MirType::Dynamic);
+    let value = local(&mut caller, MirType::Dynamic);
+    let mut statements = vec![
+        Statement::SetGlobal {
+            dest: alias,
+            value: Operand::Global(fg),
+        },
+        assign(
+            callee,
+            call(
+                RuntimeFn::LoadName,
+                vec![
+                    Operand::Global(alias),
+                    Operand::Const(Constant::Str("alias".into())),
+                ],
+            ),
+        ),
+    ];
+    statements.push(assign(
+        arg,
+        Rvalue::Box {
+            value: Operand::Const(Constant::I64(7)),
+            from: MirType::I64,
+        },
+    ));
+    for _ in 0..calls {
+        let result = local(&mut caller, MirType::Dynamic);
+        statements.push(assign(
+            result,
+            Rvalue::DynCallValue {
+                callee: get(callee),
+                args: vec![get(arg)],
+            },
+        ));
+    }
+    statements.push(assign(value, Rvalue::Use(get(arg))));
+    caller.body.blocks[caller.body.entry].stmts = statements;
+    caller.body.blocks[caller.body.entry].terminator = Terminator::Return(Some(get(value)));
+    let mut functions = Arena::default();
+    let leaf = functions.alloc(leaf);
+    let caller = functions.alloc(caller);
+    (
+        Program {
+            functions,
+            globals,
+            classes: Arena::default(),
+            entry: caller,
+            source_name: "leaf.py".into(),
+        },
+        leaf,
+        caller,
+    )
+}
+fn wraps(f: &Function) -> usize {
+    f.body
+        .blocks
+        .iter()
+        .flat_map(|(_, b)| &b.stmts)
+        .filter(|s| {
+            matches!(
+                s,
+                Statement::Assign {
+                    value: Rvalue::Binary {
+                        op: BinOp::WrappingAdd,
+                        ..
+                    },
+                    ..
+                }
+            )
+        })
+        .count()
+}
+#[test]
+fn guard_uses_new_immutable_anchor_and_keeps_original_call() {
+    let (mut p, leaf, caller) = sample(1);
+    LeafInline.run(&mut p);
+    let anchor = p.functions[leaf].specialization_identity_global.unwrap();
+    assert_ne!(Some(anchor), p.functions[leaf].function_global);
+    assert_eq!(wraps(&p.functions[caller]), 1);
+    assert!(
+        p.functions[caller]
+            .body
+            .blocks
+            .iter()
+            .flat_map(|(_, b)| &b.stmts)
+            .any(|s| matches!(
+                s,
+                Statement::Assign {
+                    value: Rvalue::DynCallValue { .. },
+                    ..
+                }
+            ))
+    );
+    crate::validate::validate(&p).unwrap();
+}
+#[test]
+fn default_and_non_leaf_bodies_do_not_get_guessed() {
+    for change in 0..5 {
+        let (mut p, leaf, caller) = sample(1);
+        let f = &mut p.functions[leaf];
+        match change {
+            0 => f.param_meta[0].has_default = true,
+            1 => f.param_meta[0].kind = ParamKind::KeywordOnly,
+            2 => f.body.locals[f.params[0]].is_cell = true,
+            3 => f.env = Some(f.params[0]),
+            _ => f.body.blocks[f.body.entry].stmts.insert(
+                1,
+                Statement::Eval(call(
+                    RuntimeFn::TracePopTo,
+                    vec![Operand::Const(Constant::I64(0))],
+                )),
+            ),
+        }
+        LeafInline.run(&mut p);
+        assert_eq!(wraps(&p.functions[caller]), 0);
+    }
+}
+#[test]
+fn per_function_budget_is_four_and_fallback_is_not_revisited() {
+    let (mut p, leaf, caller) = sample(6);
+    LeafInline.run(&mut p);
+    assert_eq!(wraps(&p.functions[caller]), 4);
+    assert!(p.functions[leaf].specialization_identity_global.is_some());
+    crate::validate::validate(&p).unwrap();
+}
+#[test]
+fn identity_slots_cannot_be_written_reused_or_exported() {
+    for variant in 0..4 {
+        let (mut p, leaf, caller) = sample(1);
+        LeafInline.run(&mut p);
+        let anchor = p.functions[leaf].specialization_identity_global.unwrap();
+        match variant {
+            0 => {
+                let f = &mut p.functions[caller];
+                f.body.blocks[f.body.entry]
+                    .stmts
+                    .push(Statement::SetGlobal {
+                        dest: anchor,
+                        value: Operand::Const(Constant::Null),
+                    });
+            }
+            1 => {
+                p.functions[leaf].specialization_identity_global = p.functions[leaf].function_global
+            }
+            2 => p.functions[leaf].defaults_global = None,
+            _ => p.globals[anchor].ty = MirType::I64,
+        }
+        assert!(
+            crate::validate::validate(&p)
+                .unwrap_err()
+                .iter()
+                .any(|e| e.contains("身份锚点"))
+        );
+    }
+    let (mut p, leaf, _) = sample(1);
+    LeafInline.run(&mut p);
+    let anchor = p.functions[leaf].specialization_identity_global.unwrap();
+    let linked = crate::link(
+        vec![(
+            p,
+            crate::UnitMeta {
+                name: "test".into(),
+                package: "".into(),
+                file: "test.py".into(),
+                protected_exports: vec![],
+                exports: vec![ModuleExport {
+                    name: "leak".into(),
+                    value: anchor,
+                    guard: ExportGuard::ValueSentinel,
+                }],
+            },
+        )],
+        0,
+    );
+    assert!(
+        crate::validate::validate_linked_exports(&linked)
+            .unwrap_err()
+            .iter()
+            .any(|e| e.contains("身份锚点"))
+    );
+}
+
+#[test]
+fn recursion_check_is_only_on_success_and_has_void_zero_argument_abi() {
+    let (mut p, _, caller) = sample(1);
+    LeafInline.run(&mut p);
+    let f = &p.functions[caller];
+    let checks:Vec<_>=f.body.blocks.iter().filter(|(_,b)|b.stmts.iter().any(|s|matches!(s,Statement::Eval(Rvalue::Call{callee:Callee::Runtime(RuntimeFn::TraceCheckDepth),args})if args.is_empty()))).collect();
+    assert_eq!(checks.len(), 1);
+    assert!(matches!(
+        checks[0].1.stmts.get(1),
+        Some(Statement::Assign {
+            value: Rvalue::Box { .. },
+            ..
+        })
+    ));
+    let bb = checks[0].0;
+    p.functions[caller].body.blocks[bb].stmts[0] = Statement::Eval(call(
+        RuntimeFn::TraceCheckDepth,
+        vec![Operand::Const(Constant::I64(0))],
+    ));
+    assert!(
+        crate::validate::validate(&p)
+            .unwrap_err()
+            .iter()
+            .any(|e| e.contains("递归深度检查ABI"))
+    );
+}
+
+#[test]
+fn unknown_or_boolean_arguments_keep_original_call_without_anchor() {
+    for boolean in [false, true] {
+        let (mut p, leaf, caller) = sample(1);
+        let f = &mut p.functions[caller];
+        let arg = f.params[0];
+        if boolean {
+            for stmt in &mut f.body.blocks[f.body.entry].stmts {
+                if let Statement::Assign { dest, value } = stmt
+                    && *dest == arg
+                {
+                    *value = Rvalue::Box {
+                        value: Operand::Const(Constant::Bool(true)),
+                        from: MirType::Bool,
+                    };
+                }
+            }
+        } else {
+            f.body.blocks[f.body.entry]
+                .stmts
+                .retain(|s| !matches!(s,Statement::Assign{dest,..}if *dest==arg));
+        }
+        LeafInline.run(&mut p);
+        assert_eq!(wraps(&p.functions[caller]), 0);
+        assert!(p.functions[leaf].specialization_identity_global.is_none());
+    }
+}
+
+#[test]
+fn pipeline_experiments_are_independent_and_default_leaf_is_off() {
+    for direct in [false, true] {
+        for leaf in [false, true] {
+            let passes = super::pipeline_with_options(direct, leaf);
+            assert_eq!(
+                passes.iter().any(|p| p.name() == "guarded_leaf_inline"),
+                leaf
+            );
+            assert_eq!(
+                passes
+                    .iter()
+                    .any(|p| p.name() == "direct_numeric_accumulator_experimental"),
+                direct
+            );
+            assert_eq!(
+                passes.iter().any(|p| p.name() == "numeric_accumulator"),
+                !direct
+            );
+        }
+    }
+    assert!(
+        !super::default_pipeline()
+            .iter()
+            .any(|p| p.name() == "guarded_leaf_inline")
+    );
+    assert!(
+        !super::pipeline_with_direct_accumulator(true)
+            .iter()
+            .any(|p| p.name() == "guarded_leaf_inline")
+    );
+}
