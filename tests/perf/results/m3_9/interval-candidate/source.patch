@@ -0,0 +1,200 @@
+//! 累加器严格候选识别：不因表示从holder变为局部而放宽身份/异常/逃逸条件。
+use super::dead_values::{read_operand, read_value};
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+pub(super) struct Plan {
+    pub(super) preheader: BlockId,
+    pub(super) body: BlockId,
+    pub(super) exit: BlockId,
+    pub(super) update: usize,
+    pub(super) total: LocalId,
+    pub(super) rhs: Operand,
+}
+
+pub(super) fn candidate(
+    function: &Function,
+    header: BlockId,
+    predecessors: &FxHashMap<BlockId, Vec<BlockId>>,
+) -> Option<Plan> {
+    let Terminator::Branch {
+        then_: body,
+        else_: exit,
+        ..
+    } = &function.body.blocks[header].terminator
+    else {
+        return None;
+    };
+    let (body, exit) = (*body, *exit);
+    let Terminator::Goto(latch) = function.body.blocks[body].terminator else {
+        return None;
+    };
+    if !matches!(function.body.blocks[latch].terminator, Terminator::Goto(target) if target == header)
+    {
+        return None;
+    }
+    let incoming = predecessors.get(&header)?;
+    if incoming.len() != 2 || !incoming.contains(&latch) {
+        return None;
+    }
+    let preheader = *incoming.iter().find(|&&block| block != latch)?;
+    if preheader != function.body.entry
+        || !predecessors.get(&preheader)?.is_empty()
+        || !matches!(function.body.blocks[preheader].terminator, Terminator::Goto(target) if target == header)
+    {
+        return None;
+    }
+    if [preheader, header, body, latch, exit]
+        .into_iter()
+        .collect::<FxHashSet<_>>()
+        .len()
+        != 5
+        || function.body.entry == header
+        || function.body.entry == body
+        || function.body.entry == latch
+        || function.body.entry == exit
+        || predecessors.get(&body)?.as_slice() != [header]
+        || predecessors.get(&latch)?.as_slice() != [body]
+        || predecessors.get(&exit)?.as_slice() != [header]
+    {
+        return None;
+    }
+    let statements = &function.body.blocks[body].stmts;
+    for (update, pair) in statements.windows(2).enumerate() {
+        let Statement::Assign {
+            dest: temporary,
+            value:
+                Rvalue::DynBinary {
+                    op: DynOp::Add,
+                    lhs: Operand::Local(total),
+                    rhs,
+                    inplace: true,
+                },
+        } = &pair[0]
+        else {
+            continue;
+        };
+        if !matches!(&pair[1], Statement::Assign { dest, value: Rvalue::Use(Operand::Local(source)) }
+            if dest == total && source == temporary)
+        {
+            continue;
+        }
+        let local = &function.body.locals[*total];
+        if local.is_cell
+            || local.name.is_none()
+            || local.ty != MirType::Dynamic
+            || statements[update + 2..]
+                .iter()
+                .any(|statement| !matches!(statement, Statement::Line(_)))
+        {
+            continue;
+        }
+        // 入口必须已经直接赋值；不提前执行可能未绑定的读，也不处理LoadChecked(total)模式。
+        if !function.body.blocks[preheader]
+            .stmts
+            .iter()
+            .any(|statement| matches!(statement, Statement::Assign { dest, .. } if dest == total))
+        {
+            continue;
+        }
+        let mut rhs_reads = FxHashSet::default();
+        read_operand(rhs, &mut rhs_reads);
+        if rhs_reads.contains(total) {
+            continue;
+        }
+        let loop_blocks = [header, body, latch];
+        let (mut total_reads, mut total_writes, mut temporary_reads, mut temporary_writes) =
+            (0, 0, 0, 0);
+        for (id, block) in function.body.blocks.iter() {
+            for statement in &block.stmts {
+                let reads = statement_reads(statement);
+                temporary_reads += usize::from(reads.contains(temporary));
+                if let Statement::Assign { dest, .. } = statement {
+                    temporary_writes += usize::from(dest == temporary);
+                    if loop_blocks.contains(&id) {
+                        total_writes += usize::from(dest == total);
+                    }
+                }
+                if loop_blocks.contains(&id) {
+                    total_reads += usize::from(reads.contains(total));
+                }
+            }
+            let reads = terminator_reads(&block.terminator);
+            temporary_reads += usize::from(reads.contains(temporary));
+            if loop_blocks.contains(&id) {
+                total_reads += usize::from(reads.contains(total));
+            }
+        }
+        if total_reads == 1 && total_writes == 1 && temporary_reads == 1 && temporary_writes == 1 {
+            return Some(Plan {
+                preheader,
+                body,
+                exit,
+                update,
+                total: *total,
+                rhs: rhs.clone(),
+            });
+        }
+    }
+    None
+}
+
+pub(super) fn predecessors(function: &Function) -> FxHashMap<BlockId, Vec<BlockId>> {
+    let mut result: FxHashMap<_, Vec<_>> = function
+        .body
+        .blocks
+        .iter()
+        .map(|(id, _)| (id, vec![]))
+        .collect();
+    for (id, block) in function.body.blocks.iter() {
+        let destinations = match &block.terminator {
+            Terminator::Goto(target) | Terminator::Suspend { resume: target, .. } => vec![*target],
+            Terminator::Branch { then_, else_, .. } => vec![*then_, *else_],
+            Terminator::Return(_) | Terminator::Raise { .. } | Terminator::Unreachable => vec![],
+        };
+        for target in destinations {
+            if let Some(incoming) = result.get_mut(&target) {
+                incoming.push(id);
+            }
+        }
+    }
+    result
+}
+
+fn statement_reads(statement: &Statement) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match statement {
+        Statement::Assign { value, .. } | Statement::Eval(value) => read_value(value, &mut reads),
+        Statement::SetField { obj, value, .. } => {
+            read_operand(obj, &mut reads);
+            read_operand(value, &mut reads);
+        }
+        Statement::SetGlobal { value, .. } => read_operand(value, &mut reads),
+        Statement::Line(_) => {}
+    }
+    reads
+}
+fn terminator_reads(terminator: &Terminator) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match terminator {
+        Terminator::Branch { cond, .. } => read_operand(cond, &mut reads),
+        Terminator::Suspend { value, input, .. } => {
+            read_operand(value, &mut reads);
+            if let Some(input) = input {
+                reads.insert(*input);
+            }
+        }
+        Terminator::Return(value) => {
+            if let Some(value) = value {
+                read_operand(value, &mut reads);
+            }
+        }
+        Terminator::Raise { value, cause } => {
+            for operand in value.iter().chain(cause.iter()) {
+                read_operand(operand, &mut reads);
+            }
+        }
+        Terminator::Goto(_) | Terminator::Unreachable => {}
+    }
+    reads
+}
diff --git a/crates/ryupy-mir/src/passes/tuple_scalar.rs b/crates/ryupy-mir/src/passes/tuple_scalar.rs
new file mode 100644
index 0000000..1d372ac
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/tuple_scalar.rs
@@ -0,0 +1,330 @@
+//! 小型新鲜 tuple 的同块标量替换：只消除没有别名、逃逸或身份观察的构造。
+//!
+//! 元素在原构造点冻结到新的动态局部，不能在读取时重读已改写的源变量。
+//! 固定下标必须有同块、在使用之前的唯一常量定义；不做跨块 SSA 或用户类型推测。
+use super::MirPass;
+use super::dead_values::{read_operand, read_value};
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+pub struct TupleScalar;
+const MAX_ITEMS: usize = 8;
+const MAX_ATTEMPTS: usize = 32;
+
+struct Plan {
+    block: BlockId,
+    position: usize,
+    elements: Vec<Operand>,
+    reads: Vec<(usize, usize)>,
+    lengths: Vec<usize>,
+    checks: FxHashSet<usize>,
+}
+
+impl MirPass for TupleScalar {
+    fn name(&self) -> &'static str {
+        "tuple_scalar"
+    }
+
+    fn run(&self, function: &mut Function) {
+        // 合成 resume 没有 signature；工厂有 MakeGenerator。模块、闭包和 EH 首版保守不动。
+        if function.signature_global.is_none()
+            || function.env.is_some()
+            || !function.body.regions.is_empty()
+            || function.body.locals.iter().any(|(_, local)| local.is_cell)
+            || function.body.blocks.iter().any(|(_, block)| {
+                matches!(block.terminator, Terminator::Suspend { .. })
+                    || block.stmts.iter().any(|stmt| {
+                        matches!(
+                            stmt,
+                            Statement::Assign {
+                                value: Rvalue::MakeGenerator { .. },
+                                ..
+                            } | Statement::Eval(Rvalue::MakeGenerator { .. })
+                        )
+                    })
+            })
+        {
+            return;
+        }
+        // 预算计所有尝试而非仅成功改写：全部逃逸的输入也最多作 32 次全函数扫描。
+        // 先保留源序候选的稳定 dest；每轮重建位置，避免插入快照后复用旧下标。
+        let candidates: Vec<_> = function
+            .body
+            .blocks
+            .iter()
+            .flat_map(|(_, body)| &body.stmts)
+            .filter_map(|stmt| match stmt {
+                Statement::Assign {
+                    dest,
+                    value:
+                        Rvalue::CallWithArgs {
+                            callee: RuntimeFn::MakeTuple,
+                            ..
+                        },
+                } => Some(*dest),
+                _ => None,
+            })
+            .take(MAX_ATTEMPTS)
+            .collect();
+        for dest in candidates {
+            let definitions = definitions(function);
+            let Some(positions) = definitions.get(&dest) else {
+                continue;
+            };
+            let [(block, position)] = positions.as_slice() else {
+                continue;
+            };
+            let statement = &function.body.blocks[*block].stmts[*position];
+            if let Some(plan) = candidate(function, &definitions, *block, *position, statement) {
+                expand(function, plan);
+            }
+        }
+    }
+}
+
+type Definitions = FxHashMap<LocalId, Vec<(BlockId, usize)>>;
+fn definitions(function: &Function) -> Definitions {
+    let mut definitions = Definitions::default();
+    for (block, body) in function.body.blocks.iter() {
+        for (position, stmt) in body.stmts.iter().enumerate() {
+            if let Statement::Assign { dest, .. } = stmt {
+                definitions
+                    .entry(*dest)
+                    .or_default()
+                    .push((block, position));
+            }
+        }
+    }
+    definitions
+}
+
+fn candidate(
+    function: &Function,
+    definitions: &Definitions,
+    block: BlockId,
+    position: usize,
+    statement: &Statement,
+) -> Option<Plan> {
+    let Statement::Assign {
+        dest,
+        value:
+            Rvalue::CallWithArgs {
+                callee: RuntimeFn::MakeTuple,
+                prefix,
+                args,
+            },
+    } = statement
+    else {
+        return None;
+    };
+    if !prefix.is_empty()
+        || args.len() > MAX_ITEMS
+        || function.params.contains(dest)
+        || function.body.locals[*dest].name.is_some()
+        || definitions.get(dest)?.as_slice() != [(block, position)]
+        || args.iter().any(|arg| {
+            !matches!(arg,
+            Operand::Local(local) if function.body.locals[*local].ty == MirType::Dynamic)
+        })
+    {
+        return None;
+    }
+    let mut plan = Plan {
+        block,
+        position,
+        elements: args.clone(),
+        reads: vec![],
+        lengths: vec![],
+        checks: FxHashSet::default(),
+    };
+    for (id, body) in function.body.blocks.iter() {
+        if terminator_reads(&body.terminator).contains(dest) {
+            return None;
+        }
+        for (index, stmt) in body.stmts.iter().enumerate() {
+            if !statement_reads(stmt).contains(dest) {
+                continue;
+            }
+            if id != block || index <= position {
+                return None;
+            }
+            let Statement::Assign {
+                value:
+                    Rvalue::Call {
+                        callee: Callee::Runtime(callee),
+                        args,
+                    },
+                ..
+            } = stmt
+            else {
+                return None;
+            };
+            match (callee, args.as_slice()) {
+                (RuntimeFn::Len, [Operand::Local(source)]) if source == dest => {
+                    plan.lengths.push(index);
+                }
+                (RuntimeFn::GetItem, [Operand::Local(source), key]) if source == dest => {
+                    let key = constant_index(function, definitions, block, index, key)?;
+                    let normalized = if key < 0 {
+                        key.checked_add(plan.elements.len() as i64)?
+                    } else {
+                        key
+                    };
+                    if normalized < 0 || normalized >= plan.elements.len() as i64 {
+                        return None;
+                    }
+                    plan.reads.push((index, normalized as usize));
+                }
+                _ => return None,
+            }
+        }
+    }
+    // 无使用也可以删分配，但首切只处理明确存在长度/下标消费者的候选。
+    if plan.reads.is_empty() && plan.lengths.is_empty() {
+        return None;
+    }
+    // 唯一 Len 定义一次建表，不能为每个长度再扫描整块（重复 len 可达平方成本）。
+    let mut known_lengths = FxHashMap::default();
+    for &length_position in &plan.lengths {
+        let Statement::Assign { dest: length, .. } =
+            &function.body.blocks[block].stmts[length_position]
+        else {
+            continue;
+        };
+        if definitions.get(length)?.as_slice() == [(block, length_position)] {
+            known_lengths.insert(*length, length_position);
+        }
+    }
+    for (index, stmt) in function.body.blocks[block].stmts.iter().enumerate() {
+        if let Statement::Eval(Rvalue::Call {
+            callee: Callee::Runtime(RuntimeFn::UnpackCheck),
+            args,
+        }) = stmt
+            && let [
+                Operand::Local(actual),
+                Operand::Const(Constant::I64(required)),
+                Operand::Const(Constant::Bool(star)),
+            ] = args.as_slice()
+            && known_lengths
+                .get(actual)
+                .is_some_and(|position| *position < index)
+            && *required >= 0
+            && (if *star {
+                plan.elements.len() as i64 >= *required
+            } else {
+                plan.elements.len() as i64 == *required
+            })
+        {
+            plan.checks.insert(index);
+        }
+    }
+    Some(plan)
+}
+
+fn constant_index(
+    function: &Function,
+    definitions: &Definitions,
+    block: BlockId,
+    before: usize,
+    key: &Operand,
+) -> Option<i64> {
+    let Operand::Local(key) = key else {
+        return None;
+    };
+    if function.params.contains(key) {
+        return None;
+    }
+    let [(defined_block, defined_position)] = definitions.get(key)?.as_slice() else {
+        return None;
+    };
+    if *defined_block != block || *defined_position >= before {
+        return None;
+    }
+    // 只接字面常量，不沿可重绑定源局部传播，不把 __index__ 调用误当纯取值。
+    match &function.body.blocks[block].stmts[*defined_position] {
+        Statement::Assign {
+            value:
+                Rvalue::Box {
+                    value: Operand::Const(Constant::I64(index)),
+                    from: MirType::I64,
+                },
+            ..
+        } => Some(*index),
+        _ => None,
+    }
+}
+
+fn expand(function: &mut Function, plan: Plan) {
+    let mut snapshots = Vec::new();
+    let mut stores = Vec::new();
+    for value in plan.elements.iter().cloned() {
+        let dest = function.body.locals.alloc(LocalDecl {
+            ty: MirType::Dynamic,
+            name: None,
+            is_cell: false,
+        });
+        snapshots.push(dest);
+        stores.push(Statement::Assign {
+            dest,
+            value: Rvalue::Use(value),
+        });
+    }
+    let body = &mut function.body.blocks[plan.block];
+    for (position, element) in plan.reads {
+        if let Statement::Assign { value, .. } = &mut body.stmts[position] {
+            *value = Rvalue::Use(Operand::Local(snapshots[element]));
+        }
+    }
+    for position in plan.lengths {
+        if let Statement::Assign { value, .. } = &mut body.stmts[position] {
+            *value = Rvalue::Use(Operand::Const(Constant::I64(plan.elements.len() as i64)));
+        }
+    }
+    // 保留原语句位置/行号；失败的 UnpackCheck 未删除，仍先于任何目标写入。
+    let original = std::mem::take(&mut body.stmts);
+    for (index, stmt) in original.into_iter().enumerate() {
+        if index == plan.position {
+            body.stmts.append(&mut stores);
+        } else if !plan.checks.contains(&index) {
+            body.stmts.push(stmt);
+        }
+    }
+}
+
+fn statement_reads(statement: &Statement) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match statement {
+        Statement::Assign { value, .. } | Statement::Eval(value) => read_value(value, &mut reads),
+        Statement::SetField { obj, value, .. } => {
+            read_operand(obj, &mut reads);
+            read_operand(value, &mut reads);
+        }
+        Statement::SetGlobal { value, .. } => read_operand(value, &mut reads),
+        Statement::Line(_) => {}
+    }
+    reads
+}
+fn terminator_reads(terminator: &Terminator) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match terminator {
+        Terminator::Branch { cond, .. } => read_operand(cond, &mut reads),
+        Terminator::Suspend { value, input, .. } => {
+            read_operand(value, &mut reads);
+            if let Some(input) = input {
+                reads.insert(*input);
+            }
+        }
+        Terminator::Return(value) => {
+            if let Some(value) = value {
+                read_operand(value, &mut reads);
+            }
+        }
+        Terminator::Raise { value, cause } => {
+            for operand in value.iter().chain(cause.iter()) {
+                read_operand(operand, &mut reads);
+            }
+        }
+        Terminator::Goto(_) | Terminator::Unreachable => {}
+    }
+    reads
+}
diff --git a/crates/ryupy-mir/src/passes/tuple_scalar_tests.rs b/crates/ryupy-mir/src/passes/tuple_scalar_tests.rs
new file mode 100644
index 0000000..3a13bfb
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/tuple_scalar_tests.rs
@@ -0,0 +1,400 @@
+//! tuple 标量替换的正反结构测试：冻结引用、定义支配、逃逸与失败时序。
+use super::{MirPass, TupleScalar};
+use crate::mir::*;
+use la_arena::{Arena, RawIdx};
+
+fn sample(index: i64) -> (Function, [LocalId; 6]) {
+    let mut locals = Arena::default();
+    let ids: Vec<_> = (0..6)
+        .map(|_| {
+            locals.alloc(LocalDecl {
+                ty: MirType::Dynamic,
+                name: None,
+                is_cell: false,
+            })
+        })
+        .collect();
+    let [left, right, tuple, key, result, length] = ids.try_into().unwrap();
+    locals[length].ty = MirType::I64;
+    let mut blocks = Arena::default();
+    let entry = blocks.alloc(BasicBlock {
+        stmts: vec![
+            Statement::Assign {
+                dest: tuple,
+                value: Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeTuple,
+                    prefix: vec![],
+                    args: vec![Operand::Local(left), Operand::Local(right)],
+                },
+            },
+            Statement::Assign {
+                dest: length,
+                value: Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::Len),
+                    args: vec![Operand::Local(tuple)],
+                },
+            },
+            check(length, 2),
+            Statement::Assign {
+                dest: key,
+                value: Rvalue::Box {
+                    value: Operand::Const(Constant::I64(index)),
+                    from: MirType::I64,
+                },
+            },
+            Statement::Assign {
+                dest: result,
+                value: Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::GetItem),
+                    args: vec![Operand::Local(tuple), Operand::Local(key)],
+                },
+            },
+        ],
+        terminator: Terminator::Return(Some(Operand::Local(result))),
+    });
+    (
+        Function {
+            name: "tuple_probe".into(),
+            codegen_name: "tuple_probe".into(),
+            source_file: "tuple_probe.py".into(),
+            params: vec![left, right],
+            ret: MirType::Dynamic,
+            body: Body {
+                locals,
+                blocks,
+                entry,
+                regions: vec![],
+            },
+            param_meta: vec![],
+            function_global: None,
+            specialization_identity_global: None,
+            defaults_global: None,
+            signature_global: Some(GlobalId::from_raw(RawIdx::from(0))),
+            env: None,
+        },
+        [left, right, tuple, key, result, length],
+    )
+}
+fn check(length: LocalId, required: i64) -> Statement {
+    Statement::Eval(Rvalue::Call {
+        callee: Callee::Runtime(RuntimeFn::UnpackCheck),
+        args: vec![
+            Operand::Local(length),
+            Operand::Const(Constant::I64(required)),
+            Operand::Const(Constant::Bool(false)),
+        ],
+    })
+}
+fn keeps_tuple(function: &Function) -> bool {
+    function.body.blocks.iter().any(|(_, b)| {
+        b.stmts.iter().any(|s| {
+            matches!(
+                s,
+                Statement::Assign {
+                    value: Rvalue::CallWithArgs {
+                        callee: RuntimeFn::MakeTuple,
+                        ..
+                    },
+                    ..
+                }
+            )
+        })
+    })
+}
+#[test]
+fn freezes_all_elements_before_rebinding_and_selects_negative_index() {
+    let (mut function, [left, right, _, _, result, _]) = sample(-1);
+    let block = function.body.entry;
+    function.body.blocks[block].stmts.insert(
+        1,
+        Statement::Assign {
+            dest: right,
+            value: Rvalue::Use(Operand::Local(left)),
+        },
+    );
+    TupleScalar.run(&mut function);
+    assert!(!keeps_tuple(&function));
+    let statements = &function.body.blocks[block].stmts;
+    let Statement::Assign {
+        dest: first,
+        value: Rvalue::Use(Operand::Local(source)),
+    } = &statements[0]
+    else {
+        panic!("缺少第一元素快照")
+    };
+    assert_eq!(*source, left);
+    let Statement::Assign {
+        dest: second,
+        value: Rvalue::Use(Operand::Local(source)),
+    } = &statements[1]
+    else {
+        panic!("缺少第二元素快照")
+    };
+    assert_eq!(*source, right);
+    assert_ne!(first, second);
+    assert!(![left, right].contains(first) && ![left, right].contains(second));
+    assert!(statements.iter().any(|s| matches!(s, Statement::Assign { dest, value: Rvalue::Use(Operand::Local(source)) } if *dest == result && source == second)));
+    assert!(!statements.iter().any(|s| matches!(
+        s,
+        Statement::Eval(Rvalue::Call {
+            callee: Callee::Runtime(RuntimeFn::UnpackCheck),
+            ..
+        })
+    )));
+}
+#[test]
+fn failed_unpack_check_stays_in_place_after_constant_length() {
+    let (mut function, [_, _, _, _, _, length]) = sample(0);
+    let block = function.body.entry;
+    function.body.blocks[block].stmts[2] = check(length, 3);
+    TupleScalar.run(&mut function);
+    assert!(!keeps_tuple(&function));
+    let statements = &function.body.blocks[block].stmts;
+    assert!(
+        matches!(&statements[2], Statement::Assign { dest, value: Rvalue::Use(Operand::Const(Constant::I64(2))) } if *dest == length)
+    );
+    assert!(matches!(
+        &statements[3],
+        Statement::Eval(Rvalue::Call {
+            callee: Callee::Runtime(RuntimeFn::UnpackCheck),
+            ..
+        })
+    ));
+}
+#[test]
+fn identity_alias_call_nested_array_and_return_escape_preserve_tuple() {
+    for case in 0..5 {
+        let (mut function, [left, _, tuple, _, result, _]) = sample(0);
+        let block = function.body.entry;
+        let observation = match case {
+            0 => Statement::Assign {
+                dest: left,
+                value: Rvalue::Use(Operand::Local(tuple)),
+            },
+            1 => Statement::Eval(Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::IsSame),
+                args: vec![Operand::Local(tuple), Operand::Local(tuple)],
+            }),
+            2 => Statement::Eval(Rvalue::CallWithArgs {
+                callee: RuntimeFn::MakeList,
+                prefix: vec![],
+                args: vec![Operand::Array(vec![Operand::Local(tuple)])],
+            }),
+            3 => Statement::Eval(Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::WriteObject),
+                args: vec![Operand::Local(left), Operand::Local(tuple)],
+            }),
+            _ => {
+                function.body.blocks[block].terminator =
+                    Terminator::Return(Some(Operand::Local(tuple)));
+                Statement::Assign {
+                    dest: result,
+                    value: Rvalue::Use(Operand::Local(left)),
+                }
+            }
+        };
+        function.body.blocks[block].stmts.push(observation);
+        TupleScalar.run(&mut function);
+        assert!(keeps_tuple(&function), "错误消除逃逸候选 {case}");
+    }
+}
+#[test]
+fn unknown_out_of_bounds_late_and_reassigned_indices_preserve_tuple() {
+    for case in 0..5 {
+        let (mut function, [left, _, _, key, _, _]) = sample(if case == 0 { 9 } else { 0 });
+        let block = function.body.entry;
+        match case {
+            1 => function.body.blocks[block].stmts.swap(3, 4),
+            2 => function.body.blocks[block].stmts.push(Statement::Assign {
+                dest: key,
+                value: Rvalue::Use(Operand::Local(left)),
+            }),
+            3 => {
+                function.body.blocks[block].stmts[3] = Statement::Assign {
+                    dest: key,
+                    value: Rvalue::Use(Operand::Local(left)),
+                }
+            }
+            4 => {
+                let definition = function.body.blocks[block].stmts.remove(3);
+                function.body.blocks.alloc(BasicBlock {
+                    stmts: vec![definition],
+                    terminator: Terminator::Return(None),
+                });
+            }
+            _ => {}
+        }
+        TupleScalar.run(&mut function);
+        assert!(keeps_tuple(&function), "错误接受下标事实 {case}");
+    }
+}
+#[test]
+fn cells_generators_closures_and_exception_regions_are_outside_first_slice() {
+    for case in 0..5 {
+        let (mut function, [left, _, tuple, _, _, _]) = sample(0);
+        let entry = function.body.entry;
+        match case {
+            0 => function.body.locals[left].is_cell = true,
+            1 => function.signature_global = None,
+            2 => function.env = Some(left),
+            3 => {
+                function.body.blocks[entry].terminator = Terminator::Suspend {
+                    value: Operand::Local(tuple),
+                    resume: entry,
+                    input: None,
+                    delegated: false,
+                }
+            }
+            _ => function.body.regions.push(Region {
+                kind: RegionKind::CatchAll,
+                try_start: entry,
+                try_len: 1,
+                handler: entry,
+                exc_local: None,
+            }),
+        }
+        TupleScalar.run(&mut function);
+        assert!(keeps_tuple(&function));
+    }
+}
+#[test]
+fn oversized_tuple_and_cross_block_read_are_not_rewritten() {
+    for case in 0..2 {
+        let (mut function, [left, _, _, _, _, _]) = sample(0);
+        let entry = function.body.entry;
+        if case == 0 {
+            if let Statement::Assign {
+                value: Rvalue::CallWithArgs { args, .. },
+                ..
+            } = &mut function.body.blocks[entry].stmts[0]
+            {
+                *args = vec![Operand::Local(left); 9];
+            }
+        } else {
+            let read = function.body.blocks[entry].stmts.pop().unwrap();
+            let next = function.body.blocks.alloc(BasicBlock {
+                stmts: vec![read],
+                terminator: Terminator::Return(None),
+            });
+            function.body.blocks[entry].terminator = Terminator::Goto(next);
+        }
+        TupleScalar.run(&mut function);
+        assert!(keeps_tuple(&function));
+    }
+}
+
+#[test]
+fn attempt_budget_counts_failed_candidates_and_never_revisits_them() {
+    for mixed in [false, true] {
+        let (mut function, [left, right, ..]) = sample(0);
+        let entry = function.body.entry;
+        function.body.blocks[entry].stmts.clear();
+        function.body.blocks[entry].terminator = Terminator::Return(None);
+        let mut last_tuple = None;
+        for index in 0..33 {
+            let mut alloc = || {
+                function.body.locals.alloc(LocalDecl {
+                    ty: MirType::Dynamic,
+                    name: None,
+                    is_cell: false,
+                })
+            };
+            let tuple = alloc();
+            let key = alloc();
+            let result = alloc();
+            let statements = &mut function.body.blocks[entry].stmts;
+            statements.push(Statement::Assign {
+                dest: tuple,
+                value: Rvalue::CallWithArgs {
+                    callee: RuntimeFn::MakeTuple,
+                    prefix: vec![],
+                    args: vec![Operand::Local(left), Operand::Local(right)],
+                },
+            });
+            statements.push(Statement::Assign {
+                dest: key,
+                value: Rvalue::Box {
+                    value: Operand::Const(Constant::I64(0)),
+                    from: MirType::I64,
+                },
+            });
+            statements.push(Statement::Assign {
+                dest: result,
+                value: Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::GetItem),
+                    args: vec![Operand::Local(tuple), Operand::Local(key)],
+                },
+            });
+            // 第 33 个始终合法，但预算已用尽；前 32 个或全部失败，或交替成功。
+            if index < 32 && (!mixed || index % 2 == 0) {
+                statements.push(Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::IsSame),
+                    args: vec![Operand::Local(tuple), Operand::Local(tuple)],
+                }));
+            }
+            last_tuple = Some(tuple);
+        }
+        TupleScalar.run(&mut function);
+        let remaining: Vec<_> = function.body.blocks[entry]
+            .stmts
+            .iter()
+            .filter_map(|stmt| match stmt {
+                Statement::Assign {
+                    dest,
+                    value:
+                        Rvalue::CallWithArgs {
+                            callee: RuntimeFn::MakeTuple,
+                            ..
+                        },
+                } => Some(*dest),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(remaining.len(), if mixed { 17 } else { 33 });
+        assert!(
+            remaining.contains(&last_tuple.unwrap()),
+            "不能越过总尝试预算"
+        );
+    }
+}
+
+#[test]
+fn repeated_lengths_only_remove_checks_after_their_own_unique_definition() {
+    let (mut function, [_, _, tuple, _, _, _]) = sample(0);
+    let entry = function.body.entry;
+    let repeated = function.body.locals.alloc(LocalDecl {
+        ty: MirType::I64,
+        name: None,
+        is_cell: false,
+    });
+    // 参数模拟已存在但未知的长度；前置 check 绝不能用后面的 Len 事实删除。
+    function.params.push(repeated);
+    function.body.blocks[entry].stmts.extend([
+        check(repeated, 2),
+        Statement::Assign {
+            dest: repeated,
+            value: Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::Len),
+                args: vec![Operand::Local(tuple)],
+            },
+        },
+        check(repeated, 2),
+        check(repeated, 3),
+    ]);
+    TupleScalar.run(&mut function);
+    assert!(!keeps_tuple(&function));
+    let checks = function.body.blocks[entry]
+        .stmts
+        .iter()
+        .filter(|stmt| {
+            matches!(
+                stmt,
+                Statement::Eval(Rvalue::Call {
+                    callee: Callee::Runtime(RuntimeFn::UnpackCheck),
+                    ..
+                })
+            )
+        })
+        .count();
+    assert_eq!(checks, 2, "保留前置未知检查和后置失败检查");
+}
