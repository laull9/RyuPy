@@ -0,0 +1,41 @@
+//! 受守卫的循环累加器实验：只匹配无异常区、无逃逸的三块自然循环，不猜测Python类型。
+//!
+//! 运行时holder保存原initial身份，只在精确long加法安全时延迟装箱；其它类型/溢出完整回退。
+//! 本pass不改变CFG，仅把preheader末尾、body唯一+=和唯一exit入口接到普通RuntimeFn ABI。
+use super::numeric_accumulator_match::Plan;
+use crate::mir::*;
+
+pub(super) fn expand(function: &mut Function, plan: Plan) {
+    let holder = function.body.locals.alloc(LocalDecl {
+        ty: MirType::Dynamic,
+        name: None,
+        is_cell: false,
+    });
+    function.body.blocks[plan.preheader]
+        .stmts
+        .push(Statement::Assign {
+            dest: holder,
+            value: Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::NumericAccumulatorCreate),
+                args: vec![Operand::Local(plan.total)],
+            },
+        });
+    let statements = &mut function.body.blocks[plan.body].stmts;
+    statements.splice(
+        plan.update..plan.update + 2,
+        [Statement::Eval(Rvalue::Call {
+            callee: Callee::Runtime(RuntimeFn::NumericAccumulatorAdd),
+            args: vec![Operand::Local(holder), plan.rhs],
+        })],
+    );
+    function.body.blocks[plan.exit].stmts.insert(
+        0,
+        Statement::Assign {
+            dest: plan.total,
+            value: Rvalue::Call {
+                callee: Callee::Runtime(RuntimeFn::NumericAccumulatorValue),
+                args: vec![Operand::Local(holder)],
+            },
+        },
+    );
+}
diff --git a/crates/ryupy-mir/src/passes/numeric_accumulator_match.rs b/crates/ryupy-mir/src/passes/numeric_accumulator_match.rs
new file mode 100644
index 0000000..a362377
--- /dev/null
+++ b/crates/ryupy-mir/src/passes/numeric_accumulator_match.rs
@@ -0,0 +1,200 @@
+//! 累加器严格候选识别：不因表示从holder变为局部而放宽身份/异常/逃逸条件。
+use super::dead_values::{read_operand, read_value};
+use crate::mir::*;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+pub(super) struct Plan {
+    pub(super) preheader: BlockId,
+    pub(super) body: BlockId,
+    pub(super) exit: BlockId,
+    pub(super) update: usize,
+    pub(super) total: LocalId,
+    pub(super) rhs: Operand,
+}
+
+pub(super) fn candidate(
+    function: &Function,
+    header: BlockId,
+    predecessors: &FxHashMap<BlockId, Vec<BlockId>>,
+) -> Option<Plan> {
+    let Terminator::Branch {
+        then_: body,
+        else_: exit,
+        ..
+    } = &function.body.blocks[header].terminator
+    else {
+        return None;
+    };
+    let (body, exit) = (*body, *exit);
+    let Terminator::Goto(latch) = function.body.blocks[body].terminator else {
+        return None;
+    };
+    if !matches!(function.body.blocks[latch].terminator, Terminator::Goto(target) if target == header)
+    {
+        return None;
+    }
+    let incoming = predecessors.get(&header)?;
+    if incoming.len() != 2 || !incoming.contains(&latch) {
+        return None;
+    }
+    let preheader = *incoming.iter().find(|&&block| block != latch)?;
+    if preheader != function.body.entry
+        || !predecessors.get(&preheader)?.is_empty()
+        || !matches!(function.body.blocks[preheader].terminator, Terminator::Goto(target) if target == header)
+    {
+        return None;
+    }
+    if [preheader, header, body, latch, exit]
+        .into_iter()
+        .collect::<FxHashSet<_>>()
+        .len()
+        != 5
+        || function.body.entry == header
+        || function.body.entry == body
+        || function.body.entry == latch
+        || function.body.entry == exit
+        || predecessors.get(&body)?.as_slice() != [header]
+        || predecessors.get(&latch)?.as_slice() != [body]
+        || predecessors.get(&exit)?.as_slice() != [header]
+    {
+        return None;
+    }
+    let statements = &function.body.blocks[body].stmts;
+    for (update, pair) in statements.windows(2).enumerate() {
+        let Statement::Assign {
+            dest: temporary,
+            value:
+                Rvalue::DynBinary {
+                    op: DynOp::Add,
+                    lhs: Operand::Local(total),
+                    rhs,
+                    inplace: true,
+                },
+        } = &pair[0]
+        else {
+            continue;
+        };
+        if !matches!(&pair[1], Statement::Assign { dest, value: Rvalue::Use(Operand::Local(source)) }
+            if dest == total && source == temporary)
+        {
+            continue;
+        }
+        let local = &function.body.locals[*total];
+        if local.is_cell
+            || local.name.is_none()
+            || local.ty != MirType::Dynamic
+            || statements[update + 2..]
+                .iter()
+                .any(|statement| !matches!(statement, Statement::Line(_)))
+        {
+            continue;
+        }
+        // 入口必须已经直接赋值；不提前执行可能未绑定的读，也不处理LoadChecked(total)模式。
+        if !function.body.blocks[preheader]
+            .stmts
+            .iter()
+            .any(|statement| matches!(statement, Statement::Assign { dest, .. } if dest == total))
+        {
+            continue;
+        }
+        let mut rhs_reads = FxHashSet::default();
+        read_operand(rhs, &mut rhs_reads);
+        if rhs_reads.contains(total) {
+            continue;
+        }
+        let loop_blocks = [header, body, latch];
+        let (mut total_reads, mut total_writes, mut temporary_reads, mut temporary_writes) =
+            (0, 0, 0, 0);
+        for (id, block) in function.body.blocks.iter() {
+            for statement in &block.stmts {
+                let reads = statement_reads(statement);
+                temporary_reads += usize::from(reads.contains(temporary));
+                if let Statement::Assign { dest, .. } = statement {
+                    temporary_writes += usize::from(dest == temporary);
+                    if loop_blocks.contains(&id) {
+                        total_writes += usize::from(dest == total);
+                    }
+                }
+                if loop_blocks.contains(&id) {
+                    total_reads += usize::from(reads.contains(total));
+                }
+            }
+            let reads = terminator_reads(&block.terminator);
+            temporary_reads += usize::from(reads.contains(temporary));
+            if loop_blocks.contains(&id) {
+                total_reads += usize::from(reads.contains(total));
+            }
+        }
+        if total_reads == 1 && total_writes == 1 && temporary_reads == 1 && temporary_writes == 1 {
+            return Some(Plan {
+                preheader,
+                body,
+                exit,
+                update,
+                total: *total,
+                rhs: rhs.clone(),
+            });
+        }
+    }
+    None
+}
+
+pub(super) fn predecessors(function: &Function) -> FxHashMap<BlockId, Vec<BlockId>> {
+    let mut result: FxHashMap<_, Vec<_>> = function
+        .body
+        .blocks
+        .iter()
+        .map(|(id, _)| (id, vec![]))
+        .collect();
+    for (id, block) in function.body.blocks.iter() {
+        let destinations = match &block.terminator {
+            Terminator::Goto(target) | Terminator::Suspend { resume: target, .. } => vec![*target],
+            Terminator::Branch { then_, else_, .. } => vec![*then_, *else_],
+            Terminator::Return(_) | Terminator::Raise { .. } | Terminator::Unreachable => vec![],
+        };
+        for target in destinations {
+            if let Some(incoming) = result.get_mut(&target) {
+                incoming.push(id);
+            }
+        }
+    }
+    result
+}
+
+fn statement_reads(statement: &Statement) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match statement {
+        Statement::Assign { value, .. } | Statement::Eval(value) => read_value(value, &mut reads),
+        Statement::SetField { obj, value, .. } => {
+            read_operand(obj, &mut reads);
+            read_operand(value, &mut reads);
+        }
+        Statement::SetGlobal { value, .. } => read_operand(value, &mut reads),
+        Statement::Line(_) => {}
+    }
+    reads
+}
+fn terminator_reads(terminator: &Terminator) -> FxHashSet<LocalId> {
+    let mut reads = FxHashSet::default();
+    match terminator {
+        Terminator::Branch { cond, .. } => read_operand(cond, &mut reads),
+        Terminator::Suspend { value, input, .. } => {
+            read_operand(value, &mut reads);
+            if let Some(input) = input {
+                reads.insert(*input);
+            }
+        }
+        Terminator::Return(value) => {
+            if let Some(value) = value {
+                read_operand(value, &mut reads);
+            }
+        }
+        Terminator::Raise { value, cause } => {
+            for operand in value.iter().chain(cause.iter()) {
+                read_operand(operand, &mut reads);
+            }
+        }
+        Terminator::Goto(_) | Terminator::Unreachable => {}
+    }
+    reads
+}
diff --git a/crates/ryupy-mir/src/validate_runtime_calls.rs b/crates/ryupy-mir/src/validate_runtime_calls.rs
new file mode 100644
index 0000000..887714f
--- /dev/null
+++ b/crates/ryupy-mir/src/validate_runtime_calls.rs
@@ -0,0 +1,111 @@
+//! RuntimeFn的显式CLR签名验证；操作码是内部编译期常量，不是Python值转换。
+use crate::mir::*;
+use crate::validate::operand_type;
+
+pub(super) fn validate_call(
+    program: &Program,
+    func: &Function,
+    callee: &Callee,
+    args: &[Operand],
+    errors: &mut Vec<String>,
+) {
+    // 输出与累加器专用ABI校验，防止参数错配生成栈不平衡的CIL。
+    if let Callee::Runtime(runtime) = callee {
+        if *runtime == RuntimeFn::DynBinary && !valid_binary_opcode(args.first()) {
+            errors.push(format!(
+                "函数 `{}` 的通用二元操作码必须为合法编译期i64常量",
+                func.name
+            ));
+        }
+        let expected: Option<&[MirType]> = match runtime {
+            RuntimeFn::DynBinary => Some(&[MirType::I64, MirType::Dynamic, MirType::Dynamic]),
+            RuntimeFn::PrintTarget => Some(&[]),
+            RuntimeFn::CheckGlobalBound => Some(&[MirType::Bool, MirType::Str]),
+            RuntimeFn::ClassNamespaceContains => Some(&[MirType::Dynamic, MirType::Str]),
+            RuntimeFn::NumericAccumulatorCreate
+            | RuntimeFn::NumericAccumulatorValue
+            | RuntimeFn::TypedDictFinish
+            | RuntimeFn::ValidateOrdinaryBase => Some(&[MirType::Dynamic]),
+            RuntimeFn::TypedDictBegin => {
+                Some(&[MirType::Str, MirType::Dynamic, MirType::Bool, MirType::Str])
+            }
+            RuntimeFn::NumericAccumulatorAdd => Some(&[MirType::Dynamic, MirType::Dynamic]),
+            RuntimeFn::WriteI64 => Some(&[MirType::Dynamic, MirType::I64]),
+            RuntimeFn::WriteF64 => Some(&[MirType::Dynamic, MirType::F64]),
+            RuntimeFn::WriteBool => Some(&[MirType::Dynamic, MirType::Bool]),
+            RuntimeFn::WriteStr => Some(&[MirType::Dynamic, MirType::Str]),
+            RuntimeFn::WriteObject => Some(&[MirType::Dynamic, MirType::Dynamic]),
+            RuntimeFn::WriteSep | RuntimeFn::WriteNewline => Some(&[MirType::Dynamic]),
+            _ => None,
+        };
+        if let Some(expected) = expected
+            && (args.len() != expected.len()
+                || args.iter().zip(expected).any(|(arg, ty)| {
+                    operand_type(program, func, arg).is_some_and(|actual| &actual != ty)
+                }))
+        {
+            errors.push(format!(
+                "函数 {} 的 {:?} 参数不符合{}",
+                func.name,
+                runtime,
+                if matches!(
+                    runtime,
+                    RuntimeFn::NumericAccumulatorCreate
+                        | RuntimeFn::NumericAccumulatorAdd
+                        | RuntimeFn::NumericAccumulatorValue
+                ) {
+                    "累加器ABI"
+                } else if matches!(
+                    runtime,
+                    RuntimeFn::TypedDictBegin | RuntimeFn::TypedDictFinish
+                ) {
+                    "TypedDict构建ABI"
+                } else if matches!(runtime, RuntimeFn::DynBinary) {
+                    "通用二元运算ABI"
+                } else if matches!(runtime, RuntimeFn::CheckGlobalBound) {
+                    "模块绑定位ABI"
+                } else if matches!(runtime, RuntimeFn::ClassNamespaceContains) {
+                    "类命名空间存在性ABI"
+                } else if matches!(runtime, RuntimeFn::ValidateOrdinaryBase) {
+                    "普通基类守卫ABI"
+                } else {
+                    "输出目标ABI"
+                }
+            ));
+        }
+    }
+}
+
+/// 只接受十二个既有二元操作及可选inplace位；不是任意截断后的i32。
+fn valid_binary_opcode(value: Option<&Operand>) -> bool {
+    let Some(Operand::Const(Constant::I64(code))) = value else {
+        return false;
+    };
+    i32::try_from(*code).is_ok_and(|code| (1..=12).contains(&(code & !DynOp::INPLACE_FLAG)))
+}
+
+pub(super) fn validate_destination(
+    func: &Function,
+    dest: LocalId,
+    value: &Rvalue,
+    errors: &mut Vec<String>,
+) {
+    if matches!(
+        value,
+        Rvalue::Call {
+            callee: Callee::Runtime(RuntimeFn::DynBinary),
+            ..
+        }
+    ) && func
+        .body
+        .locals
+        .iter()
+        .find(|(id, _)| *id == dest)
+        .is_some_and(|(_, local)| local.ty != MirType::Dynamic)
+    {
+        errors.push(format!(
+            "函数 `{}` 的通用二元运算必须保存动态结果",
+            func.name
+        ));
+    }
+}
