from typing import Callable, TypeVar
T = TypeVar("T")
class Gauge:
    def __init__(self, bias: int = 2, /, *, label: str = "seed") -> None: ...
    def sample(self, value: int, callback: Callable[[int], T], /) -> T: ...
    def echo(self, value: T, callback: Callable[[T], T], /) -> T: ...
    def label(self) -> str: ...
