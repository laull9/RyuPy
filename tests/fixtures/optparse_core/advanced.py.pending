# ryupy: pending
# 完整高级正期望独立保留，不计首阶段六项通过数。
import optparse

events = []
def callback(option, opt, value, parser, prefix):
    events.append((opt, value, prefix, parser.values is not None))
    parser.values.seen = prefix + value

class Formatter(optparse.IndentedHelpFormatter):
    def format_usage(self, usage):
        return 'CUSTOM ' + usage + '\n'

class Parser(optparse.OptionParser):
    def get_prog_name(self):
        return 'custom-program'

p = Parser(formatter=Formatter(), add_help_option=False)
group = optparse.OptionGroup(p, 'Extra')
group.add_option('--hook', action='callback', type='string', callback=callback, callback_args=('prefix-',))
p.add_option_group(group)
v, rest = p.parse_args(['--hook', 'value', 'tail'])
print(events, v.seen, rest)
print(p.get_usage(), end='')
