/target
# `make build` 生成的发行包（二进制不进版本库，压缩包名与平台相关）
/releases
# .NET 构建产物（Rust 的 src/bin/ 是源码目录，不能一并忽略）
runtime/**/bin/
runtime/**/obj/
**/obj/
*.pending-snap
*.snap.new
.DS_Store

# Python 基线脚本生成的字节码缓存
__pycache__/
*.pyc
.idea/
.vscode/

# 抓取的项目源码（tests/fetch_projects.py 生成，锁定信息在 tests/projects/lock.tsv）
/third_party/projects/
