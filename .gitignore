/target
# `make build` 生成的发行包（二进制不进版本库，压缩包名与平台相关）
/releases
# .NET 构建产物（Rust 的 src/bin/ 是源码目录，不能一并忽略）
runtime/**/bin/
runtime/**/obj/
**/obj/
*.pending-snap
*.snap.new
.DS_Store

# Python 基线脚本生成的字节码缓存
__pycache__/
*.pyc
.idea/
.vscode/

# 抓取的项目源码（tests/fetch_projects.py 生成，锁定信息在 tests/projects/lock.tsv）
/third_party/projects/

# AOT运行记录保留于Git历史/CI；新运行输出写入target，不混入摘要目录。
/docs/validation/aot-driver-ci/logs/
/docs/validation/aot-smoke-ci/logs/
/docs/validation/aot-driver-local/full-check.log
/docs/validation/aot-driver-local/e2e.jsonl
/docs/validation/aot-reference-identity/*.log
/docs/validation/aot-reference-identity/e2e.jsonl

# 高层 NativeAOT 生成目录及独占构建锁（不忽略源码/清单文件本身）。
*.build/
*.dist/
*.build.lock/

# 性能实验可再生的编译 IR / JIT 转储不进版本库；测试输入和已审阅 insta 期望仍保留。
/tests/perf/results/**/*.mir
/tests/perf/results/**/*.cil
/tests/perf/results/**/*.types
/tests/perf/results/**/*.asm
/tests/perf/results/**/*.asm.diff
/tests/perf/results/m3_10/union-prototype/jit-arithmetic.txt
/tests/perf/results/m3_10/union-prototype/jit-calls.txt

# 生成器MIR改由类型化状态/None合同与负控覆盖，不再保存生成IR黄金。
/crates/ryupy-driver/tests/snapshots/m3_1__m3_1_genexpr_mir.snap
/crates/ryupy-driver/tests/snapshots/m3_2__m3_2_basic_mir.snap
